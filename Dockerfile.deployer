# Trusted management container, not part of the application runtime.
FROM node:24.15.0-alpine@sha256:d1b3b4da11eefd5941e7f0b9cf17783fc99d9c6fc34884a665f40a06dbdfc94f
RUN apk add --no-cache git=2.52.0-r0 docker-cli=29.5.2-r0 docker-cli-compose=2.40.3-r6 docker-cli-buildx=0.30.1-r6 util-linux=2.41.6-r1
WORKDIR /controller
COPY scripts/deploy.mjs ./deploy.mjs
ENV NODE_ENV=production GIT_TERMINAL_PROMPT=0 DOCKER_CONFIG=/state/docker
# Root is required for the Docker management socket. No host directories/ports are exposed.
USER 0:0
CMD ["node", "deploy.mjs"]
