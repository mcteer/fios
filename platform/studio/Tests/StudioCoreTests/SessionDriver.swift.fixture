import Foundation
import Darwin
import CryptoKit

@MainActor @main struct SessionDriverFixture {
    static func main() throws {
        let args=CommandLine.arguments
        guard args.count>=4,args[2].hasPrefix("/tmp/fios009-session-driver-"),geteuid()>0 else {throw ControlError.invalid_request}
        alarm(45)
        var bytes=[CChar](repeating:0,count:4096)
        guard proc_pidpath(getpid(),&bytes,UInt32(bytes.count))>0 else {throw RuntimeError.identity}
        let path=String(decoding:bytes.prefix(while:{$0 != 0}).map {UInt8(bitPattern:$0)},as:UTF8.self)
        let hash=SHA256.hash(data:try Data(contentsOf:URL(fileURLWithPath:path))).map {String(format:"%02x",$0)}.joined()
        let image=try VerifiedExecutable(path:path,sha256:hash),directory=URL(fileURLWithPath:args[2])
        let applications:[ManagedService:VerifiedExecutable]=[.mlx:image,.orbstack:image]
        if args[1]=="server" {
            let scenario=args[3]
            guard ["functional","success","validation","console","running","error","wrong-process","shutdown","clock","expired"].contains(scenario) else {throw ControlError.invalid_request}
            if !FileManager.default.fileExists(atPath:directory.appendingPathComponent("calls").path) {
                try AtomicState.write(Data("0".utf8),to:directory.appendingPathComponent("calls"))
            }
            let ports=SessionDriverPorts(validate:{command in
                try AtomicState.write(Data("entered".utf8),to:directory.appendingPathComponent("validation-entered"))
                while !FileManager.default.fileExists(atPath:directory.appendingPathComponent("release-validation").path) {
                    guard ProcessInfo.processInfo.systemUptime<command.deadline+2 else {throw RuntimeError.deadline}
                    Thread.sleep(forTimeInterval:0.005)
                }
                if scenario=="validation" {throw ControlError.unauthorized}
            },consoleReady:{
                try! AtomicState.write(Data("observed".utf8),to:directory.appendingPathComponent("validation-observed"))
                return scenario != "console"
            },alreadyRunning:{_ in scenario=="running"},open:{_,completion in
                // Counter-only fake application API. No NSWorkspace/native
                // lifecycle, root policy, runtime, model or keychain operation.
                let count=Int(String(decoding:try! Data(contentsOf:directory.appendingPathComponent("calls")),as:UTF8.self))!
                try! AtomicState.write(Data(String(count+1).utf8),to:directory.appendingPathComponent("calls"))
                Task { @MainActor in
                    try? await Task.sleep(nanoseconds:10_000_000)
                    if scenario=="error" {completion(nil,false)}
                    else if scenario=="wrong-process" {completion(getppid(),true)}
                    else if scenario=="functional" {completion(getpid(),true)}
                    else {completion(getpid(),true);completion(nil,false)} // Duplicate completion must be inert.
                }
            })
            let driver=try EnrolledSessionDriver(directory:directory,manager:image,applications:applications,ports:ports)
            let stop=Termination()
            while !stop.requested {
                if FileManager.default.fileExists(atPath:directory.appendingPathComponent("shutdown").path) {
                    driver.shutdown()
                    try AtomicState.write(Data("stopped".utf8),to:directory.appendingPathComponent("shutdown-observed"))
                }
                try driver.poll(consoleReady:true,now:HostResources.nowMilliseconds()+(scenario=="clock" ? 1000:0))
                RunLoop.current.run(until:Date(timeIntervalSinceNow:0.005))
            }
            driver.shutdown();return
        }
        let pins:[ManagedService:String]=[.mlx:hash,.orbstack:hash]
        let metadata=try SessionEndpointDescriptor(Data(contentsOf:directory.appendingPathComponent("session-control.json")),
            expectedBoot:HostBoot.identity(),expectedProfile:ServiceLaunchProfile.digest(pins),expectedUID:geteuid())
        let peer=NativeControlPeer(pid:metadata.pid,start:metadata.start,executable:image)
        guard let client=try SessionControlClient.discover(directory:directory,helper:image,approvedHashes:pins) else {throw ControlError.unauthorized}
        if args[1]=="manager" {
            guard args.count==4,["known","unknown"].contains(args[3]) else {throw ControlError.invalid_request}
            // Trusted synthetic observations only. The real manager loop and
            // journal execute, but no native observation source is enrolled.
            let cache=ServiceObservationCache(),known=args[3]=="known"
            let helperPID=peer.pid,helperStart=peer.start
            let source:@Sendable()->Void={
                let count=(try? String(contentsOf:directory.appendingPathComponent("calls"),encoding:.utf8)).flatMap(Int.init) ?? 0
                let identity=ServiceIdentity(pid:helperPID,start:helperStart,sha256:hash)
                let now=HostResources.nowMilliseconds()
                cache.publish(known ? ServiceObservation(identity:count==0 ? nil:identity,responding:count>0,sessionReady:true,credentialsReady:true,nativeIdle:nil,runtimeUnmanaged:nil,sampledAt:now):nil,for:.mlx)
                cache.publish(ServiceObservation(identity:identity,responding:true,sessionReady:true,credentialsReady:true,nativeIdle:nil,runtimeUnmanaged:nil,sampledAt:now),for:.orbstack)
            }
            source()
            Thread.detachNewThread {while true {source();Thread.sleep(forTimeInterval:0.1)}}
            try ManagerRuntime.run(directory:directory,nativeControl:nil,serviceObservations:cache,serviceControl:client)
            return
        }
        if args[1]=="recover" {
            guard args.count==4,["dispatch","lookup"].contains(args[3]) else {throw ControlError.invalid_request}
            let journal=try Journal(directory:directory)
            if args[3]=="dispatch" {
                let job=UUID().uuidString.lowercased()
                try journal.claim(job:job,attempt:0,model:"fixture/independent")
                try journal.markUncertain(job:job,attempt:0)
            }
            let recovery=try ServiceRecoveryController(journal:journal,approvedHashes:[.mlx:hash,.orbstack:hash])
            let initial=args[3]=="dispatch",now:Int64=initial ? 1000:2000
            let absent=ServiceObservation(identity:nil,responding:false,sessionReady:true,credentialsReady:true,nativeIdle:nil,runtimeUnmanaged:nil,sampledAt:now)
            guard let request=try recovery.next(service:.mlx,desired:initial ? .running:.stopped,observation:initial ? absent:nil,now:now,tick:now) else {
                guard try journal.uncertainCount()==1 else {throw JournalError.invalid};print("none");return
            }
            let queue=AsyncSessionControl(client:client);try queue.submit(request)
            let end=ProcessInfo.processInfo.systemUptime+3
            while ProcessInfo.processInfo.systemUptime<end {
                if let result=queue.poll() {
                    switch result.value {
                    case .success(let value):
                        try recovery.receive(result.request,result:value)
                        guard try journal.uncertainCount()==1 else {throw JournalError.invalid}
                        print(request.operation.rawValue+"/"+status(value));return
                    case .failure:throw RuntimeError.invalid
                    }
                }
                Thread.sleep(forTimeInterval:0.005)
            }
            throw RuntimeError.deadline
        }
        guard args[1]=="client",args.count==6,let service=ManagedService(rawValue:args[3]),let operation=SessionClientOperation(rawValue:args[4]) else {throw ControlError.invalid_request}
        print(status(try client.request(operation:operation,service:service,id:args[5])))
    }
    static func status(_ result:SessionLaunchResult)->String {
        switch result {
        case .started:return "started"
        case .notSent:return "not_sent"
        case .uncertain:return "uncertain"
        case .busy:return "busy"
        case .wrongInstance:return "wrong_instance"
        }
    }
}
