import Foundation
import Darwin

// Measurement-only companion. No native services, runtime or task activation.
final class ObservationCompanion {
    private let directory=URL(fileURLWithPath:"/tmp/fios-vm-observer-"+UUID().uuidString.lowercased())
    private let process=Process()
    private var manager:(pid:Int32,start:UInt64)?
    private var supervisorStart:UInt64?
    private var started=false
    private var stopped=false
    private func usage(_ pid:Int32)throws->rusage_info_v2 {
        var value=rusage_info_v2()
        let result=withUnsafeMutablePointer(to:&value) {$0.withMemoryRebound(to:rusage_info_t?.self,capacity:1) {proc_pid_rusage(pid,RUSAGE_INFO_V2,$0)}}
        guard result==0 else {throw RuntimeError.identity};return value
    }
    func start(supervisor:String)throws {
        guard !started,supervisor.hasPrefix("/"),URL(fileURLWithPath:supervisor).lastPathComponent=="studio-supervisor" else {throw RuntimeError.identity}
        started=true
        do {
            let journal=try Journal(directory:directory),now=HostResources.nowMilliseconds()
            for index in 0..<256 {
                try autoreleasepool {
                let job=try DurableJob(id:UUID().uuidString.lowercased(),idempotency:UUID().uuidString.lowercased(),ownerHash:String(repeating:"a",count:64),requestHash:String(repeating:"b",count:64),created:now)
                if index%2==0 {
                    let config=try SandboxConfiguration(job:job.id,nonce:String(repeating:"c",count:64),image:"sha256:"+String(repeating:"d",count:64),memory:512<<20,cpus:1)
                    _=try journal.reserveSandbox(job:job,configuration:config);try journal.confirmSandboxAbsent(job:job.id)
                }else {_=try journal.reserveJob(job)}
                try journal.transitionJob(id:job.id,to:.revoking,now:now);try journal.transitionJob(id:job.id,to:.removed,now:now)
                }
            }
        }
        process.executableURL=URL(fileURLWithPath:supervisor);process.arguments=["--state",directory.path]
        process.environment=["PATH":"/usr/bin:/bin","LANG":"C","LC_ALL":"C"]
        process.standardInput=FileHandle.nullDevice;process.standardOutput=FileHandle.nullDevice;process.standardError=FileHandle.nullDevice
        try process.run();supervisorStart=try usage(process.processIdentifier).ri_proc_start_abstime
        let warm=ProcessInfo.processInfo.systemUptime+5
        while ProcessInfo.processInfo.systemUptime<warm {guard process.isRunning else {throw RuntimeError.launch};Thread.sleep(forTimeInterval:0.1)}
        let pid=try progressPID()
        manager=(pid,try usage(pid).ri_proc_start_abstime)
        _=try sample()
    }
    private func progressPID()throws->Int32 {
        let bytes=try Data(contentsOf:directory.appendingPathComponent("progress.json"))
        guard bytes.count<=4096,let value=try JSONSerialization.jsonObject(with:bytes) as? [String:Any],
              let pid=(value["pid"] as? NSNumber)?.int32Value,pid>1,
              let progress=value["progress"] as? Double,progress.isFinite,progress>=0,
              (0...6).contains(ProcessInfo.processInfo.systemUptime-progress) else {throw RuntimeError.identity}
        return pid
    }
    func sample()throws->(cpu:UInt64,rss:UInt64) {
        guard !stopped,process.isRunning,let manager,let supervisorStart,try progressPID()==manager.pid else {throw RuntimeError.identity}
        let first=try usage(manager.pid),second=try usage(process.processIdentifier)
        guard first.ri_proc_start_abstime==manager.start,second.ri_proc_start_abstime==supervisorStart else {throw RuntimeError.identity}
        // No child CPU here: manager is itself the supervisor's live child.
        return (first.ri_user_time+first.ri_system_time+second.ri_user_time+second.ri_system_time,
                first.ri_resident_size+second.ri_resident_size)
    }
    func stop() {
        if stopped {return};stopped=true
        if process.isRunning {
            process.terminate();let end=ProcessInfo.processInfo.systemUptime+2
            while process.isRunning && ProcessInfo.processInfo.systemUptime<end {Thread.sleep(forTimeInterval:0.01)}
            if process.isRunning {kill(process.processIdentifier,SIGKILL)}
            if !process.isRunning {process.waitUntilExit()}
        }
        if let manager,let value=try? usage(manager.pid),value.ri_proc_start_abstime==manager.start {kill(manager.pid,SIGKILL)}
        if let fence=try? StoppedPlatformState(directory:directory) {
            withExtendedLifetime(fence) {try? FileManager.default.removeItem(at:directory)}
        }else if FileManager.default.fileExists(atPath:directory.path){print("RETAINED: observation companion state without both stopped writer locks: \(directory.path)")}
    }
    deinit {stop()}
}
