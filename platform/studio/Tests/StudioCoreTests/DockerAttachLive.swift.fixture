            print("METRIC: \(label) wall_ms=\(Int((ProcessInfo.processInfo.systemUptime-sourceStarted)*1000)) self_plus_reaped_child_cpu_ms=\(Int(sourceMilliseconds)) equivalent_fixed2s_core_percent=\(String(format:"%.2f",sourceMilliseconds/(Double(count)*20))); isolated source only, not whole-agent idle acceptance")
