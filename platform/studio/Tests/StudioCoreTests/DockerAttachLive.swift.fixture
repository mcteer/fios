import Foundation
import Darwin
import CryptoKit

private func inventoryCPU()throws->UInt64 {
    var usage=rusage_info_v2()
    let code=withUnsafeMutablePointer(to:&usage) {$0.withMemoryRebound(to:rusage_info_t?.self,capacity:1) {proc_pid_rusage(getpid(),RUSAGE_INFO_V2,$0)}}
    guard code==0 else {throw RuntimeError.launch}
    return usage.ri_user_time+usage.ri_system_time+usage.ri_child_user_time+usage.ri_child_system_time
}
private struct MeasuredVMInventory:NativeVMInventoryReading {
    let source:VerifiedVMInventory
    func capture()throws->NativeVMInventory {
        let began=try inventoryCPU(),value=try source.capture()
        let consumed=try inventoryCPU()-began
        print("METRIC: native inventory self_plus_reaped_child_cpu_ms=\(Int(ProcessCPU.seconds(ticks:consumed)*1000)); read-only CLI source breakdown, not idle acceptance")
        return value
    }
}

