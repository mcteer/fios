import Foundation
import Darwin

// Finite fake daemon replies for argv/state control-flow tests only. This
// program never connects to a runtime, starts a process or removes resources.
@main struct SandboxRemovalCLI {
    static func main() {
        do {try run()} catch {exit(2)}
    }
    static func run()throws {
        let args=CommandLine.arguments,prefix="/private/tmp/fios009-sandbox-removal-"
        guard getuid()>0,getuid()==geteuid(),args.count>=5,args[1]=="--host",args[2].hasPrefix("unix://") else {exit(2)}
        let path=String(args[2].dropFirst(7)),suffix="/docker.sock"
        guard path.hasPrefix(prefix),path.hasSuffix(suffix) else {exit(2)}
        let home=String(path.dropLast(suffix.count)),identifier=String(home.dropFirst(prefix.count))
        var info=stat()
        guard UUID(uuidString:identifier)?.uuidString.lowercased()==identifier,lstat(home,&info)==0,
              info.st_uid==geteuid(),info.st_mode&S_IFMT==S_IFDIR,info.st_mode&0o7777==0o700 else {exit(2)}
        let data=try Data(contentsOf:URL(fileURLWithPath:home+"/inspect.json"))
        guard data.count<=4096,let records=try JSONSerialization.jsonObject(with:data) as? [[String:Any]],records.count==1,
              let id=records[0]["Id"] as? String,id.utf8.count==64,id.utf8.allSatisfy({(48...57).contains($0)||(97...102).contains($0)}) else {exit(2)}
        if Array(args.dropFirst(3)) == ["container","ls","--all","--no-trunc","--filter","id="+id,"--format","{{.ID}}"] {
            print(id);return
        }
        if args.count==6,args[3]=="inspect",args[4]=="--type=container",args[5]==id {
            FileHandle.standardOutput.write(data);return
        }
        let plain=args.count==5 && args[3]=="rm" && args[4]==id
        let forced=args.count==6 && args[3]=="rm" && args[4]=="--force" && args[5]==id
        guard plain || forced else {exit(2)}
        try JSONSerialization.data(withJSONObject:Array(args.dropFirst(3))).write(to:URL(fileURLWithPath:home+"/remove.json"))
        if FileManager.default.fileExists(atPath:home+"/race-running"),plain {exit(1)}
    }
}
