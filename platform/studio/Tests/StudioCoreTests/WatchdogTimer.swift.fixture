// Trusted disposable watchdog fixture, never a model/production manager.
// Main control work is stalled; an independent timer keeps its file fresh but
// MUST NOT advance the serialized loop's progress. No sockets/models/runtime.
import Foundation
import Darwin

final class TimerState: @unchecked Sendable {
    let directory: URL
    let progress = ProcessInfo.processInfo.systemUptime
    var beats = 0 // Accessed only by the independent timer thread.
    init(_ directory: URL) { self.directory = directory }
    func tick() {
        guard FileManager.default.fileExists(atPath: directory.appendingPathComponent("fixture.lease").path) else { exit(0) }
        beats += 1
        let value: [String: Any] = ["version": 1, "pid": getpid(), "progress": progress,
                                   "heartbeat": ProcessInfo.processInfo.systemUptime, "beats": beats]
        if let data = try? JSONSerialization.data(withJSONObject: value) {
            try? data.write(to: directory.appendingPathComponent("progress.json"), options: .atomic)
        }
    }
}

@main struct WatchdogTimerFixture {
    static func main() {
        guard CommandLine.arguments.count == 3, CommandLine.arguments[1] == "--state",
              CommandLine.arguments[2].hasPrefix("/") else { exit(2) }
        let state = TimerState(URL(fileURLWithPath: CommandLine.arguments[2]))
        let timer = Thread { @Sendable in
            for _ in 0..<500 {
                state.tick()
                Thread.sleep(forTimeInterval: 0.1)
            }
        }
        timer.start()
        // Independent timer continues while the main control loop is genuinely stuck.
        // Fixture self-expires even if its owning supervisor unexpectedly disappears.
        Thread.sleep(forTimeInterval: 50)
    }
}
