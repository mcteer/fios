import Foundation
@main struct ActivityWorkerFrames {
    static func main()throws {
        let directory=URL(fileURLWithPath:CommandLine.arguments[1]),now=HostResources.nowMilliseconds()
        let metadata=ActivityObservationMetadata(host:"fixture-host",endpointHash:String(repeating:"a",count:64),profileHash:String(repeating:"b",count:64),
            managerEpoch:"00000000-0000-4000-8000-000000000002",nativeEpoch:String(repeating:"c",count:32),sequence:1,sampledAt:now,nativeSequence:7,nativeSampledAt:now)
        for name in ["idle","queued","active","responding","preparing","unknown","conflict"] {
            let counts=NativePhaseCounts(ingress:0,preparing:name=="preparing" ? 1:0,queued:name=="queued" ? 1:0,active:name=="active" ? 1:0,responding:name=="responding" ? 1:0)
            let model=name=="idle" ? "idle-other/model":"fixture/model@studio-a"
            var rows=[NativeModelActivity(model:model,resident:true,counts:counts)]
            if name=="conflict" {rows.append(NativeModelActivity(model:"other/model",resident:true,counts:.zero))}
            let data=try ActivityObservationExport.encode(metadata:metadata,coverage:name=="unknown" ? .unknown:.all_clients,sourceCoverage:.all_clients,
                totals:counts,models:rows,context:ActivityObservationContext())
            try data.write(to:directory.appendingPathComponent(name+".json"))
        }
    }
}
