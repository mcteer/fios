import Foundation
import Darwin

// Finite owned fixture: no listener, model, file or network operation. Touch
// every page. Default TERM-ignore supports cleanup cases; the explicit test
// marker selects ordinary TERM exit to witness hard-limit direct KILL.
@main struct WorkerRSSSentinel {
    static func main() {
        signal(SIGTERM,ProcessInfo.processInfo.environment["FIOS_PLATFORM_RSS_TERM_EXIT"]=="1" ? SIG_DFL:SIG_IGN)
        let size=576<<20
        let bytes=UnsafeMutableRawPointer.allocate(byteCount:size,alignment:4096)
        defer {bytes.deallocate()}
        // A repeated-byte allocation is highly compressible on macOS. Use
        // incompressible fixture data so resident-memory supervision observes
        // the intended oversized live child even on a pressured CI host.
        // These bytes are never emitted, persisted or used as credentials.
        arc4random_buf(bytes,size)
        // Keep the working set active until supervised. A sleeping allocation
        // can be compressed/paged out on a shared CI host before observation.
        // No wiring, host-memory setting or production limit is changed.
        let deadline=ProcessInfo.processInfo.systemUptime+30
        let page=Int(getpagesize())
        withExtendedLifetime(bytes) {
            while ProcessInfo.processInfo.systemUptime<deadline {
                for offset in stride(from:0,to:size,by:page) {
                    // External writes keep each actual page hot even under -O.
                    arc4random_buf(bytes.advanced(by:offset),1)
                }
                Thread.sleep(forTimeInterval:0.01)
            }
        }
    }
}
