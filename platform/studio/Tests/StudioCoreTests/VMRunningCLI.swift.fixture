import Foundation
import Darwin

@main struct VMRunningCLIFixture {
    static func main() {
        let environment=ProcessInfo.processInfo.environment
        guard CommandLine.arguments.count==2,CommandLine.arguments[1]=="status",
              environment["HOME"]=="/var/empty",environment["PATH"]=="/usr/bin:/bin",
              environment["LANG"]=="C",environment["LC_ALL"]=="C",
              ["SSH_AUTH_SOCK","MLX_API_KEY","DYLD_INSERT_LIBRARIES","DOCKER_HOST","DOCKER_CONTEXT"].allSatisfy({environment[$0]==nil}) else {exit(42)}
        FileHandle.standardOutput.write(Data("Running\n".utf8))
    }
}
