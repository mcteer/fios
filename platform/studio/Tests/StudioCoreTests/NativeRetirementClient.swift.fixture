import Foundation
import CryptoKit

@main enum RetirementClientFixture {
    static func main()throws {
        let args=CommandLine.arguments
        guard args.count==7,let pid=Int32(args[2]) else {throw RuntimeError.invalid}
        let directory=URL(fileURLWithPath:args[1]),image=args[3],socket=args[4],job=args[5],step=args[6]
        let executable=try VerifiedExecutable(path:image,sha256:SHA256.hash(data:Data(contentsOf:URL(fileURLWithPath:image))).map{String(format:"%02x",$0)}.joined())
        let peer=NativeControlPeer(pid:pid,start:try WorkerResources.startIdentifier(pid:pid),executable:executable)
        let client=NativeControlClient(path:socket,peer:peer)
        let scope=InferenceScope(host:"fixture-host",endpointHash:String(repeating:"a",count:64),profileHash:String(repeating:"b",count:64),
            managerEpoch:"00000000-0000-4000-8000-000000000002",nativeEpoch:String(repeating:"01",count:16),
            canonicalModel:"fixture/model-a",nativeModel:"fixture/model-a",sequence:1,sampledAt:10000)
        let id=try scope.nativeRequestCorrelationID(job:job,attempt:0)
        if step=="correlation" {print(id);return}
        let journal=try Journal(directory:directory)
        if step=="initial" {
            try journal.claim(job:job,attempt:0,model:scope.canonicalModel,scope:scope);try journal.markDispatched(job:job,attempt:0)
        }
        if step=="initial" || step=="retained" {
            let sample=try client.lineage(instance:scope.nativeEpoch,correlationID:id)
            guard sample.lineage.found,sample.lineage.rootSequence==1 else {throw RuntimeError.invalid}
            _=try journal.observeLineage(job:job,attempt:0,scope:scope,peer:peer,sample:sample,now:HostResources.nowMilliseconds())
        }
        let sample=try client.retirement(instance:scope.nativeEpoch,correlationID:id,rootSequence:1)
        let record=try journal.observeRetirement(job:job,attempt:0,scope:scope,peer:peer,sample:sample,now:HostResources.nowMilliseconds())
        guard (step=="retired") == (record != nil),try journal.unresolvedCount()==1 else {throw RuntimeError.invalid}
        if step != "initial" {guard try journal.uncertainCount()==1 else {throw RuntimeError.invalid}}
        if step=="fenced" {guard sample.retirement.uncertain else {throw RuntimeError.invalid}}
        print("PASS \(step): original local retirement metadata; independent inference claim retained")
    }
}
