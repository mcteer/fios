// Private fault only after genuine command buffers have physically completed.
#define REQUIRE(v,m) do{if(!(v)){fprintf(stderr,"%s\n",m);return 77;}}while(0)
static void* fios_foreign_cleanup(void* ignored){(void)ignored;ds4_gpu_cleanup();return NULL;}
int main(int argc,char** argv){@autoreleasepool{
 if(argc==2&&(strcmp(argv[1],"--batch-cleanup")==0||strcmp(argv[1],"--batch-success")==0)){
  const int success=strcmp(argv[1],"--batch-success")==0;
  REQUIRE(ds4_gpu_init(),"BATCH_REAL_INIT_FAILED");
  REQUIRE(ds4_gpu_begin_commands(),"BATCH_BEGIN_FAILED");
  int owned=99;id<MTLCommandBuffer> batch=ds4_gpu_command_buffer(&owned);
  REQUIRE(batch&&owned==0&&batch==g_batch_cb,"BATCH_REAL_BUFFER_MISSING");
  const uint64_t done=g_stream_expert_cache_done_seq,sequence=g_stream_expert_cache_batch_seq;
  REQUIRE(sequence>done,"BATCH_SEQUENCE_MISSING");
  id<MTLBuffer> retained=[g_device newBufferWithLength:1024 options:MTLResourceStorageModeShared];
  REQUIRE(retained,"BATCH_REAL_PAYLOAD_MISSING");
  g_parallel_q8_weight=retained;g_parallel_ffn_mode=1;
  fios_private_wait_failure=success?0:1;
  ds4_gpu_cleanup();
  REQUIRE(batch.status==MTLCommandBufferStatusCompleted,"BATCH_REAL_COMPLETION_FAILED");
  if(success){
   REQUIRE(!g_initialized&&!g_batch_cb&&!g_parallel_q8_weight&&!g_parallel_ffn_mode&&!g_fios_pending_uncertain,"FIO_DS4_SUCCESSFUL_BATCH_CLEANUP_REFUSED");
   puts("PASS: genuine successful empty batch cleanup releases its local state after checked completion; no model/all-device proof.");return 0;
  }
  REQUIRE(g_initialized&&g_batch_cb==batch&&g_stream_expert_cache_done_seq==done&&
    g_stream_expert_cache_batch_seq==sequence,"FIO_DS4_BATCH_CLEANUP_RELEASED_OR_ACKNOWLEDGED");
  REQUIRE(g_fios_pending_uncertain,"FIO_DS4_BATCH_CLEANUP_FAILURE_NOT_STICKY");
  REQUIRE(g_parallel_q8_weight==retained&&g_parallel_ffn_mode==1,"FIO_DS4_BATCH_CLEANUP_DROPPED_PARALLEL_PAYLOAD");
  fios_private_wait_failure=0;ds4_gpu_cleanup();
  REQUIRE(g_initialized&&g_batch_cb==batch&&!ds4_gpu_begin_commands(),"FIO_DS4_BATCH_CLEANUP_UNCERTAINTY_REFUNDED");
  puts("PASS: real cleanup batch physically completed before injected wait failure; buffer/accounting/uncertainty retained, not hardware-error proof.");
  return 0;
 }
 if(argc==2&&strcmp(argv[1],"--keepalive-cleanup")==0){
  REQUIRE(ds4_gpu_init()&&ds4_gpu_warm_command_queue(),"KEEPALIVE_CLEANUP_REAL_PRODUCER_MISSING");
  REQUIRE(atomic_load(&g_queue_keepalive_running),"KEEPALIVE_CLEANUP_NOT_RUNNING");
  id<MTLCommandQueue> queue=g_queue;
  fios_private_join_failure=1;
  ds4_gpu_cleanup();
  REQUIRE(g_initialized&&g_queue==queue&&atomic_load(&g_fios_keepalive_uncertain)&&
    atomic_load(&g_queue_keepalive_running),"FIO_DS4_CLEANUP_IGNORED_KEEPALIVE_JOIN_FAILURE");
  REQUIRE(g_fios_pending_uncertain,"FIO_DS4_KEEPALIVE_CLEANUP_FAILURE_NOT_STICKY");
  fios_private_join_failure=0;ds4_gpu_cleanup();
  REQUIRE(g_initialized&&g_queue==queue&&!ds4_gpu_begin_commands(),"FIO_DS4_KEEPALIVE_CLEANUP_UNCERTAINTY_REFUNDED");
  puts("PASS: cleanup retains global resources after actual producer join plus injected failed acknowledgement; no hardware/terminal proof.");return 0;
 }
 if(argc==2&&strcmp(argv[1],"--foreign-cleanup")==0){
  REQUIRE(ds4_gpu_init()&&ds4_gpu_warm_command_queue(),"FOREIGN_CLEANUP_REAL_PRODUCER_MISSING");
  id<MTLCommandQueue> queue=g_queue;pthread_t foreign;
  REQUIRE(pthread_create(&foreign,NULL,fios_foreign_cleanup,NULL)==0&&pthread_join(foreign,NULL)==0,"FOREIGN_CLEANUP_THREAD_FAILED");
  REQUIRE(g_initialized&&g_queue==queue&&g_fios_pending_uncertain&&atomic_load(&g_queue_keepalive_running),"FIO_DS4_FOREIGN_CLEANUP_RELEASED_LIVE_PRODUCER");
  REQUIRE(ds4_gpu_fios_keepalive_try_stop(),"FOREIGN_CLEANUP_OWNER_JOIN_FAILED");
  ds4_gpu_cleanup();
  REQUIRE(g_initialized&&g_queue==queue&&g_fios_pending_uncertain&&!atomic_load(&g_queue_keepalive_running),"FIO_DS4_FOREIGN_CLEANUP_UNCERTAINTY_REFUNDED");
  puts("PASS: actual foreign-thread cleanup retains live producer/global resources; later exact owner join does not refund uncertainty.");return 0;
 }
 REQUIRE(argc==1,"PENDING_BAD_ARGS");
 REQUIRE(ds4_gpu_init(),"PENDING_FULL_INIT_FAILED");
 id<MTLCommandBuffer> a=[g_queue commandBuffer],b=[g_queue commandBuffer];
 REQUIRE(a&&b,"PENDING_REAL_BUFFERS_MISSING");
 [a commit];[b commit];[a waitUntilCompleted];[b waitUntilCompleted];
 REQUIRE(a.status==MTLCommandBufferStatusCompleted&&b.status==MTLCommandBufferStatusCompleted,"PENDING_REAL_COMPLETION_FAILED");
 // Real source bookkeeping creates sequence1 and commits it as pending.
 REQUIRE(ds4_gpu_stream_expert_cache_note_batch_created(),"PENDING_SEQUENCE_NOT_CREATED");
 ds4_gpu_stream_expert_cache_note_batch_committed();
 uint64_t done=g_stream_expert_cache_done_seq,pending=g_stream_expert_cache_pending_max_seq;
 REQUIRE(pending>done,"PENDING_BOOKKEEPING_NOT_ARMED");
 [g_pending_cbs addObject:a];[g_pending_cbs addObject:b];
 fios_private_wait_failure=1;
 REQUIRE(!ds4_gpu_wait_pending_command_buffers("private post-completion failure"),"PENDING_FAULT_IGNORED");
 REQUIRE(g_pending_cbs.count==2&&g_pending_cbs[0]==a&&g_pending_cbs[1]==b&&
   g_stream_expert_cache_done_seq==done&&g_stream_expert_cache_pending_max_seq==pending,
   "FIO_DS4_FAILED_PENDING_RELEASED_OR_ACKNOWLEDGED");
 REQUIRE(g_fios_pending_uncertain,"PENDING_FAILURE_NOT_STICKY");
 fios_private_wait_failure=0;
 REQUIRE(!ds4_gpu_wait_pending_command_buffers("later successful status"),"FIO_DS4_PENDING_UNCERTAINTY_REFUNDED");
 REQUIRE(!ds4_gpu_synchronize(),"FIO_DS4_PENDING_SYNC_REFUNDED");
 REQUIRE(!ds4_gpu_begin_commands()&&!ds4_gpu_flush_encoder()&&!ds4_gpu_flush_commands()&&!ds4_gpu_end_commands(),"FIO_DS4_PENDING_REARMED_COMMANDS");
 REQUIRE(!ds4_gpu_new_command_buffer(),"FIO_DS4_PENDING_NEW_BUFFER_CREATED");
 int owned=99;
 REQUIRE(!ds4_gpu_command_buffer(&owned)&&owned==0,"FIO_DS4_PENDING_BORROWED_BUFFER_CREATED");
 ds4_gpu_cleanup();
 REQUIRE(g_fios_pending_uncertain&&g_initialized&&g_pending_cbs.count==2&&
   g_stream_expert_cache_done_seq==done&&g_stream_expert_cache_pending_max_seq==pending,
   "FIO_DS4_PENDING_CLEANUP_REFUNDED");
 // No recovery/retry or whole-device cleanup is credited as terminality.
 // Private extra strong refs keep both genuine objects alive even in a red.
 puts("PASS: actual completed buffers retained on injected wait failure; no hardware-error or aggregate terminal receipt.");
 return 0;
}}
