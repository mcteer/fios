// CPU-only genuine TP service fragment composed with actual compiled host callbacks.
// Foundation event objects replace external GPU events; no Metal/RDMA/model is executed.
// CPU-only original TP worker function with modeled metadata hooks and Foundation event objects.
// No Metal object, transport exchange, RDMA, model, backend initialization or native authority.
#import <Foundation/Foundation.h>
#include <pthread.h>
#include <stdatomic.h>
#include <stdint.h>
#include <stdbool.h>
#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sched.h>
#include <assert.h>
@interface FixtureEvent : NSObject
@property uint64_t signaledValue;
@end
@implementation FixtureEvent
@end
