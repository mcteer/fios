static atomic_int g_fios_request_owners_state=2,g_fios_pending_uncertain,g_fios_tp_uncertain;
static void fios_ds4_request_fence(void) {atomic_store(&g_fios_pending_uncertain,1);fios_native_request_owners_uncertain();}
static struct {void *(*capture)(void);uint64_t (*enter)(void *);int (*leave)(uint64_t);void (*release)(void *);int (*covers_current)(void *);} g_fios_request_owners={fios_native_request_owners_capture,fios_native_request_owners_enter,fios_native_request_owners_leave,fios_native_request_owners_release,fios_native_request_owners_covers_current};
// FIOS_TP_ORIGIN_HELPERS
// FIOS_TP_SERVICE_SOURCE
static int fixture_callback_ok,fixture_restore_ok;
static int fixture_exchange(void *context,uint32_t layer,uint32_t gate,uint64_t sequence) {
 (void)context;(void)layer;(void)gate;(void)sequence;
 fixture_callback_ok=fios_tp_fixture_callback();atomic_store(&g_tp_shutdown,1);return fixture_callback_ok;
}
static void *fixture_service(void *unused) {
 void *result=ds4_gpu_tp_service_thread(unused);
 fixture_restore_ok=fios_tp_fixture_scope_restored();return result;
}
int fios_tp_fixture_prepare(void) {
 g_tp_gpu_event=[FixtureEvent new];g_tp_cpu_event=[FixtureEvent new];g_tp_gpu_event.signaledValue=1;
 g_tp_exchange_fn=fixture_exchange;
 g_tp_queue[0]=(ds4_gpu_tp_request){.event_arrival=1,.seq=1};
#ifdef FIOS_TP_REQUEST_ORIGINS
 if(!fios_ds4_tp_capture_origins(&g_tp_queue[0].fios_origins))return 0;
#else
 fixture_original=fios_native_request_owners_capture();
 if(!fixture_original)return 0;
#endif
 g_tp_queue_count=1;return 1;
}
int fios_tp_fixture_run(void) {
 pthread_t thread;
 if(pthread_create(&thread,NULL,fixture_service,NULL)!=0)return 0;
 if(pthread_join(thread,NULL)!=0)return 0;
 return fixture_callback_ok && fixture_restore_ok && g_tp_cpu_event.signaledValue==1 && !g_tp_queue_count;
}
int fios_tp_fixture_retained(void) {
#ifdef FIOS_TP_REQUEST_ORIGINS
 return g_fios_tp_active_origins!=NULL && g_fios_tp_service_active && g_fios_tp_uncertain && g_fios_pending_uncertain;
#else
 return 0;
#endif
}
