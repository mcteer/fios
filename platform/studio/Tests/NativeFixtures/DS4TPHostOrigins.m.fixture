static int (*g_tp_big_exchange_fn)(void *,uint32_t,uint64_t,const void *,void *,uint64_t);
static void *g_tp_exchange_ud;
static double g_tp_exchange_ewma_us[2],g_tp_stat_gate_gpu_wait_ms[2],g_tp_stat_gate_exchange_ms[2];
static uint64_t g_tp_stat_gate_count[2];
static uint32_t *g_tp_gpu_flags,*g_tp_check_words,*g_tp_poll_region,*g_tp_poll_status;
static uint8_t *g_tp_slab_cpu;
