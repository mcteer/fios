// Actual complete-module CPU pool, ordinary finite metadata publication and
// small row work. No model, fabricated handles or failure/scheduling shim.
static void *cpu_mailbox_publication(void *context) {
    selected_join_work *work=context;
    if (pthread_mutex_lock(&g_pool.mutex)!=0 || pthread_mutex_lock(&work->mutex)!=0) abort();
    work->entered=1;
    if (pthread_cond_broadcast(&work->condition)!=0 || pthread_mutex_unlock(&work->mutex)!=0) abort();
    usleep(250000);
    if (pthread_mutex_unlock(&g_pool.mutex)!=0) abort();
    return NULL;
}
static void cpu_lifecycle_rows(void *context,uint64_t begin,uint64_t end) {
    unsigned *rows=context;
    for (uint64_t i=begin;i<end;++i) ++rows[i];
}
static int cpu_lifecycle_case(void) {
    g_requested_threads=2;
    ds4_threads_init();
    for (unsigned operation=0;operation<2;++operation) {
        selected_join_work work={PTHREAD_MUTEX_INITIALIZER,PTHREAD_COND_INITIALIZER,0,0,0};
        pthread_t publisher;
        JOIN_REQUIRE(pthread_create(&publisher,NULL,cpu_mailbox_publication,&work)==0,"CPU metadata publisher did not start");
        JOIN_REQUIRE(pthread_mutex_lock(&work.mutex)==0,"CPU metadata handoff unavailable");
        while (!work.entered)
            JOIN_REQUIRE(pthread_cond_wait(&work.condition,&work.mutex)==0,"CPU metadata handoff failed");
        JOIN_REQUIRE(pthread_mutex_unlock(&work.mutex)==0,"CPU metadata handoff release failed");
        struct timespec before,after;
        JOIN_REQUIRE(clock_gettime(CLOCK_MONOTONIC,&before)==0,"CPU preflight clock unavailable");
        const bool retained=operation==0 ? ds4_threads_work_busy()!=0:ds4_threads_shutdown_checked()==0;
        JOIN_REQUIRE(clock_gettime(CLOCK_MONOTONIC,&after)==0,"CPU preflight completion clock unavailable");
        JOIN_REQUIRE(pthread_join(publisher,NULL)==0,"CPU metadata publisher did not finish");
        const double elapsed=(double)(after.tv_sec-before.tv_sec)+(double)(after.tv_nsec-before.tv_nsec)/1000000000.0;
        JOIN_REQUIRE(retained && elapsed>=0 && elapsed<0.1,"CPU pool preflight waited for held metadata");
        JOIN_REQUIRE(g_pool.initialized && !g_pool.shutdown && !g_fios_cpu_pool_uncertain,"CPU metadata contention retired/poisoned its pool");
        JOIN_REQUIRE(pthread_cond_destroy(&work.condition)==0 && pthread_mutex_destroy(&work.mutex)==0,"CPU metadata publisher remained live");
    }
    for (unsigned cycle=0;cycle<2;++cycle) {
        unsigned rows[64]={0};
        ds4_parallel_for_min_rows(64,cpu_lifecycle_rows,rows,1);
        for (unsigned i=0;i<64;++i) JOIN_REQUIRE(rows[i]==1,"Genuine CPU pool lost or repeated row work");
        JOIN_REQUIRE(!ds4_threads_work_busy(),"Completed CPU pool remained busy");
        JOIN_REQUIRE(ds4_threads_shutdown_checked()==1,"Ordinary CPU pool retirement failed");
        JOIN_REQUIRE(!g_pool.initialized && !g_fios_cpu_pool_owner && !g_fios_cpu_pool_uncertain,"Joined CPU pool retained invalid lifecycle state");
    }
    puts("PASS: CPU pool preflights retain custody during metadata publication; two real parallel row-work/start/join cycles finish normally");
    return 0;
}
