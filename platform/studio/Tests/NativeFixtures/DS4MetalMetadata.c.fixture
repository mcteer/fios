// Ordinary finite mutex metadata publisher; no native handle or injected error.
typedef struct { pthread_mutex_t gate; pthread_cond_t ready; int entered; pthread_mutex_t *metadata; } metadata_publication;
static void *metadata_publisher(void *context) {
    metadata_publication *work=context;
    if (pthread_mutex_lock(work->metadata)!=0 || pthread_mutex_lock(&work->gate)!=0) abort();
    work->entered=1;
    if (pthread_cond_broadcast(&work->ready)!=0 || pthread_mutex_unlock(&work->gate)!=0) abort();
    usleep(250000);
    if (pthread_mutex_unlock(work->metadata)!=0) abort();
    return NULL;
}
#define META_REQUIRE(value,message) do {if (!(value)) {fprintf(stderr,"%s\n",message);return 77;}} while(0)
static int metadata_case(pthread_mutex_t *mutex,int (*probe)(void),int refused,const char *message) {
    metadata_publication work={PTHREAD_MUTEX_INITIALIZER,PTHREAD_COND_INITIALIZER,0,mutex};
    pthread_t publisher;
    META_REQUIRE(pthread_create(&publisher,NULL,metadata_publisher,&work)==0,"Metadata publisher failed to start");
    META_REQUIRE(pthread_mutex_lock(&work.gate)==0,"Metadata handoff unavailable");
    while (!work.entered) META_REQUIRE(pthread_cond_wait(&work.ready,&work.gate)==0,"Metadata handoff failed");
    META_REQUIRE(pthread_mutex_unlock(&work.gate)==0,"Metadata handoff release failed");
    struct timespec before,after;
    META_REQUIRE(clock_gettime(CLOCK_MONOTONIC,&before)==0,"Metadata clock unavailable");
    const int result=probe();
    META_REQUIRE(clock_gettime(CLOCK_MONOTONIC,&after)==0,"Metadata completion clock unavailable");
    META_REQUIRE(pthread_join(publisher,NULL)==0,"Metadata publisher did not finish");
    const double elapsed=(double)(after.tv_sec-before.tv_sec)+(double)(after.tv_nsec-before.tv_nsec)/1000000000.0;
    META_REQUIRE(result==refused && elapsed>=0 && elapsed<0.1,message);
    META_REQUIRE(pthread_cond_destroy(&work.ready)==0 && pthread_mutex_destroy(&work.gate)==0,"Metadata publisher remained live");
    return 0;
}
