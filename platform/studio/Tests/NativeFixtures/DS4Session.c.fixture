// Actual session function source with mock layout/callees. No native session,
// model, network, RDMA operation or peer-retirement proof.
#include <stdbool.h>
#include <stdint.h>
#include <stdio.h>
#include <string.h>
#define DS4_NO_GPU 1
typedef struct {bool fios_session_destroy_uncertain;uint64_t glm_session_graph_bytes;unsigned glm_session_count;struct {void *ctx;} tp;} ds4_engine;
typedef struct {
 ds4_engine *engine;uint64_t glm_reserved_graph_bytes;uint32_t tp_session_id;
 bool fios_destroy_uncertain;
 void *distributed,*checkpoint_images,*logits,*sample_probs,*mtp_logits;
 int cpu_cache,cpu_scratch,checkpoint,greedy_splitkv_segment;
} ds4_session;
static unsigned destructive,sends,acks;
static int send_result=1,ack_result=1,transport_failed;
static int ds4_session_tp_leader(ds4_session *s){(void)s;return 1;}
static int ds4_session_is_cpu(ds4_session *s){(void)s;return 1;}
static int ds4_tp_failed(void *ctx){(void)ctx;return transport_failed;}
static int ds4_tp_send_session_destroy(void *ctx,uint32_t id){(void)ctx;(void)id;++sends;return send_result;}
static int ds4_tp_wait_command_ack(void *ctx,uint32_t id,const char *kind,char *err,unsigned long size){(void)ctx;(void)id;(void)kind;(void)err;(void)size;++acks;return ack_result;}
#define free(...) (++destructive)
#define ds4_dist_session_free(...) (++destructive)
#define kv_cache_free(...) (++destructive)
#define cpu_decode_scratch_free(...) (++destructive)
#define token_vec_free(...) (++destructive)
/* SOURCE_FUNCTIONS */
#ifndef FIOS_HAS_CHECKED_SESSION
static int ds4_session_free_checked(ds4_session *s){ds4_session_free(s);return 1;}
#endif
int main(int argc,char **argv){
 if(argc!=2)return 77;
 ds4_engine e={.glm_session_graph_bytes=40,.glm_session_count=2};
 ds4_session s={.engine=&e,.glm_reserved_graph_bytes=16,.tp_session_id=7};
 const int success=strcmp(argv[1],"--success")==0;
 if(strcmp(argv[1],"--send-failure")==0)send_result=0;
 if(strcmp(argv[1],"--ack-failure")==0)ack_result=0;
 if(strcmp(argv[1],"--failed-transport")==0)transport_failed=1;
 const int result=ds4_session_free_checked(&s);
 if(success){
  if(result!=1||!destructive||s.tp_session_id||e.glm_session_graph_bytes!=24||e.glm_session_count!=1||sends!=1||acks!=1){fputs("SESSION_LOCAL_SUCCESS_CONTROL_CHANGED\n",stderr);return 77;}
  return 0;
 }
 if(result||destructive||!e.fios_session_destroy_uncertain||s.tp_session_id!=7||s.engine!=&e||s.glm_reserved_graph_bytes!=16||e.glm_session_graph_bytes!=40||e.glm_session_count!=2){
  fputs("FIO_DS4_SESSION_RELEASED_AFTER_UNACKNOWLEDGED_DESTROY\n",stderr);return 77;
 }
 const unsigned old_sends=sends,old_acks=acks;
 send_result=ack_result=1;transport_failed=0;
 if(ds4_session_free_checked(&s)||destructive||sends!=old_sends||acks!=old_acks){fputs("FIO_DS4_SESSION_DESTROY_UNCERTAINTY_REFUNDED\n",stderr);return 77;}
 puts("PASS: actual session function source retains mock local resources/accounting after uncertain peer destroy; no native/peer retirement proof.");
}
