// Owned CPU/socket/file witnesses only. Never touches models or real daemons.
#include <unistd.h>
#include <fcntl.h>
#include <errno.h>
#include <stdio.h>
#include <string.h>
#include <sys/socket.h>
#include <sys/un.h>
#include <sys/wait.h>
int main(int argc, char **argv) {
    if (argc != 5) return 64;
    int fd = open(argv[1], O_WRONLY | O_APPEND);
    if (fd >= 0) { (void)write(fd,"X",1); close(fd); puts("FIO_REVIEW_SHARED_WRITE"); return 41; }
    if (errno != EPERM && errno != EACCES) return 65;
    fd = open(argv[2], O_WRONLY | O_CREAT | O_EXCL, 0600);
    if (fd < 0) return 66;
    if (write(fd,"private",7) != 7) return 67;
    close(fd);
    int sock = socket(AF_UNIX, SOCK_STREAM, 0);
    if (sock < 0) return 68;
    struct sockaddr_un local = {0}, remote = {0}; local.sun_family=AF_UNIX; remote.sun_family=AF_UNIX;
    snprintf(local.sun_path,sizeof(local.sun_path),"%s.sock",argv[2]);
    snprintf(remote.sun_path,sizeof(remote.sun_path),"%s",argv[3]);
    if (bind(sock,(struct sockaddr *)&local,sizeof(local)) != 0) return 69;
    if (connect(sock,(struct sockaddr *)&remote,sizeof(remote)) == 0) {close(sock);puts("FIO_REVIEW_SOCKET_ESCAPE");return 42;}
    if (errno != EPERM && errno != EACCES) return 70;
    close(sock);
    pid_t child = fork();
    if (child == 0) _exit(0);
    if (child > 0) {int status;waitpid(child,&status,0);puts("FIO_REVIEW_FORK_ESCAPE");return 43;}
    if (errno != EPERM && errno != EACCES) return 71;
    execl(argv[4],argv[4],(char *)NULL);
    if (errno != EPERM && errno != EACCES) return 72;
    puts("FIO_REVIEW_KERNEL_PASS"); return 0;
}
