private final class ServingRuntimeGate:@unchecked Sendable {
    let entered=DispatchSemaphore(value:0),release=DispatchSemaphore(value:0)
    private let lock=NSLock()
    private var first=true,count=0
    var validations:Int {lock.lock();defer {lock.unlock()};return count}
    private let trace:@Sendable(String)->Void
    init(trace:@escaping @Sendable(String)->Void={_ in}) {self.trace=trace}
    func validate(_ command:ServiceLaunchCommand)throws {
        lock.lock();let held=first;first=false;count+=1;lock.unlock()
        if held {
            trace("validation-entered");entered.signal()
            guard release.wait(timeout:.now()+5) == .success else {trace("validation-timeout");throw RuntimeError.deadline}
            trace("validation-released")
        }
    }
}
private final class ServingStopGate:@unchecked Sendable {
    let entered=DispatchSemaphore(value:0),release=DispatchSemaphore(value:0)
    private let lock=NSLock()
    private var first=true,deny=false,count=0
    var validations:Int {lock.lock();defer {lock.unlock()};return count}
    func denyNext() {lock.lock();deny=true;lock.unlock()}
    func validate(_ command:ServingStopCommand)throws {
        lock.lock();let held=first,denied=deny;first=false;deny=false;count+=1;lock.unlock()
        if held {entered.signal();guard release.wait(timeout:.now()+5) == .success else {throw RuntimeError.deadline}}
        if denied {throw RuntimeError.invalid}
    }
}
private final class FixtureServingHealth:@unchecked Sendable {
    private let lock=NSLock()
    private var failedIdentity:ServiceIdentity?
    func failed(_ identity:ServiceIdentity)->Bool {lock.lock();defer {lock.unlock()};return failedIdentity==identity}
    func project(_ observation:ServiceObservation?,loading:Bool,unavailable:Bool)->ServiceObservation? {
        lock.lock();defer {lock.unlock()}
        if !unavailable {failedIdentity=nil}
        guard let value=observation else {return nil}
        if unavailable,failedIdentity==nil,let identity=value.identity {failedIdentity=identity}
        let state:ServiceHealthState?
        if loading {state = .loading}
        else if unavailable,let identity=value.identity,identity==failedIdentity {state = .unavailable}
        else {state=nil}
        guard let state else {return value}
        // Synthetic API metadata only, never native idle/terminality authority.
        return ServiceObservation(identity:value.identity,responding:false,sessionReady:value.sessionReady,credentialsReady:value.credentialsReady,nativeIdle:value.nativeIdle,runtimeUnmanaged:value.runtimeUnmanaged,sampledAt:value.sampledAt,health:state)
    }
}
// Same-file extension reaches only the private fixture initializer/child. No
// installed factory or native app is invoked; the actual helper has no models.
extension MLXServingProcessRuntime {
    fileprivate var fixtureRetainsChild:Bool {lock.lock();defer {lock.unlock()};return process != nil}
    fileprivate func fixtureStopIntent(_ receipt:ServiceRecordedLaunch,desired:ServiceDesired = .stopped)throws->ServingStopIntent {
        lock.lock();defer {lock.unlock()}
        guard executable.path.hasPrefix("/private/tmp/fios-009-serving-runtime-"),phase == .running,
              receipt.service == .mlx,receipt.id==activeID,receipt.identity==identity,receipt.profileHash==profileHash,desired != .maintenance else {throw RuntimeError.invalid}
        return ServingStopIntent(receipt:receipt,desired:desired)
    }
    fileprivate func fixtureObservation(now:Int64)->ServiceObservation? {
        lock.lock();let currentPhase=phase,child=process,value=identity;lock.unlock()
        if currentPhase == .idle {
            return ServiceObservation(identity:nil,responding:false,sessionReady:true,credentialsReady:true,nativeIdle:nil,runtimeUnmanaged:nil,sampledAt:now)
        }
        if currentPhase == .running,let child,!child.isRunning {
            // This fixture owns its complete one-child CPU service scope.
            // Positive wait is not global native absence/terminality authority.
            return ServiceObservation(identity:nil,responding:false,sessionReady:true,credentialsReady:true,nativeIdle:nil,runtimeUnmanaged:nil,sampledAt:now)
        }
        guard currentPhase == .running,let child,let value,child.isRunning,
              (try? ServiceIdentity.verified(peer:NativeControlPeer(pid:value.pid,start:value.start,executable:executable),expectedUID:geteuid(),deadline:ProcessInfo.processInfo.systemUptime+0.5))==value else {return nil}
        // Identity is real; API readiness is explicitly synthetic. The helper
        // has no listener, model, native activity source or admission authority.
        return ServiceObservation(identity:value,responding:true,sessionReady:true,credentialsReady:true,nativeIdle:nil,runtimeUnmanaged:nil,sampledAt:now,health:.healthy)
    }
    fileprivate static func fixture(executable:VerifiedExecutable,home:String,profile:String,gate:ServingRuntimeGate,stopGate:ServingStopGate?=nil,ignoreTerm:Bool=false,exitOnce:Bool=false,cwdProof:Bool=false,workingDirectory:String?=nil)throws->MLXServingProcessRuntime {
        guard executable.path.hasPrefix("/private/tmp/fios-009-serving-runtime-") else {throw RuntimeError.invalid}
        let base=["PATH":"/usr/bin:/bin","LANG":"C","LC_ALL":"C","HOME":home]
        let arguments=ignoreTerm ? ["ignore-term"]:exitOnce ? ["exit-once"]:cwdProof ? ["cwd-proof"]:[]
        let directory=workingDirectory ?? home
        let boundProfile=try ServiceLaunchProfile.nativeDigest(base:profile,arguments:arguments,environment:base,workingDirectory:directory)
        let validateStop:@Sendable(ServingStopCommand)throws->Void={command in
            // This constructor can authorize only this model-free private
            // helper. It supplies no installed/native quiescence authority.
            guard let stopGate,command.identity.sha256==executable.sha256,command.profileHash==boundProfile,
                  WireScalar.uuid(command.launchID),WireScalar.uuid(command.id) else {throw RuntimeError.invalid}
            try stopGate.validate(command)
        }
        do {
            _=try MLXServingProcessRuntime(executable:executable,arguments:Array(repeating:String(repeating:"x",count:4096),count:20),environment:base,workingDirectory:home,serviceProfileHash:profile,validateReservation:gate.validate,validateStopReservation:validateStop)
            throw JournalError.conflict
        }catch RuntimeError.invalid {}
        let fixed=try MLXServingProcessProfile(serverSHA256:executable.sha256,applicationSHA256:executable.sha256,reviewDigest:profile,uid:geteuid())
        do {
            _=try MLXServingProcessRuntime(profile:fixed,arguments:["pull","serve"],environment:base,workingDirectory:home,serviceProfileHash:profile,validateReservation:gate.validate,validateStopReservation:validateStop)
            throw JournalError.conflict
        }catch RuntimeError.invalid {}
        guard [ignoreTerm,exitOnce,cwdProof].filter({$0}).count<=1 else {throw RuntimeError.invalid}
        return try MLXServingProcessRuntime(executable:executable,arguments:arguments,environment:base,workingDirectory:directory,serviceProfileHash:profile,validateReservation:gate.validate,validateStopReservation:validateStop)
    }
    fileprivate func endFixtureChild()throws {
        lock.lock();let child=process,value=identity;lock.unlock()
        guard let child,let value,executable.path.hasPrefix("/private/tmp/fios-009-serving-runtime-") else {throw RuntimeError.invalid}
        _=try ServiceIdentity.verified(peer:NativeControlPeer(pid:value.pid,start:value.start,executable:executable),expectedUID:geteuid(),deadline:ProcessInfo.processInfo.systemUptime+1)
        try child.terminate(expected:value,deadline:ProcessInfo.processInfo.systemUptime+1) // Only this fixture's positively owned child.
    }
    fileprivate func waitForFixtureExpiry()throws {
        lock.lock();let child=process;lock.unlock()
        guard let child,executable.path.hasPrefix("/private/tmp/fios-009-serving-runtime-") else {throw RuntimeError.invalid}
        let end=ProcessInfo.processInfo.systemUptime+7
        while ProcessInfo.processInfo.systemUptime<end {
            if !child.isRunning {return} // Exact direct-child wait; no runtime reset.
            Thread.sleep(forTimeInterval:0.01)
        }
        throw RuntimeError.deadline
    }
}
