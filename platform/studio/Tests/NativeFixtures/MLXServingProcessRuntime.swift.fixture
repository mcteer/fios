                guard let lookup=try recovery.next(service:.mlx,desired:.running,observation:absent(now),now:now,tick:now),
                      lookup.operation == .lookup,lookup.command.id==request.command.id else {throw RuntimeError.invalid}
                // Reconstructed in-memory transport has no receipt for the
                // original child. It must not adopt, replay or infer not-sent.
