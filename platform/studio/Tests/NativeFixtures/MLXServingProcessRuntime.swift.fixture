                let coldTransport=try NativeServingRecoveryTransport(runtime:cold,approvedHashes:pins)
                guard try coldTransport.request(lookup) == .uncertain else {throw RuntimeError.invalid}
                outcome=try exchange(lookup)
                if outcome == .uncertain {Thread.sleep(forTimeInterval:0.005)}
            }
            guard case .started(let identity)=outcome else {throw RuntimeError.invalid}
            guard try transport.request(request)==outcome else {throw RuntimeError.invalid} // Native ID replay cannot spawn again.
            identities.append(identity);try recovery.receive(request,result:outcome)
            let reconstructed=try ServiceRecoveryController(journal:journal,approvedHashes:pins)
            guard let recorded=reconstructed.recordedLaunch(.mlx),recorded.id==request.command.id,recorded.identity==identity,
                  !reconstructed.isPending(.mlx),recordedProbe.capture(recorded).state == .current(identity),
                  try journal.uncertainCount()==1 else {throw RuntimeError.invalid}
            let crossService=ServiceRecordedLaunch(service:.orbstack,id:recorded.id,identity:identity,boot:recorded.boot,profileHash:profile)
            guard recordedProbe.capture(recorded).receipt==recorded,recordedProbe.capture(crossService).state == .unknown else {throw RuntimeError.invalid}
            do {try runtime.begin(blocked,deadline:ProcessInfo.processInfo.systemUptime+5);throw JournalError.conflict}catch RuntimeError.capacity {}
            guard !runtime.retireKnownExited(),try journal.uncertainCount()==1 else {throw RuntimeError.invalid}
            try runtime.endFixtureChild();try retired()
            guard runtime.lookup(id:request.command.id)==outcome,recordedProbe.capture(recorded).state == .exited,
                  unrelated.isRunning,try WorkerResources.startIdentifier(pid:unrelated.processIdentifier)==unrelatedStart,
                  try journal.uncertainCount()==1 else {throw RuntimeError.invalid}
        }
        guard identities.count==2,identities[0] != identities[1] else {throw RuntimeError.invalid}
        print("PASS: actual private serving-role process launch/identity/local reap/relaunch, retained validation cancellation slot, no duplicate child and independent native uncertainty retained")
        print("PASS: native server transport through actual manager recovery queue, original durable operation lookup and no GUI fallback")
        print("PASS: POSIX owned-child reap preserves a separate live Foundation child; no global reap or process-name cleanup")
    }
}
