// Appended to the unmodified complete C module. Ordinary idle service-thread
// lifecycle only: no model job, tensor/event, network, RDMA or fault injection.
#include <mach/mach.h>
#include <mach/thread_info.h>
#define REQUIRE(v,m) do { if (!(v)) { fprintf(stderr,"%s\n",m); return 1; } } while (0)
static int selected_thread_present(uint64_t identifier) {
    thread_act_array_t threads = NULL;
    mach_msg_type_number_t count = 0;
    if (task_threads(mach_task_self(), &threads, &count) != KERN_SUCCESS) return -1;
    int found = 0, unknown = 0;
    for (mach_msg_type_number_t i = 0; i < count; ++i) {
        thread_identifier_info_data_t info;
        mach_msg_type_number_t length = THREAD_IDENTIFIER_INFO_COUNT;
        if (thread_info(threads[i], THREAD_IDENTIFIER_INFO, (thread_info_t)&info, &length) != KERN_SUCCESS)
            unknown = 1;
        else if (info.thread_id == identifier) found = 1;
        mach_port_deallocate(mach_task_self(), threads[i]);
    }
    if (vm_deallocate(mach_task_self(), (vm_address_t)threads, count * sizeof(thread_t)) != KERN_SUCCESS) return -1;
    // An observed exact match proves presence even if an unrelated terminating
    // thread was unreadable. Absence still needs every observation to succeed.
    return found ? 1 : (unknown ? -1 : 0);
}
typedef struct { bool token_issued, reused, retired; } selected_lifecycle_result;
static void *selected_other_lifecycle_caller(void *context) {
    selected_lifecycle_result *result = context;
    result->token_issued = ds4_threads_owner_token() != 0;
    result->reused = metal_graph_selected_async_load_ensure_worker();
    result->retired = metal_graph_selected_async_load_shutdown_checked();
    return NULL;
}
static int selected_creator_cycles(void) {
    for (unsigned cycle = 0; cycle < 2; ++cycle) {
        REQUIRE(metal_graph_selected_async_load_ensure_worker(), "Ordinary selected worker startup failed");
        uint64_t identifier = 0;
        REQUIRE(pthread_threadid_np(g_metal_graph_selected_async_load_thread, &identifier) == 0 && identifier > 0,
                "Actual selected worker thread identifier unavailable");
        uint64_t caller_identifier = 0;
        REQUIRE(pthread_threadid_np(NULL, &caller_identifier) == 0, "Caller thread identifier unavailable");
        fprintf(stderr,"Ordinary lifecycle cycle %u: caller=%llu worker=%llu\n",cycle,
                (unsigned long long)caller_identifier,(unsigned long long)identifier);
        int observed = selected_thread_present(identifier);
        REQUIRE(observed >= 0, "Started selected worker observation unavailable");
        REQUIRE(observed == 1, "Started selected worker not observed");
        REQUIRE(metal_graph_selected_async_load_idle(), "Unused selected worker unexpectedly busy");
        selected_lifecycle_result result = {0};
        pthread_t other;
        REQUIRE(pthread_create(&other, NULL, selected_other_lifecycle_caller, &result) == 0,
                "Second lifecycle caller could not start");
        REQUIRE(pthread_join(other, NULL) == 0, "Second lifecycle caller did not return");
        REQUIRE(result.token_issued, "Second lifecycle caller has no thread-lifetime identity");
        REQUIRE(!result.retired, "Mismatched lifecycle caller retired the selected worker");
        REQUIRE(!result.reused, "Mismatched lifecycle caller adopted the selected worker");
        REQUIRE(g_metal_graph_selected_async_load_thread_started &&
                !g_fios_selected_shutdown_requested && !g_fios_selected_shutdown_uncertain,
                "Mismatched lifecycle caller changed worker custody");
        observed = selected_thread_present(identifier);
        REQUIRE(observed >= 0, "Creator's selected worker observation unavailable");
        REQUIRE(observed == 1, "Creator's selected worker was lost");
        REQUIRE(metal_graph_selected_async_load_ensure_worker(), "Creator could not reuse its worker");
        REQUIRE(metal_graph_selected_async_load_shutdown_checked(), "Ordinary selected worker shutdown failed");
        REQUIRE(!g_metal_graph_selected_async_load_thread_started, "Stopped selected worker remained published");
        REQUIRE(g_fios_selected_worker_owner == 0, "Joined worker retained its creator identity");
        REQUIRE(metal_graph_selected_async_load_shutdown_checked(), "Repeated idle shutdown failed");
        int present = -1;
        for (unsigned n = 0; n < 1000; ++n) {
            present = selected_thread_present(identifier);
            if (present == 0) break;
            usleep(1000); // Allow ordinary kernel thread-exit bookkeeping.
        }
        fprintf(stderr,"Ordinary lifecycle cycle %u: final thread observation=%d\n",cycle,present);
        REQUIRE(present >= 0, "Thread retirement observation unavailable");
        REQUIRE(present == 0, "Selected worker survived its checked shutdown");
        REQUIRE(metal_graph_selected_async_load_idle(), "Stopped selected worker did not return idle");
    }
    return 0;
}
typedef struct { uint64_t owner; int status; } selected_creator_result;
static void *selected_sequential_creator(void *context) {
    selected_creator_result *result = context;
    result->owner = ds4_threads_owner_token();
    result->status = selected_creator_cycles();
    return NULL;
}
int main(void) {
    REQUIRE(selected_creator_cycles() == 0, "Initial creator lifecycle failed");
    const uint64_t initial_owner = ds4_threads_owner_token();
    uint64_t previous_owner = initial_owner;
    // Normal serialized ownership transfer after complete shutdown. Each new
    // creator exits before the next starts; no abandoned worker is adopted.
    for (unsigned generation = 0; generation < 2; ++generation) {
        selected_creator_result result = {0};
        pthread_t creator;
        REQUIRE(pthread_create(&creator, NULL, selected_sequential_creator, &result) == 0,
                "Sequential creator could not start");
        REQUIRE(pthread_join(creator, NULL) == 0, "Sequential creator did not return");
        REQUIRE(result.owner && result.owner != initial_owner && result.owner != previous_owner,
                "Sequential creator reused a thread-lifetime identity");
        REQUIRE(result.status == 0, "Sequential creator lifecycle failed");
        previous_owner = result.owner;
    }
    REQUIRE(metal_graph_selected_async_load_shutdown_checked(), "Final idle shutdown failed");
    puts("PASS: six ordinary selected-worker cycles across three sequential creators; mismatched caller retains custody; repeated shutdown succeeds; exact threads absent after creator join");
    return 0;
}
