// Appended to actual CPU pool source. Genuine pthreads; no model/SDK handles.
#include <stdatomic.h>
#define REQUIRE(v,m) do{if(!(v)){fprintf(stderr,"%s\n",m);return 77;}}while(0)
static atomic_uint entered,released;
static void held(void *ctx,uint64_t a,uint64_t b){
 (void)ctx;(void)a;(void)b;atomic_fetch_add(&entered,1);
 while(!atomic_load(&released))usleep(100);
}
static uint64_t producer_rows=1;
static void* producer(void *ctx){ds4_parallel_for(producer_rows,held,ctx);return NULL;}
static void write_rows(void *ctx,uint64_t a,uint64_t b){unsigned *values=ctx;for(uint64_t i=a;i<b;++i)++values[i];}
static void nested_rows(void *ctx,uint64_t a,uint64_t b){ds4_parallel_for(b-a,write_rows,(unsigned*)ctx+a);}
int main(int argc,char **argv){
 setenv("DS4_THREADS","2",1);ds4_threads_init();
 REQUIRE(g_pool.initialized&&g_pool.n_threads==2,"CPU_REAL_POOL_NOT_CREATED");
 if(argc==2&&strcmp(argv[1],"--join-error")==0){
  const pthread_t thread=g_pool.threads[1];fios_join_failure=1;
  int result=ds4_threads_shutdown_checked();
  REQUIRE(!result&&g_pool.initialized&&g_pool.n_threads==2&&pthread_equal(g_pool.threads[1],thread),"FIO_DS4_CPU_JOIN_REFUSAL_LOST_POOL");
  REQUIRE(fios_actual_joins==1,"CPU_FAULT_DID_NOT_FOLLOW_ACTUAL_JOIN");
  fios_join_failure=0;
  REQUIRE(!ds4_threads_shutdown_checked()&&fios_actual_joins==1,"FIO_DS4_CPU_JOIN_UNCERTAINTY_REFUNDED");
  puts("PASS: actual idle CPU worker joins before injected failed acknowledgement; exact pool custody retained.");return 0;
 }
 if(argc==2&&(strcmp(argv[1],"--busy-inline")==0||strcmp(argv[1],"--busy-parallel")==0)){
  const int parallel=strcmp(argv[1],"--busy-parallel")==0;producer_rows=parallel?1024:1;
  pthread_t writer;int payload=9;
  REQUIRE(pthread_create(&writer,NULL,producer,&payload)==0,"CPU_INLINE_WRITER_CREATE_FAILED");
  for(unsigned n=0;n<2000&&atomic_load(&entered)<(parallel?2u:1u);++n)usleep(1000);
  REQUIRE(atomic_load(&entered)==(parallel?2u:1u),"CPU_WRITERS_NOT_ENTERED");
  const int result=ds4_threads_shutdown_checked();
  const int preserved=!result&&g_pool.initialized&&!g_pool.shutdown&&!fios_actual_joins;
  atomic_store(&released,1);REQUIRE(pthread_join(writer,NULL)==0,"CPU_INLINE_WRITER_JOIN_FAILED");
  REQUIRE(preserved,"FIO_DS4_CPU_SHUTDOWN_RELEASED_ACTIVE_INLINE_WRITER");
  REQUIRE(ds4_threads_shutdown_checked()&&!g_pool.initialized,"CPU_IDLE_AFTER_INLINE_REFUSED");
  puts(parallel?"PASS: actual parallel CPU writers hold pool lifetime; busy shutdown refuses before signalling or joins.":"PASS: actual inline CPU writer holds pool lifetime; busy shutdown refuses before signalling or joins.");return 0;
 }
 REQUIRE(argc==1,"CPU_BAD_ARGS");
 unsigned values[1024]={0};ds4_parallel_for(1024,nested_rows,values);
 for(unsigned i=0;i<1024;++i)REQUIRE(values[i]==1,"CPU_ORDINARY_ROWS_CHANGED");
 REQUIRE(ds4_threads_shutdown_checked()&&!g_pool.initialized&&fios_actual_joins==1,"CPU_ORDINARY_JOIN_REFUSED");
 REQUIRE(ds4_threads_shutdown_checked()&&fios_actual_joins==1,"CPU_EMPTY_TEARDOWN_CHANGED");
 puts("PASS: actual idle CPU worker and empty pool retire normally.");
}
