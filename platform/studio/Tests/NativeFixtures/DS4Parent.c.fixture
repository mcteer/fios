static void *g_tp_block_ctx;
static unsigned destructive,checked,legacy,prepared,unordered;
static int destroy(void){if(!prepared)++unordered;return ++destructive;}
static int checked_result,prepare_result=1,cpu_result=1;
static unsigned cpu_checked,selected_probes;
