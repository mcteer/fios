 }
 if(argc==2&&strcmp(argv[1],"--child-uncertain")==0){
  e.fios_teardown_uncertain=true;const ds4_engine before=e;
  const int destroyed=ds4_engine_close_checked(&e);
  if(destroyed||destructive||cpu_checked||prepared||checked||memcmp(&e,&before,sizeof(e))){
   fputs("FIO_DS4_ENGINE_RELEASED_AFTER_UNCERTAIN_SESSION_DESTROY\n",stderr);return 77;
  }
  return 0;
 }
 if(argc==2&&strcmp(argv[1],"--checked-refusal")==0){
  cpu_result=0;const ds4_engine before=e;
  const int destroyed=ds4_engine_close_checked(&e);
  if(destroyed||destructive||memcmp(&e,&before,sizeof(e))){fputs("FIO_DS4_PUBLIC_CLOSE_ACKNOWLEDGED_REFUSAL\n",stderr);return 77;}
  return 0;
 }
 e.tp.ctx=&context;e.tp.slab=&slab;g_tp_block_ctx=&context;
 ds4_engine before=e;
 if(argc==1)ds4_engine_tp_unbind(&e);else ds4_engine_close(&e);
 if(destructive||legacy||checked!=1||memcmp(&e,&before,sizeof(e))||g_tp_block_ctx!=&context){
  fputs(argc==1?"FIO_DS4_PARENT_UNBIND_IGNORED_REFUSAL\n":"FIO_DS4_PARENT_CLOSE_IGNORED_REFUSAL\n",stderr);return 77;
 }
 checked=0;ds4_engine_close(&e);
 if(destructive||legacy||checked!=1||memcmp(&e,&before,sizeof(e))||g_tp_block_ctx!=&context){
  fputs("FIO_DS4_PARENT_CLOSE_IGNORED_REFUSAL\n",stderr);return 77;
 }
 puts("PASS: actual parent function source preserves all mock resources on checked TP refusal; no native ABI/retirement proof.");
