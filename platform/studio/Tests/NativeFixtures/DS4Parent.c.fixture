  puts("PASS: empty and null parent mock controls retain legacy behavior.");return 0;
 }
 if(argc==2&&strcmp(argv[1],"--prepared-success")==0){
  checked_result=1;e.tp.ctx=&context;e.tp.slab=&slab;g_tp_block_ctx=&context;
  ds4_engine_tp_unbind(&e);
