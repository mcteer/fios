 }
 if(argc==2&&strcmp(argv[1],"--pagein-active")==0){
  pagein_busy=1;const ds4_engine before=e;
  if(ds4_engine_close_checked(&e)||destructive||cpu_checked||prepared||checked||memcmp(&e,&before,sizeof(e))){
   fputs("FIO_DS4_ENGINE_RELEASED_WITH_PAGEIN_CUSTODY\n",stderr);return 77;
