 }
 if(argc==2&&strcmp(argv[1],"--selected-active")==0){
  selected_idle=0;const ds4_engine before=e;
  const int destroyed=ds4_engine_close_checked(&e);
  if(destroyed||destructive||cpu_checked||prepared||checked||selected_probes!=1||memcmp(&e,&before,sizeof(e))){
   fputs("FIO_DS4_ENGINE_RELEASED_WITH_ACTIVE_SELECTED_LOADER\n",stderr);return 77;
  }
