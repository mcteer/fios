   fputs("FIO_DS4_PARENT_RELEASED_BEFORE_CPU_RETIREMENT\n",stderr);return 77;
  }
  return 0;
 }
 if(argc==2&&strcmp(argv[1],"--cpu-unbind")==0){
  cpu_work_busy=1;e.tp.ctx=&context;e.tp.slab=&slab;const ds4_engine before=e;
