  ds4_engine_close(&e);
  if(prepared!=2||unordered){fputs("PARENT_PREPARED_CLOSE_ORDER\n",stderr);return 77;}
  return 0;
 }
 if(argc==2&&strncmp(argv[1],"--gpu-",6)==0){
