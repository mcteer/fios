/* SOURCE_FUNCTIONS */
int main(int argc,char **argv){
 ds4_engine e={0}; int context=7,slab=11;
 if(argc==2&&strcmp(argv[1],"--empty")==0){
  ds4_engine_tp_unbind(NULL);ds4_engine_close(NULL);
  if(!ds4_engine_close_checked(NULL)){fputs("PUBLIC_NULL_CLOSE_REFUSED\n",stderr);return 77;}
  ds4_engine_tp_unbind(&e);
