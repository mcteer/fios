   fputs("FIO_DS4_PARENT_IGNORED_RELEASE_PREPARATION_REFUSAL\n",stderr);return 77;
  }
  puts("PASS: parent function source preserves mock resources after local release preparation refusal.");return 0;
 }
 if(argc==2&&strncmp(argv[1],"--cpu-",6)==0){
  cpu_result=0;checked_result=1;
  const int empty=strcmp(argv[1],"--cpu-empty")==0;
  if(!empty){e.tp.ctx=&context;e.tp.slab=&slab;g_tp_block_ctx=&context;}
  const ds4_engine before=e;ds4_engine_close(&e);
