+/* Checked local destruction only, never a native completion/admission proof. */
+bool msv_ane_model_try_free(msv_ane_model *handle) {
+#ifndef FIOS_ANE_SOURCE
+    fios_ane_model_free_legacy(handle);return true;
+#else
+    if (!handle) return true;
+    pthread_mutex_lock(&fios_ane_mutex);
+    if (msv_ane_source_uncertainty() || handle->fios_active || handle->fios_close_attempted) {
+        handle->fios_close_attempted=true;fios_ane_fence(FIOS_ANE_PARENT);
+        pthread_mutex_unlock(&fios_ane_mutex);return false;
+    }
+    handle->fios_close_attempted=true;
+    pthread_mutex_unlock(&fios_ane_mutex);
+    @autoreleasepool {
+        if (msv_ane_source_uncertainty()) return false;
+        if (handle->model) {
+            id model=(__bridge id)handle->model;
+            NSError *failure=nil;
+            if (!bridge_unload(model,&failure)) { fios_ane_fence(FIOS_ANE_UNLOAD);return false; }
+        }
+        if (msv_ane_source_uncertainty()) return false;
+        if (handle->model) { id value=(__bridge_transfer id)handle->model;handle->model=NULL;(void)value; }
+        if (handle->requests) { id value=(__bridge_transfer id)handle->requests;handle->requests=NULL;(void)value; }
+        if (handle->options) { id value=(__bridge_transfer id)handle->options;handle->options=NULL;(void)value; }
+        if (handle->staging_directory) {
+            [[NSFileManager defaultManager] removeItemAtPath:@(handle->staging_directory) error:nil];
+            free(handle->staging_directory);handle->staging_directory=NULL;
+        }
+    }
+    free(handle);return true;
+#endif
+}
+void msv_ane_model_free(msv_ane_model *handle) { (void)msv_ane_model_try_free(handle); }
