+test "fios current media unload retains callback custody and accounting" {
+    const a = std.heap.page_allocator;
+    const io = std.testing.io;
+    const owners = @import("../../../fios/request_ownership.zig");
+    const media_mod = @import("../../../host/media_jobs/plugin/engine.zig");
+    owners.shared().primary_guard = false;
+    try owners.shared().initialize(io, @splat(157));
+    const registry = try model_registry_mod.ModelRegistry.init(a, io, null, 2, 0, null);
+    const model = try registry.registerStub("fixture/media-unload-refusal", "/fixture/never-loaded", null);
+    const root = try owners.shared().enter(io);
+    try owners.shared().bind(io, root, model.id);
+    owners.current().* = root;
+    const original = try a.create(owners.Retained);
+    original.* = (try owners.retainCurrent(io)).?;
+    owners.current().* = null;
+    const Probe = struct {
+        io: std.Io,
+        calls: usize = 0,
+        fn unload(raw: *anyopaque) callconv(.c) void {
+            const self: *@This() = @ptrCast(@alignCast(raw));
+            self.calls += 1;
+            owners.shared().fence(self.io);
+        }
+    };
+    const probe = try a.create(Probe);
+    probe.* = .{ .io = io };
+    const media_table = try a.create(media_mod.MediaTable);
+    media_table.* = undefined;
+    media_table.unload = Probe.unload;
+    const temp = try a.create(std.testing.TmpDir);
+    temp.* = std.testing.tmpDir(.{});
+    const dir = try temp.dir.openDir(io, ".", .{});
+    const engine = try a.create(media_mod.Engine);
+    engine.* = .{ .allocator = a, .io = io, .table = media_table, .handle = probe, .dir = dir, .fs = .{ .io = io, .root = dir }, .pack = undefined };
+    model.media_plugin = engine;
+    model.state = .evicting;
+    // Synthetic local accounting only: no weights, model or native context.
+    model.bytes_resident = 128;
+    registry.current_resident_bytes = 128;
+    const scheduler = try a.create(Scheduler);
+    scheduler.* = std.mem.zeroInit(Scheduler, .{ .allocator = a, .io = io, .registry = registry });
+    const request = try a.create(UnloadRequest);
+    request.* = .{ .entry = model, .fios_origins = original };
+    runUnloadRequest(scheduler, request);
+    try std.testing.expect(request.done);
+    try std.testing.expectEqual(@as(usize, 1), probe.calls);
+    if (model.media_plugin != engine) std.debug.print("FIO_CURRENT_MEDIA_UNLOAD_DROPPED_CALLBACK_CUSTODY\n", .{});
+    try std.testing.expect(request.fios_failed and model.state == .evicting);
+    try std.testing.expect(model.media_plugin == engine);
+    _ = try engine.dir.stat(io);
+    try std.testing.expectEqual(@as(u64, 128), model.bytes_resident);
+    try std.testing.expectEqual(@as(u64, 128), registry.current_resident_bytes);
+    try std.testing.expect(owners.current().* == null and owners.current_group().* == null);
+    try std.testing.expect(owners.shared().knownUncertain(io));
+    try std.testing.expect(!original.releaseIfCertain(io));
+    // Retain the entire private diagnostic graph; no uncertainty reset.
+}
