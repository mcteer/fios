+    pub fn attachPreparationIngress(self: *Tracker, io: std.Io, claim: Token, ingress: Token, model: []const u8, id: CorrelationID) !void {
+        self.observeBackendUncertainty(io);
+        return self.attachPreparationIngressKnown(io, claim, ingress, model, id);
+    }
+    // Outer registry locks require the fixed negative probe to run first.
+    // This edge performs no callback or allocation while holding the tracker.
+    pub fn attachPreparationIngressKnown(self: *Tracker, io: std.Io, claim: Token, ingress: Token, model: []const u8, id: CorrelationID) !void {
+        self.mutex.lockUncancelable(io);
+        defer self.mutex.unlock(io);
+        if (!self.primary_guard) return error.UnsupportedSourceGuard;
+        if (!self.initialized or self.uncertain) return error.CoverageUncertain;
+        if (self.pause_id != null) return error.AdmissionsPaused;
+        if (model.len == 0 or model.len > model_limit or !std.unicode.utf8ValidateSlice(model) or std.mem.indexOfScalar(u8, model, 0) != null) return error.InvalidModel;
+        if (claim.slot == ingress.slot) return error.InvalidClaimIngress;
+        const reserved = try self.checked(claim);
+        const incoming = try self.checked(ingress);
+        if (reserved.preparation_claim == .attached) return error.PreparationClaimUsed;
+        if (reserved.preparation_claim != .reserved or reserved.phase != .preparing or reserved.correlation_root != claim.sequence) return error.InvalidPreparationClaim;
+        if (reserved.references != 1 or incoming.references != 1) return error.PreparationClaimBusy;
+        if (incoming.phase != .ingress or incoming.primary != null or incoming.models != 0 or incoming.correlation != null or incoming.correlation_root != 0 or incoming.preparation_claim != .none) return error.InvalidClaimIngress;
+        const correlation = reserved.correlation orelse return error.InvalidPreparationClaim;
+        if (!std.mem.eql(u8, &correlation, &id)) return error.ClaimCorrelationMismatch;
+        const primary = reserved.primary orelse return error.InvalidPreparationClaim;
+        const bit = @as(u64, 1) << primary;
+        if (reserved.models != bit) return error.InvalidPreparationClaim;
+        const identity = &self.models[primary];
+        if (!std.mem.eql(u8, identity.id[0..identity.len], model)) return error.ClaimModelMismatch;
+        if (self.transitioningLocked(model)) return error.ModelTransition;
+        // Forked/retained preparation keeps its existing ownership; it is not
+        // an unpublished metadata-only claim available for this handoff.
+        for (self.slots, 0..) |slot, index| {
+            if (index != claim.slot and slot.phase != .vacant and slot.correlation_root == claim.sequence) return error.PreparationClaimBusy;
+        }
+        if (identity.owners == 0 or identity.owners >= capacity) {
+            self.uncertain = true;
+            return error.InvalidModelOwnership;
+        }
+        // No fallible operation after the first mutation. Both original native
+        // tokens survive; caller may retire only its own claim reference.
+        identity.owners += 1;
+        incoming.primary = primary;
+        incoming.models = bit;
+        incoming.phase = .preparing;
+        incoming.correlation = correlation;
+        incoming.correlation_root = reserved.correlation_root;
+        reserved.preparation_claim = .attached;
     }
