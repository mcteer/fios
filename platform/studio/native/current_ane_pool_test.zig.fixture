
// Existing model-free bridge only; no ANE compiler, program or device call.
const FiosAnePoolProbe = struct {
    pub const P = FakeLm.P;
    pub const Engine = FakeLm.Engine;
    pub const Sampling = FakeLm.Sampling;
    pub const archOf = FakeLm.archOf;
    pub const loadBytes = FakeLm.loadBytes;
    pub const Pool = struct {
        model: *FakeLm.Model,
        engines: []*Engine,
        var opens: usize = 0;
        var closes: usize = 0;
        pub fn open(a: std.mem.Allocator, i: std.Io, dir: []const u8, arch: FakeLm.Arch, opts: lm.Options, cache: ?lm.CacheLimits) !@This() {
            opens += 1;
            const pool = try FakeLm.Pool.open(a, i, dir, arch, opts, cache);
            @import("../../fios/request_ownership.zig").shared().fence(i);
            return .{ .model = pool.model, .engines = pool.engines };
        }
        pub fn close(pool: @This(), a: std.mem.Allocator) void {
            closes += 1;
            (FakeLm.Pool{ .model = pool.model, .engines = pool.engines }).close(a);
        }
        pub fn stateBytes(pool: @This()) u64 { return pool.engines.len << 10; }
    };
};
fn fiosAnePoolPublication(preexisting: bool) !void {
    const owners = @import("../../fios/request_ownership.zig");
    try owners.shared().initialize(testing.io, @splat(252));
    if (preexisting) owners.shared().fence(testing.io);
    var tmp = testing.tmpDir(.{});
    defer tmp.cleanup();
    var path_buf: [std.fs.max_path_bytes]u8 = undefined;
    const path = try qwen3Pack(&tmp, &path_buf);
    const host: abi.Host = .{ .ctx = undefined, .log = struct {
        fn f(_: *anyopaque, _: u8, _: abi.Str) callconv(.c) void {}
    }.f, .wake = struct { fn f(_: *anyopaque) callconv(.c) void {} }.f };
    const open: abi.Open = .{ .model_dir = abi.span(u8, path), .model_type = .{}, .config_json = .{},
        .context = 0, .max_concurrent = 1, .memory_budget = 0, .settings_json = .{}, .options_json = .{}, .host = &host };
    var info: abi.Info = undefined;
    var verdict: abi.Verdict = .{};
    // The isolated process retains only synthetic metadata on refusal.
    const probe_table = Adapter(FiosAnePoolProbe, std.heap.smp_allocator).table;
    const engine = probe_table.open(&open, &info, &verdict);
    if (engine != null) std.debug.print("FIO_CURRENT_ANE_POOL_PUBLISHED_UNCERTAINTY\n", .{});
    try testing.expect(engine == null);
    try testing.expectEqual(abi.Verdict.Code.failed, verdict.code);
    try testing.expectEqualStrings("NativeCleanupUncertain", abi.items(u8, verdict.why));
    try testing.expectEqual(@as(usize, if (preexisting) 0 else 1), FiosAnePoolProbe.Pool.opens);
    try testing.expectEqual(@as(usize, 0), FiosAnePoolProbe.Pool.closes);
    try testing.expect(owners.shared().knownUncertain(testing.io));
    // A repeated open cannot replay either constructor or cleanup.
    try testing.expect(probe_table.open(&open, &info, &verdict) == null);
    try testing.expectEqual(@as(usize, if (preexisting) 0 else 1), FiosAnePoolProbe.Pool.opens);
    try testing.expectEqual(@as(usize, 0), FiosAnePoolProbe.Pool.closes);
}
test "fios current ane pool refuses known uncertainty before construction" {
    try fiosAnePoolPublication(true);
}
test "fios current ane pool retains constructor uncertainty without publication" {
    try fiosAnePoolPublication(false);
}
