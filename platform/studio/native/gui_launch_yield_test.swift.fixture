import Foundation
import Darwin
var migrations=0
struct ServerOptions {let port:UInt16;let host:String}
enum GenerationDefaultsFile {static func migrate(_ options:ServerOptions)throws {migrations+=1}}
enum Status {case stopped,starting,error(String)}
final class API {var host=""}
enum Probe {static var image:String?=FiosGUILaunchPolicy.installedImage;static var presence:FiosGUILaunchPolicy.Presence = .absent;static var lookups=0}
final class Holder {var port:UInt16=0;let api=API();var status:Status = .stopped;var lastError="";var listeners:[pid_t]=[];var logClears=0
func clearServerLog(){logClears+=1}
func pidsListening(on port:UInt16)->[pid_t]{listeners}
func invoke(){launch(args:[],options:ServerOptions(port:11234,host:"127.0.0.1"))}
@@BODY@@}
let holder=Holder(),mode=CommandLine.arguments[1]
if mode=="managed" {Probe.presence = .present}
if mode=="unavailable" {Probe.presence = .unavailable}
if mode=="unverified" {Probe.image=nil}
if mode=="development" {Probe.image="/private/tmp/MLXCore";Probe.presence = .present}
if mode=="occupied" {holder.listeners=[99999991]}
holder.invoke()
func fail(_ label:String)->Never {print(label);exit(77)}
if ["managed","unavailable","unverified"].contains(mode) {
 guard migrations==0,holder.logClears==0,holder.port==0 else {fail("GUI_FIOS_POLICY_CHANGED_LAUNCH_STATE")}
 guard case .error(let message)=holder.status,!message.isEmpty else {fail("GUI_FIOS_POLICY_DID_NOT_REFUSE")}
} else if mode=="occupied" {
 guard migrations==0,holder.logClears==0 else {fail("GUI_FIOS_OCCUPIED_REGRESSION")}
 guard case .error=holder.status else {fail("GUI_FIOS_OCCUPIED_NOT_REFUSED")}
} else {
 guard case .starting=holder.status,migrations==1,holder.port==11234,holder.api.host=="127.0.0.1" else {fail("GUI_FIOS_ORDINARY_START_REGRESSION")}
 if mode=="development" && Probe.lookups != 0 {fail("GUI_FIOS_DEVELOPMENT_READ_INSTALLED_POLICY")}
}
print("PASS: actual GUI launch prefix and denial-only policy decision; modeled OS/default ports")
