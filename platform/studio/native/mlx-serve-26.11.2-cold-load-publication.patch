+test "fios current cold claim sequence exhaustion fences without wrapping" {
+    const io = std.testing.io;
+    fios_ownership.shared().primary_guard = false;
+    try fios_ownership.shared().initialize(io, @splat(249));
+    const registry = try model_registry_mod.ModelRegistry.init(std.heap.page_allocator, io, null, 1, 0, null);
