+
+fn captureFiosLoadPlanLocked(self: *Scheduler, entry: *LoadedModel, victims: []const *LoadedModel) !FiosLoadPlan {
+    if (!entry.fios_owner_guard) return .{};
+    if (entry.state != .loading or entry.fios_load_claim_sequence == 0 or victims.len > 16) {
+        fios_ownership.shared().fence(self.io);
+        return error.NativeCleanupUncertain;
+    }
+    var plan: FiosLoadPlan = .{ .claim_sequence = entry.fios_load_claim_sequence };
+    for (victims, 0..) |victim, index| {
+        if (!victim.fios_owner_guard or victim.state != .evicting or victim.fios_model_mutation == null) {
+            fios_ownership.shared().fence(self.io);
+            return error.NativeCleanupUncertain;
+        }
+        plan.victim_mutations[index] = victim.fios_model_mutation;
+    }
+    return plan;
+}
+
+fn rollbackUnpublishedLoad(self: *Scheduler, req: *LoadRequest) void {
+    const claim = req.fios_plan.claim_sequence orelse return;
+    if (req.evict_entries.len > req.fios_plan.victim_mutations.len) {
+        fios_ownership.shared().fence(self.io);
+        return;
+    }
+    self.registry.mutex.lockUncancelable(self.io);
+    defer self.registry.mutex.unlock(self.io);
+    for (req.evict_entries, 0..) |victim, index| {
+        const original = req.fios_plan.victim_mutations[index] orelse continue;
+        if (victim.fios_model_mutation) |current| {
+            if (victim.state == .evicting and std.meta.eql(original, current)) self.registry.unmarkEvictingLocked(victim);
+        }
+    }
+    // A later claim, independent uncertainty or attempted backend work is
+    // never reset by this original sender's publication failure.
+    if (req.entry.fios_owner_guard and req.entry.state == .loading and req.entry.fios_load_claim_sequence == claim)
+        self.registry.markUnloadedLocked(req.entry);
+}
