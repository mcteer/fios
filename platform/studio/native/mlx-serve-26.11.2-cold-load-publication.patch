+    entry.fios_owner_guard = true;
+    entry.fios_load_claim_sequence = std.math.maxInt(u64);
+    registry.mutex.lockUncancelable(io);
+    const claimed = registry.tryBeginLoadLocked(entry);
+    registry.mutex.unlock(io);
+    try std.testing.expect(!claimed and entry.state == .unloaded);
+    try std.testing.expectEqual(std.math.maxInt(u64), entry.fios_load_claim_sequence);
