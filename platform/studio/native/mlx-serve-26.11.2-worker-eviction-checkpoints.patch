+// Called only under registry.mutex. No callbacks, native effects or completion proof.
+fn originalLoadingClaimLocked(req: *const LoadRequest) bool {
+    if (!req.entry.fios_owner_guard) return true;
+    const original = req.fios_plan.claim_sequence orelse return true;
+    return req.entry.fios_owner_guard and req.entry.state == .loading and
+        req.entry.fios_load_claim_sequence == original and !req.entry.fios_load_uncertain.load(.acquire);
+}
+
+fn captureEvictionMutationsLocked(sch: *Scheduler, victims: []const *LoadedModel) ![16]?fios_owners.ModelMutation {
+    if (victims.len > 16) {
+        fios_owners.shared().fence(sch.io);
+        return error.NativeCleanupUncertain;
+    }
+    var originals: [16]?fios_owners.ModelMutation = @splat(null);
+    for (victims, 0..) |victim, index| {
+        if (!victim.fios_owner_guard) continue;
+        if (victim.state != .evicting or victim.fios_model_mutation == null) {
+            fios_owners.shared().fence(sch.io);
+            return error.NativeCleanupUncertain;
+        }
+        originals[index] = victim.fios_model_mutation;
+    }
+    return originals;
+}
+
+fn releaseUntouchedVictimsLocked(sch: *Scheduler, victims: []const *LoadedModel, originals: *const [16]?fios_owners.ModelMutation, attempted: u16) void {
+    if (victims.len > 16) {
+        fios_owners.shared().fence(sch.io);
+        return;
+    }
+    for (victims, 0..) |victim, index| {
+        if ((attempted & (@as(u16, 1) << @intCast(index))) != 0) continue;
+        const original = originals[index] orelse continue;
+        if (victim.fios_model_mutation) |current| {
+            if (victim.state == .evicting and std.meta.eql(original, current)) sch.registry.unmarkEvictingLocked(victim);
+        }
+    }
+}
