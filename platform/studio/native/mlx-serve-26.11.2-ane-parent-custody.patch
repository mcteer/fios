+//! Fixed negative-only raw ANE custody plus previous reported-run/SDK probes.
+//! A zero bitmask is no device-terminal, all-client or admission authority.
+const base = @import("current_ane_backend_uncertainty.zig");
+pub fn known(comptime sdk_enabled: bool, comptime llama_enabled: bool) bool {
+    const options = @import("build_options");
+    const Source = struct { extern "c" fn msv_ane_source_uncertainty() u32; };
+    const raw = if (@hasDecl(options, "fios_source_ane") and options.fios_source_ane)
+        Source.msv_ane_source_uncertainty() != 0 else false;
+    return raw or base.known(sdk_enabled, llama_enabled);
+}
diff --git a/src/fios/current_ane_native_cleanup_uncertainty.zig b/src/fios/current_ane_native_cleanup_uncertainty.zig
new file mode 100644
index 0000000..b360859
--- /dev/null
+++ b/src/fios/current_ane_native_cleanup_uncertainty.zig
@@ -0,0 +1,19 @@
+//! Negative cleanup evidence only; no native completion or admission authority.
+const std = @import("std");
+const owners = @import("request_ownership.zig");
+const backend = @import("current_ane_native_backend_uncertainty.zig");
+
+pub fn known(io: std.Io, comptime sdk_enabled: bool, comptime llama_enabled: bool) bool {
+    const native_unknown = backend.known(sdk_enabled, llama_enabled);
+    const source = owners.shared();
+    source.mutex.lockUncancelable(io);
+    const started = source.initialized;
+    source.mutex.unlock(io);
+    if (native_unknown) {
+        if (started) source.fence(io);
+        return true;
+    }
+    // Legacy metadata-only callers can precede source startup. Missing startup
+    // is never positive native authority, and cannot hide an actual fence.
+    return started and source.backendKnownUncertain(io);
+}
