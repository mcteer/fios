// Actual source SDK buffer completion and actual native ownership. No model
// or global device/quiescence/authority claim follows from these local roots.
const std = @import("std");
const owners = @import("request_ownership.zig");
const sdk = @import("sdk_request_ownership.zig");
extern "c" fn getenv(name: [*:0]const u8) ?[*:0]const u8;
extern fn fios_metal_owner_fixture_start() c_int;
extern fn fios_metal_owner_fixture_release_gpu() void;
extern fn fios_metal_owner_fixture_wait_child() c_int;
extern fn fios_metal_owner_fixture_child_owner() c_int;
extern fn fios_metal_owner_fixture_cleanup() c_int;
test "fios genuine SDK Metal callbacks retain originating native owners" {
    const io = std.testing.io;
    try owners.shared.initialize(io, @splat(7));
    try sdk.initialize(io);
    const original = try owners.shared.enter(io);
    try owners.shared.bind(io, original, "fixture/metal-origin");
    try owners.shared.active(io, original);
    const second = try owners.shared.enter(io);
    try owners.shared.bind(io, second, "fixture/metal-origin");
    try owners.shared.active(io, second);
    const group = [_]owners.Token{original, second};
    owners.current = original;
    owners.current_group = &group;
    var original_held = true;
    defer if (original_held) {
        owners.shared.leave(io, original) catch {};
        owners.shared.leave(io, second) catch {};
    };
    defer {owners.current = null;owners.current_group = null;}
    try std.testing.expectEqual(@as(c_int, 1), fios_metal_owner_fixture_start());
    var cleaned = false;
    defer {if (!cleaned) {_ = fios_metal_owner_fixture_cleanup();}}
    owners.current = null;
    owners.current_group = null;
    try owners.shared.leave(io, original);
    try owners.shared.leave(io, second);
    original_held = false;
    std.debug.print("genuine_metal_wait native_contexts={d} retained_roots={d}\n", .{ sdk.diagnostic().active_contexts, owners.shared.snapshot(io).owned });
    try std.testing.expect(owners.shared.hasRetainedWork(io));
    try std.testing.expectEqual(@as(usize, 2), owners.shared.snapshot(io).owned);
    fios_metal_owner_fixture_release_gpu();
    try std.testing.expectEqual(@as(c_int, 1), fios_metal_owner_fixture_wait_child());
    try std.testing.expectEqual(@as(c_int, 1), fios_metal_owner_fixture_child_owner());
    try std.testing.expect(owners.shared.hasRetainedWork(io));
    const scenario = std.mem.span(getenv("FIOS_FIXTURE_SOURCE_FENCE") orelse return error.MissingFixtureScenario);
    const fenced = std.mem.eql(u8, scenario, "cached");
    try std.testing.expect(fenced or std.mem.eql(u8, scenario, "healthy"));
    if (fenced) owners.shared.fence(io);
    try std.testing.expectEqual(@as(c_int, 1), fios_metal_owner_fixture_cleanup());
    cleaned = true;
    try std.testing.expectEqual(fenced, sdk.diagnostic().active_contexts > 0);
    try std.testing.expectEqual(fenced, sdk.diagnostic().uncertain);
    try std.testing.expectEqual(fenced, owners.shared.hasRetainedWork(io));
    try std.testing.expectEqual(fenced, owners.shared.snapshot(io).uncertain);
    try std.testing.expectEqual(@as(usize, if (fenced) 2 else 0), owners.shared.snapshot(io).owned);
    std.debug.print("genuine_cleanup scenario={s} contexts={d} roots={d}\n", .{scenario, sdk.diagnostic().active_contexts, owners.shared.snapshot(io).owned});
    std.debug.print("PASS: genuine SDK Metal completion and captured-resource cleanup retain native owners through destructor-enqueued CPU work; no terminal authority\n", .{});
}
