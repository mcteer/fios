const std = @import("std");
const scenario = @import("build_options").scenario;
var uncertain = scenario == 1;
var enumerated: usize = 0;
var drained: usize = 0;
var persisted: usize = 0;
const model_registry_mod = struct { fn cleanupUncertain(_: std.Io) bool { return uncertain; } };
const Scheduler = struct { io: std.Io, shutdown_deadline_ms: std.atomic.Value(i64) = .init(if (scenario == 4) 0 else 1000) };
fn drainSideQueues(_: *Scheduler) bool { drained += 1; if (scenario == 2) uncertain = true; return false; }
fn diskCaches(_: *Scheduler, _: []prefix_cache_mod.FlushTarget, _: bool) usize { enumerated += 1; if (scenario == 3) uncertain = true; return 1; }
const prefix_cache_mod = struct {
    const FlushTarget = struct {};
    const Totals = struct { written: usize = 0, bytes: usize = 0, left_deadline: usize = 0, left_declined: usize = 0, checked_out: usize = 0, failures: usize = 0, dropped_bytes: usize = 0 };
    fn shutdownPersist(_: []const FlushTarget, _: io_util.MonotonicClock, _: i64) Totals { persisted += 1; return .{}; }
};
const io_util = struct {
    const MonotonicClock = struct { io: std.Io };
    const Stopwatch = struct { fn init(_: std.Io) @This() { return .{}; } fn read(_: @This()) u64 { return 0; } };
};
const log = struct { fn info(comptime _: []const u8, _: anytype) void {} };
// ACTUAL_PERSIST
pub fn main(init: std.process.Init) !void {
    var sch: Scheduler = .{ .io = init.io };
    persistAtShutdown(&sch);
    const expected_drain: usize = if (scenario == 1 or scenario == 4) 0 else 1;
    const expected_enumeration: usize = if (scenario == 0 or scenario == 3) 1 else 0;
    const expected_persist: usize = if (scenario == 0) 1 else 0;
    if (drained != expected_drain or enumerated != expected_enumeration or persisted != expected_persist) {
        std.debug.print("FIO_SHUTDOWN_PERSIST_DURING_UNCERTAINTY\n", .{});
        return error.UncertainPersist;
    }
    if (scenario >= 1 and scenario <= 3 and !uncertain) return error.ClearedUncertainty;
    std.debug.print("PASS: actual shutdown persistence respects negative evidence and deadline; CPU substitutes only\n", .{});
}
