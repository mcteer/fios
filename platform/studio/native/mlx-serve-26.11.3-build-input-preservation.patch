diff --git a/scripts/build-mlx.sh b/scripts/build-mlx.sh
--- a/scripts/build-mlx.sh
+++ b/scripts/build-mlx.sh
@@ -47,19 +47,20 @@
   PATCH_DIRS+=("$REPO_ROOT/$dir")
   PATCH_FILES+=("$REPO_ROOT/$patch")
 done < "$SCRIPT_DIR/build-mlx-patches.txt"
-# An empty list hashes nothing: unguarded, bash 3.2 dies on the unset array and a newer one leaves `cat` on stdin.
-PATCH_SHA="$(cat /dev/null ${PATCH_FILES[@]+"${PATCH_FILES[@]}"} | shasum | cut -c1-12)"
+# This reviewed development path supports only the pinned upstream overlay.
+# Refuse list drift before applying anything or invoking the compiler.
+[ "${#PATCH_FILES[@]}" -eq 1 ] && [ "${PATCH_DIRS[0]}" = "$MLXC_SRC" ] \
+  && [ "${PATCH_FILES[0]}" = "$REPO_ROOT/patches/mlxc-gather-qmm-global-scale.patch" ] \
+  || die "unreviewed dependency patch list"
+PATCH_SHA="$(shasum "${PATCH_FILES[0]}" | cut -c1-12)"
 WANT="mlx=$MLX_SHA mlxc=$MLXC_SHA patch=$PATCH_SHA target=$DEPLOYMENT_TARGET"
-
-# Idempotent: skip when the staged build already matches the pinned SHAs.
-if [ -f "$STAMP" ] && [ -f "$STAGE/lib/libmlx.dylib" ] \
-   && [ -f "$STAGE/lib/libmlxc.dylib" ] && [ -f "$STAGE/lib/mlx.metallib" ]; then
-  if [ "$(cat "$STAMP")" = "$WANT" ]; then
-    echo "[build-mlx] lib/mlx already at ($WANT) — nothing to do"
-    exit 0
-  fi
-  echo "[build-mlx] staged '$(cat "$STAMP")' != '$WANT' — rebuilding"
+MLXC_APPLY=false
+if git -C "$MLXC_SRC" apply --check -p1 "${PATCH_FILES[0]}"; then
+  MLXC_APPLY=true
+elif ! git -C "$MLXC_SRC" apply --reverse --check -p1 "${PATCH_FILES[0]}"; then
+  die "mlx-c patch conflicts with source inputs; no files were reset"
 fi
+# A stamp omitting source overlays and toolchain identity is diagnostic only.
 
 # ── Toolchain preflight: every one of these failing would otherwise surface
 # as a silently NAX-less metallib, not an error. ──────────────────────────────
@@ -74,15 +75,12 @@
 fi
 echo "[build-mlx] SDK $SDK_VERSION, deployment target $DEPLOYMENT_TARGET, $WANT"
 
-NCPU="$(sysctl -n hw.ncpu)"
+NCPU="${MLX_BUILD_JOBS:-2}"
+case "$NCPU" in 1|2) ;; *) die "MLX_BUILD_JOBS must be 1 or 2" ;; esac
 
-# The files a patch touches are reset first, so an edited patch replaces the old one; local edits anywhere else in the
-# submodule are kept.
-for i in ${PATCH_FILES[@]+"${!PATCH_FILES[@]}"}; do
-  src="${PATCH_DIRS[$i]}" patch="${PATCH_FILES[$i]}"
-  git -C "$src" checkout -- $(git -C "$src" apply --numstat -p1 "$patch" | cut -f3)
-  git -C "$src" apply -p1 "$patch"
-done
+if [ "$MLXC_APPLY" = true ]; then
+  git -C "$MLXC_SRC" apply -p1 "${PATCH_FILES[0]}"
+fi
 
 # ── mlx (C++ core + metallib) ────────────────────────────────────────────────
 cmake -S "$MLX_SRC" -B "$BUILD_ROOT/mlx" \
