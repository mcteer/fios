index 0000000..4aecbc2
--- /dev/null
+++ b/src/fios/current_registry_activity.zig
@@ -0,0 +1,78 @@
+//! Coupled readonly registry/request facts. No sampled GPU, idle, reservation
+//! or all-client authority; ready_declared describes only the registry enum.
+const std = @import("std");
+const owners = @import("request_ownership.zig");
+pub const scan_limit = 4096;
+pub const Row = struct {
+    id: [owners.model_limit]u8 = @splat(0),
+    len: usize = 0,
+    ready_declared: bool = false,
+    transitioning: bool = false,
+    uncertain: bool = false,
+    preparing: usize = 0,
+    queued: usize = 0,
+    active: usize = 0,
+    responding: usize = 0,
+};
+pub const Observation = struct {
+    instance: [16]u8,
+    sample_sequence: u64,
+    registry_generation: u64,
+    uncertain: bool,
+    transitioning: bool = false,
+    owned: usize,
+    ingress: usize,
+    preparing: usize,
+    queued: usize,
+    active: usize,
+    responding: usize,
+    model_count: usize = 0,
+    models: [owners.model_capacity]Row = @splat(.{}),
+};
+// Registry→tracker is the existing transition lock order. Try both locks;
+// contention yields unavailable, never stale/empty fallback or waiting on work.
+pub fn captureKnown(io: std.Io, tracker: *owners.Tracker, registry: anytype) !Observation {
+    if (!registry.mutex.tryLock()) return error.RegistryBusy;
+    defer registry.mutex.unlock(io);
+    if (registry.entries.count() > scan_limit) return error.RegistryScanLimit;
+    const generation = registry.generation.load(.acquire);
+    if (generation > owners.maximum_sample_sequence) return error.RegistryGenerationLimit;
+    const snapshot = tracker.tryQueuedSnapshotKnown(io) orelse return error.TrackerBusy;
+    if (!snapshot.initialized or snapshot.owned != snapshot.ingress + snapshot.preparing + snapshot.queued + snapshot.active + snapshot.responding)
+        return error.IncoherentOwnership;
+    var result: Observation = .{ .instance = snapshot.instance, .sample_sequence = snapshot.sample_sequence,
+        .registry_generation = generation, .uncertain = snapshot.uncertain, .owned = snapshot.owned,
+        .ingress = snapshot.ingress, .preparing = snapshot.preparing, .queued = snapshot.queued,
+        .active = snapshot.active, .responding = snapshot.responding };
+    for (snapshot.models[0..snapshot.model_count]) |model| {
+        const id = model.id[0..model.len];
+        const registered = registry.entries.get(id) orelse return error.MissingRegistryIdentity;
+        if (!std.mem.eql(u8, registered.id, id)) return error.MissingRegistryIdentity;
+        const row = try add(&result, id);
+        row.preparing = model.preparing;row.queued = model.queued;row.active = model.active;row.responding = model.responding;
+    }
+    var iterator = registry.entries.iterator();
+    while (iterator.next()) |entry| {
+        const model = entry.value_ptr.*;
+        const uncertain = model.fios_load_uncertain.load(.acquire);
+        const transitioning = model.state == .loading or model.state == .evicting;
+        if (model.state != .ready and !transitioning and !uncertain and find(&result, model.id) == null) continue;
+        const row = try add(&result, model.id);
+        row.ready_declared = model.state == .ready;row.transitioning = transitioning;row.uncertain = uncertain;
+        result.transitioning = result.transitioning or transitioning;
+        result.uncertain = result.uncertain or uncertain;
+    }
+    if (registry.generation.load(.acquire) != generation) return error.RegistryChanged;
+    return result;
+}
+fn find(result: *Observation, id: []const u8) ?*Row {
+    for (result.models[0..result.model_count]) |*row| if (std.mem.eql(u8, row.id[0..row.len], id)) return row;
+    return null;
+}
+fn add(result: *Observation, id: []const u8) !*Row {
+    if (id.len == 0 or id.len > owners.model_limit or !std.unicode.utf8ValidateSlice(id) or std.mem.indexOfScalar(u8,id,0) != null) return error.InvalidRegistryIdentity;
+    if (find(result,id)) |row| return row;
+    if (result.model_count == owners.model_capacity) return error.RegistryModelLimit;
+    const row = &result.models[result.model_count];row.* = .{};row.len = id.len;@memcpy(row.id[0..id.len],id);result.model_count += 1;
+    return row;
+}
