+test "fios mimo retirement: drain preserves failure and still retires every queued chunk" {
+    const Backend = struct {
+        pub const Chunk = u64;
+        calls: u32 = 0,
+        fail_mask: u8 = 0,
+        pub fn retire(self: *@This(), chunk: Chunk) !u64 {
+            self.calls += 1;
+            if ((chunk == 1 and self.fail_mask & 1 != 0) or
+                (chunk == 2 and self.fail_mask & 2 != 0)) return error.FiosRetirementFailure;
+            return 0;
+        }
+    };
+    for ([_]u8{ 0, 1, 2, 3 }) |mask| {
+        for ([_]usize{ 0, 1 }) |head| {
+            var engine: Engine(Backend) = .{ .a = std.testing.allocator, .backend = .{ .fail_mask = mask }, .params = .{}, .iters = initial_iters };
+            engine.ring = .{ 1, 2 };
+            engine.ring_iters = .{ initial_iters, initial_iters };
+            engine.ring_head = head;
+            engine.ring_n = 2;
+            engine.n_chunks.store(2, .monotonic);
+            engine.drain();
+            try std.testing.expectEqual(@as(u32, 2), engine.backend.calls);
+            try std.testing.expectEqual(@as(usize, 0), engine.ring_n);
+            try std.testing.expectEqual(mask != 0, engine.stats().failed);
+            try std.testing.expectEqual(@as(u64, 2) - @as(u64, @popCount(mask)), engine.stats().retired);
+            engine.drain();
+            try std.testing.expectEqual(mask != 0, engine.stats().failed);
+            try std.testing.expectEqual(@as(u32, 2), engine.backend.calls);
+        }
+    }
