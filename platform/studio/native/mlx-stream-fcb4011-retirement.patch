+test "fios mimo retirement: explicit fixture pause drains and closes rearm until exact resume" {
+    var event = std.atomic.Value(u64).init(0);
+    var trace: Trace.Log = .{};
+    const engine = try TraceEngine.create(std.testing.allocator, Trace.word(&event, &trace), .{ .fios_fixture_control = true });
+    defer engine.destroy();
+    engine.arm(1);
+    try waitFor(atLeast, .{ &trace, 2 }, 500);
+    const ticket = try engine.fixturePause();
+    try waitFor(fiosRetired, .{ engine, ticket }, 500);
+    const commits = trace.commits.load(.seq_cst);
+    sleepUs(5_000);
+    try testing.expectEqual(commits, trace.commits.load(.seq_cst));
+    var wrong = ticket;
+    wrong.sequence += 1;
+    try testing.expect(!engine.fixtureResume(wrong));
+    const previous_target = engine.target.load(.seq_cst);
+    engine.arm(2);
+    try testing.expectEqual(previous_target, engine.target.load(.seq_cst));
+    try testing.expectEqual(FiosPauseState.unknown, engine.fixturePauseState(ticket));
+    engine.hold(true);
+    try testing.expectEqual(FiosPauseState.unknown, engine.fixturePauseState(ticket));
+    try testing.expectEqual(@as(u32, 0), engine.holds.load(.seq_cst));
+    try testing.expect(engine.fixtureResume(ticket));
+    try testing.expect(!engine.fixtureResume(ticket));
+    try waitFor(atLeast, .{ &trace, commits + 1 }, 500);
+    const next = try engine.fixturePause();
+    try testing.expect(next.sequence != ticket.sequence);
+    try testing.expect(!engine.fixtureResume(ticket));
+    try waitFor(struct {
+        fn acknowledged(e: *const TraceEngine, t: FiosPauseTicket) bool { return e.fixturePauseState(t) == .unknown; }
+    }.acknowledged, .{ engine, next }, 500);
+    try testing.expect(engine.fixtureResume(next));
+}
