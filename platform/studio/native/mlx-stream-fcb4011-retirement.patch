+test "fios mimo retirement: parked chunks require actual retire outcome before pause acknowledgement" {
+    const Backend = struct {
+        pub const Chunk = u64;
+        commits: *std.atomic.Value(u64),
+        retires: *std.atomic.Value(u64),
+        entered: *std.atomic.Value(bool),
+        release: *std.atomic.Value(bool),
+        fail: bool,
+        pub fn commit(self: *@This(), _: u32) !Chunk { return self.commits.fetchAdd(1, .seq_cst) + 1; }
+        pub fn eventValue(self: *const @This()) u64 { return if (self.commits.load(.seq_cst) >= 2) 1 else 0; }
+        pub fn retire(self: *@This(), _: Chunk) !u64 {
+            _ = self.retires.fetchAdd(1, .seq_cst);
+            self.entered.store(true, .seq_cst);
+            while (!self.release.load(.seq_cst)) sleepUs(200);
+            if (self.fail) return error.FiosBlockedRetire;
+            return 0;
+        }
+    };
+    const E = Engine(Backend);
+    for ([_]bool{ false, true }) |failure| {
+        var commits = std.atomic.Value(u64).init(0);
+        var retires = std.atomic.Value(u64).init(0);
+        var entered = std.atomic.Value(bool).init(false);
+        var release = std.atomic.Value(bool).init(false);
+        const engine = try E.create(std.testing.allocator, .{ .commits = &commits, .retires = &retires, .entered = &entered, .release = &release, .fail = failure }, .{ .fios_fixture_control = true });
+        defer { release.store(true, .seq_cst); engine.destroy(); }
+        engine.arm(1);
+        try waitFor(struct {
+            fn parked(e: *const E, count: *const std.atomic.Value(u64)) bool { return e.isParked() and count.load(.seq_cst) == 2; }
+        }.parked, .{ engine, &commits }, 500);
+        try testing.expectEqual(@as(u64, 0), retires.load(.seq_cst));
+        const ticket = try engine.fixturePause();
+        try waitFor(struct {
+            fn blocked(flag: *const std.atomic.Value(bool)) bool { return flag.load(.seq_cst); }
+        }.blocked, .{&entered}, 500);
+        try testing.expectEqual(FiosPauseState.pending, engine.fixturePauseState(ticket));
+        try testing.expect(!engine.fixtureResume(ticket));
+        release.store(true, .seq_cst);
+        const expected: FiosPauseState = if (failure) .unknown else .retired;
+        try waitFor(struct {
+            fn acknowledged(e: *const E, t: FiosPauseTicket, wanted: FiosPauseState) bool { return e.fixturePauseState(t) == wanted; }
+        }.acknowledged, .{ engine, ticket, expected }, 500);
+        try testing.expectEqual(@as(u64, 2), retires.load(.seq_cst));
+        try testing.expect(engine.fixtureResume(ticket));
+    }
+}
