diff --git a/src/fios/instance_header.zig b/src/fios/instance_header.zig
new file mode 100644
index 0000000..f7d0ee5
--- /dev/null
+++ b/src/fios/instance_header.zig
@@ -0,0 +1,29 @@
+const std = @import("std");
+
+// Consistency only: an expected process instance is not a model grant.
+pub fn parse(headers: []const u8) !?[16]u8 {
+    var found: ?[16]u8 = null;
+    var lines = std.mem.splitSequence(u8, headers, "\r\n");
+    while (lines.next()) |line| {
+        const colon = std.mem.indexOfScalar(u8, line, ':') orelse continue;
+        if (!std.ascii.eqlIgnoreCase(line[0..colon], "x-fios-native-instance")) continue;
+        if (found != null) return error.DuplicateNativeInstance;
+        const text = std.mem.trim(u8, line[colon + 1 ..], " \t");
+        if (text.len != 32) return error.InvalidNativeInstance;
+        var instance: [16]u8 = undefined;
+        var nonzero = false;
+        for (&instance, 0..) |*byte, index| {
+            var pair: u8 = 0;
+            for (text[index * 2 ..][0..2]) |character| {
+                const digit: u8 = if (character >= '0' and character <= '9') character - '0'
+                    else if (character >= 'a' and character <= 'f') character - 'a' + 10
+                    else return error.InvalidNativeInstance;
+                pair = (pair << 4) | digit;
+            }
+            byte.* = pair;nonzero = nonzero or pair != 0;
+        }
+        if (!nonzero) return error.InvalidNativeInstance;
+        found = instance;
+    }
+    return found;
+}
