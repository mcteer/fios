diff --git a/src/fios/current_queued_origins.zig b/src/fios/current_queued_origins.zig
index a607733..cde4069 100644
--- a/src/fios/current_queued_origins.zig
+++ b/src/fios/current_queued_origins.zig
@@ -19,5 +19,46 @@ pub fn retain(io: std.Io, requests: anytype) !?Scope {
         views[index] = .{ .fios_owner = request.fios_origins };
         pointers[index] = &views[index];
     }
-    return try slots.retain(io, pointers[0..requests.len]);
+    // Clone/validate the complete union before touching per-request state.
+    // Request fields are touched only before any sender acknowledgement.
+    const scope = try slots.retain(io, pointers[0..requests.len]);
+    for (requests) |request| {
+        if (request.fios_queue_ticket) |ticket| {
+            if (request.fios_queue_started) { owners.shared().fence(io); return error.InvalidQueuedOrigins; }
+            const held = request.fios_origins orelse { owners.shared().fence(io); return error.InvalidQueuedOrigins; };
+            held.tracker.activateQueued(io, ticket) catch { owners.shared().fence(io); return error.InvalidQueuedOrigins; };
+            request.fios_queue_started = true;
+        } else if (request.fios_origins != null) {
+            owners.shared().fence(io);
+            return error.InvalidQueuedOrigins;
+        }
+    }
+    return scope;
+}
+
+// Sender-only: no publication or enclosing queue lock yet. Preserve exact
+// model membership; nested reuse cannot overwrite an earlier operation.
+pub fn capture(io: std.Io, request: anytype, model: []const u8) !?owners.QueueTicket {
+    // A completed latch would let the sender skip its ownership wait. Reject
+    // this unpublished input without changing independent backend certainty.
+    if (request.done) return error.InvalidQueuedOrigins;
+    if (request.fios_queue_ticket != null or request.fios_queue_started) {
+        owners.shared().fence(io);
+        return error.InvalidQueuedOrigins;
+    }
+    const held = request.fios_origins orelse return null;
+    try held.tracker.validatePreparationOrigins(io, held, model);
+    const ticket = try held.tracker.beginQueued(io, held);
+    request.fios_queue_ticket = ticket;
+    return ticket;
+}
+// Sender-only after uncancelable acknowledgement, or unpublished failure.
+// Failed retirement preserves the original independently retained table entry.
+pub fn retire(io: std.Io, request: anytype, ticket: ?owners.QueueTicket) void {
+    if (ticket) |value| {
+        const held = request.fios_origins orelse { owners.shared().fence(io); return; };
+        held.tracker.retireQueued(io, value) catch { held.tracker.fence(io); return; };
+        request.fios_queue_ticket = null;
+        request.fios_queue_started = false;
+    }
 }
