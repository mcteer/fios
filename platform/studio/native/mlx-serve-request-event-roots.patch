 pub const lineage_request_size = 64;
 pub const lineage_response_size = 112;
 pub const Status = enum(u8) { ok, invalid, maintenance, wrong_instance };
+
+pub const request_events_response_size = 160;
+pub const RequestEventSource = *const fn (u64) @import("request_event_roots.zig").Observation;
+pub fn dispatchRequestEvents(tracker: *ownership.Tracker, io: std.Io, request: *const [64]u8, source: ?RequestEventSource) [request_events_response_size]u8 {
+    var response: [request_events_response_size]u8 = @splat(0);
+    @memcpy(response[0..4], "FIV9"); response[4] = 1; response[6] = 2;
+    @memcpy(response[24..56], request[24..56]);
+    const root = std.mem.readInt(u64, request[56..64], .big);
+    std.mem.writeInt(u64, response[56..64], root, .big);
+    if (!std.mem.eql(u8, request[0..4], "FIO9") or request[4] != 1 or
+        !std.mem.allEqual(u8, request[5..8], 0) or root == 0) {
+        response[5] = @intFromEnum(Status.invalid); return response;
+    }
+    const captured_at = std.Io.Clock.real.now(io).toMilliseconds();
+    const lineage = tracker.correlationSnapshot(io, request[24..56].*);
+    @memcpy(response[8..24], &lineage.instance);
+    var sequence = lineage.sample_sequence;
+    var known = lineage.found and lineage.root_sequence == root;
+    var uncertain = lineage.uncertain;
+    if (!lineage.found) {
+        const retired = tracker.retirementSnapshot(io, request[24..56].*, root);
+        sequence = retired.sample_sequence; known = retired.recorded; uncertain = retired.uncertain;
+    }
+    std.mem.writeInt(u64, response[64..72], sequence, .big);
+    const stamp: u64 = if (captured_at > 0 and captured_at <= ownership.maximum_sample_sequence) @intCast(captured_at) else std.math.maxInt(u64);
+    std.mem.writeInt(u64, response[72..80], stamp, .big);
+    if (!std.mem.eql(u8, request[8..24], &lineage.instance) or std.mem.allEqual(u8, &lineage.instance, 0)) {
+        response[5] = @intFromEnum(Status.wrong_instance); return response;
+    }
+    if (!known) return response;
+    response[6] |= 4;
+    const read = source orelse return response;
+    const observed = read(root);
+    if (!observed.initialized) return response;
+    if (!std.mem.eql(u8, &observed.instance, &lineage.instance)) {
+        response[5] = @intFromEnum(Status.wrong_instance); return response;
+    }
+    response[6] |= 1;
+    if (!uncertain and !observed.source_uncertain) response[6] &= ~@as(u8, 2);
+    inline for (.{ observed.host, observed.metal }, .{ @as(usize, 80), @as(usize, 120) }) |value, offset| {
+        if (value) |row| {
+            if (row.root != root) { response[5] = @intFromEnum(Status.invalid); return response; }
+            response[offset] = 1 | (@as(u8, @intFromBool(row.history_retained)) << 1) | (@as(u8, @intFromBool(row.uncertain)) << 2);
+            std.mem.writeInt(u64, response[offset + 8 ..][0..8], row.sequence, .big);
+            std.mem.writeInt(u64, response[offset + 16 ..][0..8], row.originated, .big);
+            std.mem.writeInt(u64, response[offset + 24 ..][0..8], row.retired, .big);
+            std.mem.writeInt(u64, response[offset + 32 ..][0..8], row.pending, .big);
+        }
+    }
+    return response;
+}
