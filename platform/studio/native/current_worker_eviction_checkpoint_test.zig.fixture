
// Published worker refusal controls: CPU-only metadata/fake callbacks, no native model.
test "fios current published load refusal releases untouched victim reservations" {
    const a = std.heap.page_allocator;
    const io = std.testing.io;
    const owners = @import("../../../fios/request_ownership.zig");
    owners.shared().primary_guard = false;
    try owners.shared().initialize(io, @splat(251));
    const registry = try model_registry_mod.ModelRegistry.init(a, io, null, 3, 0, null);
    const entry = try registry.registerStub("fixture/worker-target", "/fixture/no-model", null);
    const first = try registry.registerStub("fixture/worker-first", "/fixture/no-first", null);
    const second = try registry.registerStub("fixture/worker-second", "/fixture/no-second", null);
    entry.fios_owner_guard = true;
    first.fios_owner_guard = true;
    second.fios_owner_guard = true;
    first.state = .ready;
    second.state = .ready;
    var victims = [_]*LoadedModel{ first, second };
    const root = try owners.shared().enter(io);
    try owners.shared().bind(io, root, entry.id);
    owners.current().* = root;
    const original = try a.create(owners.Retained);
    original.* = (try owners.retainCurrent(io)).?;
    owners.current().* = null;
    var scheduler = std.mem.zeroInit(Scheduler, .{ .allocator = a, .io = io, .registry = registry });
    var req = std.mem.zeroInit(LoadRequest, .{ .entry = entry, .config = undefined, .tok = undefined, .chat_config = undefined, .model_dir = entry.path, .evict_entries = &victims, .fios_origins = original, .allocator = a });
    {
        registry.mutex.lockUncancelable(io);
        defer registry.mutex.unlock(io);
        try std.testing.expect(registry.tryBeginLoadLocked(entry));
        registry.reserveLoadLocked(entry, 4096);
        req.fios_plan.claim_sequence = entry.fios_load_claim_sequence;
        for (victims, 0..) |victim, index| {
            try std.testing.expect(registry.markEvictingLocked(victim));
            req.fios_plan.victim_mutations[index] = victim.fios_model_mutation;
        }
    }
    owners.shared().fence(io);
    runLoadRequest(&scheduler, &req);
    try std.testing.expect(req.done and owners.shared().knownUncertain(io));
    try std.testing.expect(entry.state == .error_state and entry.fios_load_uncertain.load(.acquire));
    try std.testing.expectEqual(@as(u64, 4096), registry.reserved_bytes);
    try std.testing.expect(first.state == .ready and first.fios_model_mutation == null);
    try std.testing.expect(second.state == .ready and second.fios_model_mutation == null);
    try std.testing.expectEqual(@as(usize, 0), owners.shared().snapshot(io).model_mutations);
    try std.testing.expect(!original.releaseIfCertain(io));
}

test "fios current attempted worker eviction retains custody while untouched siblings release" {
    const a = std.heap.page_allocator;
    const io = std.testing.io;
    const owners = @import("../../../fios/request_ownership.zig");
    owners.shared().primary_guard = false;
    try owners.shared().initialize(io, @splat(253));
    const registry = try model_registry_mod.ModelRegistry.init(a, io, null, 3, 0, null);
    const entry = try registry.registerStub("fixture/worker-target", "/fixture/no-model", null);
    const first = try registry.registerStub("fixture/worker-first", "/fixture/no-first", null);
    const second = try registry.registerStub("fixture/worker-second", "/fixture/no-second", null);
    entry.fios_owner_guard = true;
    first.fios_owner_guard = true;
    second.fios_owner_guard = true;
    first.state = .ready;
    second.state = .ready;
    var victims = [_]*LoadedModel{ first, second };
    const root = try owners.shared().enter(io);
    try owners.shared().bind(io, root, entry.id);
    owners.current().* = root;
    const original = try a.create(owners.Retained);
    original.* = (try owners.retainCurrent(io)).?;
    owners.current().* = null;
    var scheduler = std.mem.zeroInit(Scheduler, .{ .allocator = a, .io = io, .registry = registry });
    var req = std.mem.zeroInit(LoadRequest, .{ .entry = entry, .config = undefined, .tok = undefined, .chat_config = undefined, .model_dir = entry.path, .evict_entries = &victims, .fios_origins = original, .allocator = a });
    {
        registry.mutex.lockUncancelable(io);
        defer registry.mutex.unlock(io);
        try std.testing.expect(registry.tryBeginLoadLocked(entry));
        registry.reserveLoadLocked(entry, 4096);
        req.fios_plan.claim_sequence = entry.fios_load_claim_sequence;
        for (victims, 0..) |victim, index| {
            try std.testing.expect(registry.markEvictingLocked(victim));
            req.fios_plan.victim_mutations[index] = victim.fios_model_mutation;
        }
    }
    const served = @import("../../../host/engines/served.zig");
    const abi = @import("../../../abi/engine.zig");
    const fake = @import("../../../testing/fake_engine.zig");
    const Probe = struct {
        io: std.Io,
        calls: usize = 0,
        request: *LoadRequest,
        attempt_seen: bool = false,
        fn close(raw: *anyopaque) callconv(.c) void {
            const self: *@This() = @ptrCast(@alignCast(raw));
            self.calls += 1;
            self.attempt_seen = self.request.fios_eviction_attempted == 1;
            owners.shared().fence(self.io);
        }
    };
    const probe = try a.create(Probe);
    probe.* = .{ .io = io, .request = &req };
    const table = try a.create(abi.Engine);
    table.* = fake.own_thread;
    table.close = Probe.close;
    const progress = try a.create(@import("../../../host/registry/load_progress.zig").Progress);
    progress.* = .{};
    const gauges = try a.create(served.Gauges);
    gauges.* = .{};
    const engine = try a.create(served.Served);
    engine.* = .{ .gpa = a, .kind = .llama, .table = table, .handle = probe, .info = undefined, .host = undefined, .progress = progress, .gauges = gauges, .metrics = null };
    first.engine = engine;
    first.bytes_resident = 128;
    registry.current_resident_bytes = 128;
    runLoadRequest(&scheduler, &req);
    try std.testing.expect(req.done and owners.shared().knownUncertain(io));
    try std.testing.expectEqual(@as(usize, 1), probe.calls);
    try std.testing.expect(probe.attempt_seen);
    try std.testing.expect(first.state == .evicting and first.fios_model_mutation != null and first.engine == engine);
    try std.testing.expectEqual(@as(u64, 128), first.bytes_resident);
    try std.testing.expectEqual(@as(u64, 128), registry.current_resident_bytes);
    try std.testing.expect(second.state == .ready and second.fios_model_mutation == null);
    try std.testing.expectEqual(@as(usize, 1), owners.shared().snapshot(io).model_mutations);
    try std.testing.expect(entry.state == .error_state and entry.fios_load_uncertain.load(.acquire));
    try std.testing.expectEqual(@as(u64, 4096), registry.reserved_bytes);
    try std.testing.expect(!original.releaseIfCertain(io));
}

test "fios current stale published target cannot evict or change a later cold claim" {
    const a = std.heap.page_allocator;
    const io = std.testing.io;
    const owners = @import("../../../fios/request_ownership.zig");
    owners.shared().primary_guard = false;
    try owners.shared().initialize(io, @splat(69));
    const registry = try model_registry_mod.ModelRegistry.init(a, io, null, 3, 0, null);
    const entry = try registry.registerStub("fixture/worker-target", "/fixture/no-model", null);
    const first = try registry.registerStub("fixture/worker-first", "/fixture/no-first", null);
    const second = try registry.registerStub("fixture/worker-second", "/fixture/no-second", null);
    entry.fios_owner_guard = true;
    first.fios_owner_guard = true;
    second.fios_owner_guard = true;
    first.state = .ready;
    second.state = .ready;
    var victims = [_]*LoadedModel{ first, second };
    const root = try owners.shared().enter(io);
    try owners.shared().bind(io, root, entry.id);
    owners.current().* = root;
    const original = try a.create(owners.Retained);
    original.* = (try owners.retainCurrent(io)).?;
    owners.current().* = null;
    var scheduler = std.mem.zeroInit(Scheduler, .{ .allocator = a, .io = io, .registry = registry });
    var req = std.mem.zeroInit(LoadRequest, .{ .entry = entry, .config = undefined, .tok = undefined, .chat_config = undefined, .model_dir = entry.path, .evict_entries = &victims, .fios_origins = original, .allocator = a });
    {
        registry.mutex.lockUncancelable(io);
        defer registry.mutex.unlock(io);
        try std.testing.expect(registry.tryBeginLoadLocked(entry));
        registry.reserveLoadLocked(entry, 4096);
        req.fios_plan.claim_sequence = entry.fios_load_claim_sequence;
        for (victims, 0..) |victim, index| {
            try std.testing.expect(registry.markEvictingLocked(victim));
            req.fios_plan.victim_mutations[index] = victim.fios_model_mutation;
        }
    }
    const served = @import("../../../host/engines/served.zig");
    const abi = @import("../../../abi/engine.zig");
    const fake = @import("../../../testing/fake_engine.zig");
    const Probe = struct {
        io: std.Io,
        calls: usize = 0,
        request: *LoadRequest,
        attempt_seen: bool = false,
        fn close(raw: *anyopaque) callconv(.c) void {
            const self: *@This() = @ptrCast(@alignCast(raw));
            self.calls += 1;
            self.attempt_seen = self.request.fios_eviction_attempted == 1;
            owners.shared().fence(self.io);
        }
    };
    const probe = try a.create(Probe);
    probe.* = .{ .io = io, .request = &req };
    const table = try a.create(abi.Engine);
    table.* = fake.own_thread;
    table.close = Probe.close;
    const progress = try a.create(@import("../../../host/registry/load_progress.zig").Progress);
    progress.* = .{};
    const gauges = try a.create(served.Gauges);
    gauges.* = .{};
    const engine = try a.create(served.Served);
    engine.* = .{ .gpa = a, .kind = .llama, .table = table, .handle = probe, .info = undefined, .host = undefined, .progress = progress, .gauges = gauges, .metrics = null };
    first.engine = engine;
    first.bytes_resident = 128;
    registry.current_resident_bytes = 128;
    {
        registry.mutex.lockUncancelable(io);
        defer registry.mutex.unlock(io);
        registry.markUnloadedLocked(entry);
        try std.testing.expect(registry.tryBeginLoadLocked(entry));
        registry.reserveLoadLocked(entry, 8192);
    }
    runLoadRequest(&scheduler, &req);
    try std.testing.expect(req.done and owners.shared().knownUncertain(io));
    try std.testing.expectEqual(@as(usize, 0), probe.calls);
    try std.testing.expectEqual(@as(u16, 0), req.fios_eviction_attempted);
    try std.testing.expect(entry.state == .loading and !entry.fios_load_uncertain.load(.acquire));
    try std.testing.expect(entry.fios_load_claim_sequence != req.fios_plan.claim_sequence.?);
    try std.testing.expectEqual(@as(u64, 8192), registry.reserved_bytes);
    try std.testing.expect(first.state == .ready and first.fios_model_mutation == null and first.engine == engine);
    try std.testing.expect(second.state == .ready and second.fios_model_mutation == null);
    try std.testing.expectEqual(@as(u64, 128), first.bytes_resident);
    try std.testing.expectEqual(@as(u64, 128), registry.current_resident_bytes);
    try std.testing.expectEqual(@as(usize, 0), owners.shared().snapshot(io).model_mutations);
}

test "fios current old victim snapshot cannot unload or refund a later ticket" {
    const a = std.heap.page_allocator;
    const io = std.testing.io;
    const owners = @import("../../../fios/request_ownership.zig");
    owners.shared().primary_guard = false;
    try owners.shared().initialize(io, @splat(71));
    const registry = try model_registry_mod.ModelRegistry.init(a, io, null, 3, 0, null);
    const entry = try registry.registerStub("fixture/worker-target", "/fixture/no-model", null);
    const first = try registry.registerStub("fixture/worker-first", "/fixture/no-first", null);
    const second = try registry.registerStub("fixture/worker-second", "/fixture/no-second", null);
    entry.fios_owner_guard = true;
    first.fios_owner_guard = true;
    second.fios_owner_guard = true;
    first.state = .ready;
    second.state = .ready;
    var victims = [_]*LoadedModel{ first, second };
    const root = try owners.shared().enter(io);
    try owners.shared().bind(io, root, entry.id);
    owners.current().* = root;
    const original = try a.create(owners.Retained);
    original.* = (try owners.retainCurrent(io)).?;
    owners.current().* = null;
    var scheduler = std.mem.zeroInit(Scheduler, .{ .allocator = a, .io = io, .registry = registry });
    var req = std.mem.zeroInit(LoadRequest, .{ .entry = entry, .config = undefined, .tok = undefined, .chat_config = undefined, .model_dir = entry.path, .evict_entries = &victims, .fios_origins = original, .allocator = a });
    {
        registry.mutex.lockUncancelable(io);
        defer registry.mutex.unlock(io);
        try std.testing.expect(registry.tryBeginLoadLocked(entry));
        registry.reserveLoadLocked(entry, 4096);
        req.fios_plan.claim_sequence = entry.fios_load_claim_sequence;
        for (victims, 0..) |victim, index| {
            try std.testing.expect(registry.markEvictingLocked(victim));
            req.fios_plan.victim_mutations[index] = victim.fios_model_mutation;
        }
    }
    const served = @import("../../../host/engines/served.zig");
    const abi = @import("../../../abi/engine.zig");
    const fake = @import("../../../testing/fake_engine.zig");
    const Probe = struct {
        io: std.Io,
        calls: usize = 0,
        request: *LoadRequest,
        attempt_seen: bool = false,
        fn close(raw: *anyopaque) callconv(.c) void {
            const self: *@This() = @ptrCast(@alignCast(raw));
            self.calls += 1;
            self.attempt_seen = self.request.fios_eviction_attempted == 1;
            owners.shared().fence(self.io);
        }
    };
    const probe = try a.create(Probe);
    probe.* = .{ .io = io, .request = &req };
    const table = try a.create(abi.Engine);
    table.* = fake.own_thread;
    table.close = Probe.close;
    const progress = try a.create(@import("../../../host/registry/load_progress.zig").Progress);
    progress.* = .{};
    const gauges = try a.create(served.Gauges);
    gauges.* = .{};
    const engine = try a.create(served.Served);
    engine.* = .{ .gpa = a, .kind = .llama, .table = table, .handle = probe, .info = undefined, .host = undefined, .progress = progress, .gauges = gauges, .metrics = null };
    first.engine = engine;
    first.bytes_resident = 128;
    registry.current_resident_bytes = 128;
    var later: owners.ModelMutation = undefined;
    {
        registry.mutex.lockUncancelable(io);
        defer registry.mutex.unlock(io);
        registry.unmarkEvictingLocked(first);
        try std.testing.expect(registry.markEvictingLocked(first));
        later = first.fios_model_mutation.?;
    }
    runLoadRequest(&scheduler, &req);
    try std.testing.expect(req.done and owners.shared().knownUncertain(io));
    try std.testing.expectEqual(@as(usize, 0), probe.calls);
    try std.testing.expectEqual(@as(u16, 0), req.fios_eviction_attempted);
    try std.testing.expect(first.state == .evicting and std.meta.eql(later, first.fios_model_mutation.?) and first.engine == engine);
    try std.testing.expectEqual(@as(u64, 128), first.bytes_resident);
    try std.testing.expectEqual(@as(u64, 128), registry.current_resident_bytes);
    try std.testing.expect(second.state == .ready and second.fios_model_mutation == null);
    try std.testing.expectEqual(@as(usize, 1), owners.shared().snapshot(io).model_mutations);
    try std.testing.expect(entry.state == .error_state and entry.fios_load_uncertain.load(.acquire));
    try std.testing.expectEqual(@as(u64, 4096), registry.reserved_bytes);
}

test "fios current standalone eviction helper releases only untouched metadata" {
    const a = std.heap.page_allocator;
    const io = std.testing.io;
    const owners = @import("../../../fios/request_ownership.zig");
    owners.shared().primary_guard = false;
    try owners.shared().initialize(io, @splat(73));
    const registry = try model_registry_mod.ModelRegistry.init(a, io, null, 3, 0, null);
    const entry = try registry.registerStub("fixture/worker-target", "/fixture/no-model", null);
    const first = try registry.registerStub("fixture/worker-first", "/fixture/no-first", null);
    const second = try registry.registerStub("fixture/worker-second", "/fixture/no-second", null);
    entry.fios_owner_guard = true;
    first.fios_owner_guard = true;
    second.fios_owner_guard = true;
    first.state = .ready;
    second.state = .ready;
    var victims = [_]*LoadedModel{ first, second };
    const root = try owners.shared().enter(io);
    try owners.shared().bind(io, root, entry.id);
    owners.current().* = root;
    const original = try a.create(owners.Retained);
    original.* = (try owners.retainCurrent(io)).?;
    owners.current().* = null;
    var scheduler = std.mem.zeroInit(Scheduler, .{ .allocator = a, .io = io, .registry = registry });
    var req = std.mem.zeroInit(LoadRequest, .{ .entry = entry, .config = undefined, .tok = undefined, .chat_config = undefined, .model_dir = entry.path, .evict_entries = &victims, .fios_origins = original, .allocator = a });
    {
        registry.mutex.lockUncancelable(io);
        defer registry.mutex.unlock(io);
        try std.testing.expect(registry.tryBeginLoadLocked(entry));
        registry.reserveLoadLocked(entry, 4096);
        req.fios_plan.claim_sequence = entry.fios_load_claim_sequence;
        for (victims, 0..) |victim, index| {
            try std.testing.expect(registry.markEvictingLocked(victim));
            req.fios_plan.victim_mutations[index] = victim.fios_model_mutation;
        }
    }
    registry.mutex.lockUncancelable(io);
    const originals = try captureEvictionMutationsLocked(&scheduler, &victims);
    registry.mutex.unlock(io);
    owners.shared().fence(io);
    var attempted: u16 = 0;
    try std.testing.expectError(error.NativeCleanupUncertain, evictResident(&scheduler, &victims, &originals, &attempted));
    try std.testing.expectEqual(@as(u16, 0), attempted);
    try std.testing.expect(owners.shared().knownUncertain(io));
    try std.testing.expect(first.state == .ready and first.fios_model_mutation == null);
    try std.testing.expect(second.state == .ready and second.fios_model_mutation == null);
    try std.testing.expectEqual(@as(usize, 0), owners.shared().snapshot(io).model_mutations);
    // This RAM-used helper owns no target failure transition or completion.
    try std.testing.expect(entry.state == .loading and !entry.fios_load_uncertain.load(.acquire));
    try std.testing.expectEqual(@as(u64, 4096), registry.reserved_bytes);
    try std.testing.expect(!original.releaseIfCertain(io));
}
