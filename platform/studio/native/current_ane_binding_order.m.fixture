// Pure CPU parent/child lifetime control, no native ANE model/API.
@interface FiosOrderModel : NSObject
@end
@implementation FiosOrderModel
- (BOOL)unloadWithQoS:(unsigned)qos error:(NSError **)error { (void)qos;*error=nil;return YES; }
@end
static bool fio_order_parent_alive;
@interface FiosOrderChild : NSObject
@property (weak) FiosOrderModel *parent;
@end
@implementation FiosOrderChild
- (void)dealloc { fio_order_parent_alive=self.parent!=nil; }
@end
int main(void) {
    @autoreleasepool {
        msv_ane_model *h=calloc(1,sizeof(*h));
        FiosOrderModel *model=[FiosOrderModel new];
        FiosOrderChild *child=[FiosOrderChild new];child.parent=model;
        NSMutableArray *requests=[NSMutableArray new];[requests addObject:child];
        h->model=(__bridge_retained void *)model;h->requests=(__bridge_retained void *)requests;
        model=nil;child=nil;requests=nil;
        if (!msv_ane_model_try_free(h)) return 1;
    }
#ifdef FIOS_ANE_SOURCE
    if (!fio_order_parent_alive) { fprintf(stderr,"FIO_CURRENT_ANE_RELEASED_PARENT_BEFORE_BINDING_CHILD\n");return 1; }
#else
    if (fio_order_parent_alive) return 1;
#endif
    fprintf(stderr,"PASS: private ANE binding child releases with original parent alive\n");return 0;
}
