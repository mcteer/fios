+/* Process metadata is not a native terminal issuer. This helper's private
+ * policy is tested separately without signaling/reaping any real process. */
+static bool fios_ane_pid_metadata_allows_reap(pid_t owner, pid_t self,
+                                             int signal_result, int signal_errno) {
+#ifdef FIOS_ANE_SOURCE
+    /* PID/ESRCH cannot prove native terminality or release a staging lease. */
+    (void)owner;(void)self;(void)signal_result;(void)signal_errno;
+    return false;
+#else
+    return owner > 0 && owner != self && signal_result != 0 && signal_errno == ESRCH;
+#endif
+}
