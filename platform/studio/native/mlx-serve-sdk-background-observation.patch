+    @memcpy(response[0..4], "FIF9");response[4] = if (request[4] == 3) 3 else 2;
+    if (!std.mem.eql(u8, request[0..4], "FIB9") or (request[4] != 2 and request[4] != 3) or
         !std.mem.allEqual(u8, request[5..8], 0) or !std.mem.allEqual(u8, request[24..32], 0)) {
         response[5] = @intFromEnum(Status.invalid);return response;
     }
@@ -78,13 +79,18 @@ pub fn dispatchCurrentBackendFences(tracker: *ownership.Tracker, io: std.Io, req
         response[5] = @intFromEnum(Status.wrong_instance);return response;
     }
     const readings: CurrentBackendFenceReadings = if (source) |read| read() else .{};
-    inline for (@typeInfo(CurrentBackendFenceReadings).@"struct".field_names, 0..) |field, index| {
+    inline for (.{ "sdk_uncertain", "llama_uncertain", "streamed_pool_uncertain", "ds4_host_uncertain", "ds4_gpu_uncertain", "ane_reported_uncertain", "ane_native_uncertain" }, 0..) |field, index| {
         if (@field(readings, field)) |value| {
             const bit: u8 = @as(u8, 1) << @as(u3, @intCast(index));
             response[6] |= bit;
             if (value) response[7] |= bit;
         }
     }
+    // Version2 preserves every reserved byte. This separate tri-state is a
+    // coverage observation, never another cleanup-failure bit.
+    if (request[4] == 3) {
+        if (readings.sdk_residency_refresh_untracked) |value| response[40] = if (value) 2 else 1;
+    }
     return response;
 }
 
