diff --git a/src/fios/current_sdk_owners.cpp b/src/fios/current_sdk_owners.cpp
index 388f7a9..e5f33cd 100644
--- a/src/fios/current_sdk_owners.cpp
+++ b/src/fios/current_sdk_owners.cpp
@@ -43,3 +43,13 @@ __attribute__((constructor)) void enable_current_source_sdk_owners() {
 extern "C" int fios_current_sdk_known_uncertain() {
     return mlx::core::fios_known_source_uncertain() ? 1 : 0;
 }
+
+// Unsupported participation is independent of failed cleanup. Old SDKs expose
+// unavailability instead of synthesizing an observed false value.
+extern "C" int fios_current_sdk_background_untracked() {
+#ifdef MLX_FIOS_RESIDENCY_REFRESH_REFUSAL
+    return mlx::core::fios_untracked_residency_refresh_seen() ? 1 : 0;
+#else
+    return -1;
+#endif
+}
