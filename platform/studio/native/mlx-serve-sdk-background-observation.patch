 };
 pub const CurrentBackendFenceSource = *const fn () CurrentBackendFenceReadings;
 pub fn dispatchCurrentBackendFences(tracker: *ownership.Tracker, io: std.Io, request: *const [backend_request_size]u8, source: ?CurrentBackendFenceSource) [backend_response_size]u8 {
     var response: [backend_response_size]u8 = @splat(0);
