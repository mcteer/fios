fn create(gpa:std.mem.Allocator,across:bool)!*Prefetch {const table=struct{var value=Table{};};return Prefetch.startOrdered(gpa,&.{&table.value},&.{.{.at=0,.len=1,.ids=&.{7}}},1,1,across);}
fn fail(comptime label:[]const u8)!void {std.debug.print("{s}\n",.{label});return error.TestUnexpectedResult;}
test "engram prefetch publication fences before worker" {const p=try create(std.testing.allocator,false);defer p.finish();try waitEntered();if(!observed.load(.acquire) or !marker.known() or !fixed.known(false,false))try fail("ENGRAM_PREFETCH_UNATTRIBUTED_PUBLICATION");}
test "engram prefetch cleanup never resets negative" {const p=try create(std.testing.allocator,true);var consumed=false;defer if(!consumed)p.finish();try waitEntered();p.finish();consumed=true;if(!marker.known() or !fixed.known(false,false))try fail("ENGRAM_PREFETCH_NEGATIVE_RESET");}
test "engram prefetch allocation failure has no effects" {try std.testing.expectError(error.OutOfMemory,create(std.testing.failing_allocator,false));try std.testing.expect(!entered.load(.acquire) and !marker.known() and !fixed.known(false,false));}
test "engram prefetch owns copied inputs" {var table=Table{};var tables=[_]*const Table{&table};var ids=[_]u32{7};var specs=[_]Prefetch.Spec{.{.at=3,.len=1,.ids=&ids}};const p=try Prefetch.startOrdered(std.testing.allocator,&tables,&specs,1,1,true);defer p.finish();try waitEntered();ids[0]=19;specs[0].at=42;try std.testing.expectEqual(@as(u32,7),p.grids[0].ids[0]);try std.testing.expectEqual(@as(usize,3),p.grids[0].at);try std.testing.expect(p.across and p.tables.ptr!=tables[0..].ptr);}
