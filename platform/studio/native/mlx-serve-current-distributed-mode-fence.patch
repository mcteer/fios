@@ -0,0 +1,12 @@
+//! Sticky negative evidence for configured distributed CLI modes only.
+//! No RDMA operation/state read, cleanup, terminal or all-client authority.
+//! Survives tracker epochs; no completion/success path resets this latch.
+const std = @import("std");
+const shared_util = @import("../sdk/util/shared.zig");
+const storage = shared_util.Shared(std.atomic.Value(bool), "fios_current_distributed_mode_uncertainty", .init(false));
+pub fn known() bool {
+    return storage.get().load(.acquire);
+}
+pub fn markConfigured() void {
+    storage.get().store(true, .release);
+}
