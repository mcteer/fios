new file mode 100644
--- /dev/null
+++ b/src/fios/observation_access.zig
@@ -0,0 +1,31 @@
+// Envelope allowlist only; never an enrollment, caller or native-idle proof.
+const std = @import("std");
+pub fn permits(request: []const u8) bool {
+    if (request.len != 32) return false;
+    if (std.mem.eql(u8, request[0..4], "FIC9")) {
+        return request[4] == 3 and std.mem.allEqual(u8, request[5..32], 0);
+    }
+    if ((std.mem.eql(u8, request[0..4], "FIA9") and request[4] == 4) or
+        (std.mem.eql(u8, request[0..4], "FIB9") and request[4] == 3))
+    {
+        return std.mem.allEqual(u8, request[5..8], 0) and std.mem.allEqual(u8, request[24..32], 0);
+    }
+    return false;
+}
+
+test "observation allowlist accepts only the three explicit readonly envelopes" {
+    var request: [32]u8 = @splat(0);
+    @memcpy(request[0..4], "FIC9");request[4] = 3;
+    try std.testing.expect(permits(&request));
+    for (1..4) |operation| {request[5] = @intCast(operation);try std.testing.expect(!permits(&request));}
+    request[5] = 0;request[16] = 1;try std.testing.expect(!permits(&request));
+    request[16] = 0;
+    inline for (.{ "FIA9", "FIB9" }, .{ @as(u8, 4), @as(u8, 3) }) |magic, version| {
+        @memcpy(request[0..4], magic);request[4] = version;request[8] = 7;
+        try std.testing.expect(permits(&request));
+        request[4] = 2;try std.testing.expect(!permits(&request));request[4] = version;
+        request[31] = 1;try std.testing.expect(!permits(&request));request[31] = 0;
+    }
+    inline for (.{ "FIJ9", "FIE9", "FIQ9", "FIP9" }) |magic| {@memcpy(request[0..4], magic);try std.testing.expect(!permits(&request));}
+    try std.testing.expect(!permits(request[0..31]));
+}
