+static void *g_fios_tp_active_origins; // guarded by g_tp_mutex; retained on refusal
+// No callbacks while holding g_tp_mutex. These are local origin metadata only.
+static int fios_ds4_tp_capture_origins(void **result) {
+    *result = NULL;
+    const int state=atomic_load_explicit(&g_fios_request_owners_state,memory_order_acquire);
+    if (state==0) return 1; // Original standalone/default behavior.
+    if (state!=2 || atomic_load_explicit(&g_fios_pending_uncertain,memory_order_acquire)) {
+        fios_ds4_request_fence();return 0;
+    }
+    *result=g_fios_request_owners.capture();
+    if (!*result) {fios_ds4_request_fence();return 0;}
+    return 1;
+}
+static void fios_ds4_tp_release_unpublished(void *origins) {
+    if (origins) g_fios_request_owners.release(origins);
+}
+static int fios_ds4_tp_enter_origins(void *origins,uint64_t *scope) {
+    *scope=0;
+    if (!origins) {
+        if (atomic_load_explicit(&g_fios_request_owners_state,memory_order_acquire)==0) return 1;
+        fios_ds4_request_fence();return 0;
+    }
+    *scope=g_fios_request_owners.enter(origins);
+    if (!*scope) {fios_ds4_request_fence();return 0;}
+    return 1;
+}
+static int fios_ds4_tp_finish_origins(void *origins,uint64_t scope) {
+    // Query while the exact scope is still installed; no enclosing queue lock.
+    if (origins && (!scope || g_fios_request_owners.covers_current(origins)!=1))
+        fios_ds4_request_fence();
+    if (scope && g_fios_request_owners.leave(scope)!=0) {
+        fios_ds4_request_fence();return 0;
+    }
+    if (atomic_load_explicit(&g_fios_pending_uncertain,memory_order_acquire)) return 0;
+    if (origins) g_fios_request_owners.release(origins);
+    return !atomic_load_explicit(&g_fios_pending_uncertain,memory_order_acquire);
+}
