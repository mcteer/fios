--- a/mlx/stream.cpp
+++ b/mlx/stream.cpp
@@ -236,7 +236,17 @@
   const auto hooks = fios_request_hooks.load(std::memory_order_acquire);
   if (!hooks) return {};
   const auto context = hooks->capture();
-  if (!context) return {};
+  if (!context) {
+    // Hooks are an explicit source opt-in. Missing/failed capture cannot
