+    // No native callback runs while the SDK registry mutex is held.
+    hooks->uncertain();
+    {
+      std::lock_guard lock(fios_registry.mutex);
+      fios_mark_uncertain(38);
+    }
+    throw std::runtime_error("Native request owner capture unavailable");
+  }
   try { return std::make_shared<FiosRequestOwners>(hooks, context); }
   catch (...) { hooks->uncertain(); hooks->release(context); throw; }
