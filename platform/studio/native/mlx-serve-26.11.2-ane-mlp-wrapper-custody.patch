+/* Local custody result only, never native terminality. A refused raw close
+ * retains this original wrapper and its own surface references as well. */
+bool msv_ane_mlp_try_free(msv_ane_mlp *m) {
+    if (!m) return true;
+    if (!msv_ane_model_try_free(m->model)) return false;
+    m->model = NULL;
+#ifdef FIOS_ANE_SOURCE
+    if (msv_ane_source_uncertainty()) return false;
+#endif
     if (m->input_surface) CFRelease(m->input_surface);
     if (m->output_surface) CFRelease(m->output_surface);
     free(m);
+    return true;
 }
+void msv_ane_mlp_free(msv_ane_mlp *m) { (void)msv_ane_mlp_try_free(m); }
 
