diff --git a/app/Sources/MLXServe/Services/FiosServerLaunchPreflight.swift b/app/Sources/MLXServe/Services/FiosServerLaunchPreflight.swift
--- /dev/null
+++ b/app/Sources/MLXServe/Services/FiosServerLaunchPreflight.swift
@@ -0,0 +1,56 @@
+import Foundation
+import Darwin
+
+// GUI launch refusal only. No ownership/admission/absence or native-terminal
+// authority. Installed handover still requires reviewed immutable artifacts,
+// the native startup guard and separately approved stopped-state acceptance.
+enum FiosServerLaunchPreflight {
+    static let reservationPath = "/Library/Application Support/Fios/Studio/native/startup.lock"
+    static let reserved = "Server startup is reserved for Fios on this Mac."
+    static let unavailable = "Server startup checks are unavailable."
+    static let occupied = "Port is already in use. Choose another port or stop its owner."
+
+    static func refusal(on port: UInt16) -> String? {
+        refusal(on: port, reservationPath: reservationPath)
+    }
+    // Internal filesystem seam for finite private fixtures. The GUI always
+    // uses the fixed installed startup namespace through the overload above.
+    static func refusal(on port: UInt16, reservationPath: String) -> String? {
+        var metadata = stat()
+        if lstat(reservationPath, &metadata) == 0 { return reserved }
+        guard errno == ENOENT else { return unavailable }
+        guard port != 0 else { return unavailable }
+        let ipv4 = socket(AF_INET, SOCK_STREAM, 0)
+        guard ipv4 >= 0 else { return unavailable }
+        defer { close(ipv4) }
+        var address4 = sockaddr_in()
+        address4.sin_len = UInt8(MemoryLayout<sockaddr_in>.size)
+        address4.sin_family = sa_family_t(AF_INET)
+        address4.sin_port = port.bigEndian
+        let bound4 = withUnsafePointer(to: &address4) {
+            $0.withMemoryRebound(to: sockaddr.self, capacity: 1) {
+                Darwin.bind(ipv4, $0, socklen_t(MemoryLayout<sockaddr_in>.size))
+            }
+        }
+        guard bound4 == 0 else { return errno == EADDRINUSE ? occupied : unavailable }
+        let ipv6 = socket(AF_INET6, SOCK_STREAM, 0)
+        guard ipv6 >= 0 else { return unavailable }
+        defer { close(ipv6) }
+        var onlyIPv6: Int32 = 1
+        guard setsockopt(ipv6, IPPROTO_IPV6, IPV6_V6ONLY, &onlyIPv6, socklen_t(MemoryLayout<Int32>.size)) == 0 else { return unavailable }
+        var address6 = sockaddr_in6()
+        address6.sin6_len = UInt8(MemoryLayout<sockaddr_in6>.size)
+        address6.sin6_family = sa_family_t(AF_INET6)
+        address6.sin6_port = port.bigEndian
+        let bound6 = withUnsafePointer(to: &address6) {
+            $0.withMemoryRebound(to: sockaddr.self, capacity: 1) {
+                Darwin.bind(ipv6, $0, socklen_t(MemoryLayout<sockaddr_in6>.size))
+            }
+        }
+        guard bound6 == 0 else { return errno == EADDRINUSE ? occupied : unavailable }
+        // Both descriptors close before return. This is a transient port
+        // preflight, never a retained native startup reservation. No listen,
+        // connection, signal, process lookup or retry occurs here.
+        return nil
+    }
+}
