const std = @import("std");
const owners = @import("fios/request_ownership.zig");
const sdk = @import("fios/sdk_request_ownership.zig");
const protocol = @import("fios/control_protocol.zig");
const transport = @import("fios/control_transport.zig");
extern fn fios_bridge_cpu_graph() c_int;
extern "c" fn alarm(c_uint) c_uint;
pub fn main() !void {
    _ = alarm(30);
    const io = std.Io.Threaded.global_single_threaded.io();
    try owners.shared().initialize(io, @splat(7));
    try sdk.initialize(io);
    const registration = try owners.shared().registerHandoff(io, @splat(9));
    const incoming = try owners.shared().enter(io);
    try owners.shared().associateHandoff(io, incoming, @splat(9), registration.root_sequence);
    try owners.shared().bind(io, incoming, "fixture/native-events");
    try owners.shared().active(io, incoming);
    owners.current().* = incoming;
    const group = [_]owners.Token{incoming};
    owners.current_group().* = &group;
    if (fios_bridge_cpu_graph() != 1) return error.CPUCallbackUnavailable;
    owners.current().* = null; owners.current_group().* = null;
    try owners.shared().leave(io, incoming);
    var request: [64]u8 = @splat(0);
    @memcpy(request[0..4], "FIO9"); request[4] = 1;
    @memset(request[8..24], 7); @memset(request[24..56], 9);
    std.mem.writeInt(u64, request[56..64], registration.root_sequence, .big);
    const frame = protocol.dispatchRequestEvents(owners.shared(), io, &request, sdk.requestEventDiagnostic);
    const unavailable = protocol.dispatchRequestEvents(owners.shared(), io, &request, null);
    const bridge = (try transport.Bridge.startWithRequestEvents(io, std.heap.c_allocator, "events-fios-source-fixture", null, null, null, null, null, sdk.requestEventDiagnostic)) orelse return error.MissingBridge;
    defer bridge.stop();
    const hex = std.fmt.bytesToHex(frame, .lower);
    const missing_hex = std.fmt.bytesToHex(unavailable, .lower);
    var output: [2048]u8 = undefined;
    const line = try std.fmt.bufPrint(&output, "{{\"root\":\"{d}\",\"frame_hex\":\"{s}\",\"unavailable_hex\":\"{s}\"}}\n", .{ registration.root_sequence, hex, missing_hex });
    if (std.c.write(1, line.ptr, line.len) != @as(isize, @intCast(line.len))) return error.OutputUnavailable;
    var input: [1]u8 = undefined;
    _ = std.c.read(0, &input, 1);
}
