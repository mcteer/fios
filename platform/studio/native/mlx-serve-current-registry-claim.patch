+test "fios current registry preparation claim uses exact real stubs without model effects" {
+    const io = std.testing.io;
+    const tracker = fios_owners.shared();
+    const previous_guard = tracker.primary_guard;
+    tracker.primary_guard = true;
+    defer tracker.primary_guard = previous_guard;
+    try tracker.initialize(io, @splat(155));
+    const registry = try ModelRegistry.init(std.testing.allocator, io, null, 2, 0, null);
+    defer registry.deinit();
+    const a = try registry.registerStub("fixture/claim-a", "/fixture/never-loaded-a", null);
+    const b = try registry.registerStub("fixture/claim-b", "/fixture/never-loaded-b", null);
+    const generation = registry.generation.load(.acquire);
+    const root = try registry.claimFiosPreparation(a.id, @splat(11));
+    try std.testing.expect(a.state == .unloaded and b.state == .unloaded);
+    try std.testing.expectEqual(generation, registry.generation.load(.acquire));
+    try std.testing.expectError(error.ModelConflict, registry.claimFiosPreparation(b.id, @splat(12)));
+    try std.testing.expectEqual(@as(usize, 1), tracker.primarySnapshot(io).owned);
+    try std.testing.expect(tracker.correlationSnapshot(io, @splat(11)).root_sequence == root.sequence);
+    try tracker.leave(io, root);
+    tracker.primary_guard = false;
+    try std.testing.expectError(error.UnsupportedSourceGuard, registry.claimFiosPreparation(a.id, @splat(13)));
+    try std.testing.expectEqual(@as(usize, 0), tracker.primarySnapshot(io).owned);
+}
