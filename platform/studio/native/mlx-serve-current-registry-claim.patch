diff --git a/src/fios/current_registry_claim.zig b/src/fios/current_registry_claim.zig
--- /dev/null
+++ b/src/fios/current_registry_claim.zig
@@ -0,0 +1,38 @@
+//! Internal exact registry/CPU ownership claim. No capacity, device-terminal,
+//! native reservation or all-client authority. No wire/serving caller.
+const std = @import("std");
+const owners = @import("request_ownership.zig");
+pub fn claim(io: std.Io, tracker: *owners.Tracker, registry: anytype, model: []const u8, id: owners.CorrelationID) !owners.Token {
+    _ = tracker.backendKnownUncertain(io);
+    return claimKnown(io, tracker, registry, model, id);
+}
+pub fn claimKnown(io: std.Io, tracker: *owners.Tracker, registry: anytype, model: []const u8, id: owners.CorrelationID) !owners.Token {
+    if (model.len == 0 or model.len > owners.model_limit or !std.unicode.utf8ValidateSlice(model) or std.mem.indexOfScalar(u8, model, 0) != null) return error.InvalidRegistryIdentity;
+    if (!registry.mutex.tryLock()) return error.RegistryBusy;
+    defer registry.mutex.unlock(io);
+    if (registry.entries.count() > 4096) return error.RegistryScanLimit;
+    const generation = registry.generation.load(.acquire);
+    if (generation > owners.maximum_sample_sequence) return error.RegistryGenerationLimit;
+    const target = registry.entries.get(model) orelse return error.MissingRegistryIdentity;
+    if (!std.mem.eql(u8, target.id, model)) return error.InvalidRegistryIdentity;
+    if (target.state != .unloaded and target.state != .ready) return error.ModelTransition;
+    var iterator = registry.entries.iterator();
+    while (iterator.next()) |item| {
+        const entry = item.value_ptr.*;
+        if (entry.id.len == 0 or entry.id.len > owners.model_limit or !std.unicode.utf8ValidateSlice(entry.id) or std.mem.indexOfScalar(u8, entry.id, 0) != null or !std.mem.eql(u8, item.key_ptr.*, entry.id)) return error.InvalidRegistryIdentity;
+        if (entry.fios_load_uncertain.load(.acquire)) {
+            tracker.fence(io);
+            return error.CoverageUncertain;
+        }
+        if (entry.state == .loading or entry.state == .evicting) return error.ModelTransition;
+    }
+    const token = try tracker.claimCorrelatedPreparationKnown(io, model, id);
+    errdefer tracker.leave(io, token) catch {
+        tracker.fence(io);
+    };
+    if (registry.generation.load(.acquire) != generation) {
+        tracker.fence(io);
+        return error.RegistryChanged;
+    }
+    return token;
+}
