diff --git a/src/fios/current_backend_fences.zig b/src/fios/current_backend_fences.zig
new file mode 100644
index 0000000..8fc69b2
--- /dev/null
+++ b/src/fios/current_backend_fences.zig
@@ -0,0 +1,26 @@
+//! Readonly current-ABI negative flags. Compilation supplies availability only;
+//! no zero/false bit proves complete custody, model idle or native admission.
+const options = @import("build_options");
+const protocol = @import("control_protocol.zig");
+fn enabled(comptime name: []const u8) bool {
+    return @hasDecl(options, name) and @field(options, name);
+}
+pub fn read() protocol.CurrentBackendFenceReadings {
+    const Source = struct {
+        extern "c" fn fios_current_sdk_known_uncertain() c_int;
+        extern "c" fn mlx_llama_source_uncertainty() c_int;
+        extern "c" fn fios_q3ld_cleanup_uncertain() c_int;
+        extern "c" fn ds4_host_source_uncertainty() u32;
+        extern "c" fn ds4_gpu_source_uncertainty() u32;
+        extern "c" fn msv_ane_source_uncertainty() u32;
+    };
+    return .{
+        .sdk_uncertain = if (comptime enabled("fios_source_sdk")) Source.fios_current_sdk_known_uncertain() != 0 else null,
+        .llama_uncertain = if (comptime enabled("llama_engine")) Source.mlx_llama_source_uncertainty() != 0 else null,
+        .streamed_pool_uncertain = if (comptime enabled("mlx_stream")) Source.fios_q3ld_cleanup_uncertain() != 0 else null,
+        .ds4_host_uncertain = if (comptime enabled("fios_source_ds4")) Source.ds4_host_source_uncertainty() != 0 else null,
+        .ds4_gpu_uncertain = if (comptime enabled("fios_source_ds4")) Source.ds4_gpu_source_uncertainty() != 0 else null,
+        .ane_reported_uncertain = if (comptime enabled("fios_source_ane")) @import("current_ane_run_uncertainty.zig").known() else null,
+        .ane_native_uncertain = if (comptime enabled("fios_source_ane")) Source.msv_ane_source_uncertainty() != 0 else null,
+    };
+}
