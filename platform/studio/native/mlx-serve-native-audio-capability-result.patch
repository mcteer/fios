+
+
+test "gemma4 config reports audio only for the served unified embedder" {
+    const allocator = testing.allocator;
+    const regular = try std.mem.replaceOwned(u8, allocator, e2b_like,
+        "{\"model_type\":\"gemma4\",",
+        "{\"model_type\":\"gemma4\",\"vision_config\":{},\"audio_config\":{},");
+    defer allocator.free(regular);
+    const unified = try std.mem.replaceOwned(u8, allocator, regular,
+        "{\"model_type\":\"gemma4\",", "{\"model_type\":\"gemma4_unified\",");
+    defer allocator.free(unified);
+    var a: abi.Parsed = .{};
+    try testing.expect(parseJson(regular, &a).isOk());
+    defer freeParsed(&a);
+    var b: abi.Parsed = .{};
+    try testing.expect(parseJson(unified, &b).isOk());
+    defer freeParsed(&b);
+    try testing.expect(a.caps.images and !a.caps.audio);
+    try testing.expect(b.caps.images and b.caps.audio);
+}
