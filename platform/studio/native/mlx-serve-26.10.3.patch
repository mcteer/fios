+    inner: std.mem.Allocator,
+    frees: usize = 0,
+    const Self = @This();
+    fn allocator(self: *Self) std.mem.Allocator {
+        return .{ .ptr = self, .vtable = &.{ .alloc = alloc, .resize = resize, .remap = remap, .free = free } };
