+fn fiosCorrelationHeader(headers: []const u8) !?fios_ownership.CorrelationID {
+    var found: ?fios_ownership.CorrelationID = null;
+    var lines = std.mem.splitSequence(u8, headers, "\r\n");
+    while (lines.next()) |line| {
+        const colon = std.mem.indexOfScalar(u8, line, ':') orelse continue;
+        if (!std.ascii.eqlIgnoreCase(line[0..colon], "x-fios-request-id")) continue;
+        if (found != null) return error.DuplicateCorrelationHeader;
+        found = try fios_ownership.parseCorrelationHex(std.mem.trim(u8, line[colon + 1 ..], " \t"));
+    }
+    return found;
+}
