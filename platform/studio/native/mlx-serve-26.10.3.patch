+// Fixed public refusals only. No owner release, lifecycle operation, retry,
+// target substitution, raw error name or filesystem/process detail is exposed.
+fn sendNativeAdmissionError(allocator: std.mem.Allocator, stream: *Conn, err: anyerror) !bool {
+    switch (err) {
+        error.ModelConflict => try sendErrorResponse(allocator, stream, "409 Conflict", "native_model_conflict", "Conflicting native model work is still owned", 409),
+        error.ModelTransition => try sendErrorResponse(allocator, stream, "409 Conflict", "native_model_transition", "The requested model has an owned transition", 409),
+        error.Maintenance => try sendErrorResponse(allocator, stream, "503 Service Unavailable", "native_admissions_closed", "Native admission is closed for maintenance", 503),
+        error.CoverageUncertain, error.ModelCapacity, error.SequenceExhausted, error.Capacity,
+        error.InvalidToken, error.InvalidPhase, error.InvalidModel, error.InvalidModelOwnership,
+        error.RegistryHeld, error.RegistryUncertain => try sendErrorResponse(allocator, stream, "503 Service Unavailable", "native_tracking_unavailable", "Native tracking cannot safely admit this request", 503),
+        else => return false,
+    }
+    return true;
+}
