+// Caller owns the context exclusively, as required by the vendor API.
+// This reports this context's known synchronization status, not all clients.
+int32_t llama_context::fios_synchronize_checked() {
+    if (fios_sync_uncertain) return 0;
+    using checked_fn = int32_t (*)(ggml_backend_t);
+    std::vector<std::pair<ggml_backend_t, checked_fn>> checked;
+    try {
+        if (backends.empty() || backends.size() > 64) {
+            fios_sync_uncertain = true; return 0;
+        }
+        // Classify every backend before invoking synchronization. Unknown or
+        // unsupported backends cannot silently use the old void-only result.
+        for (auto & backend : backends) {
+            if (!backend) { fios_sync_uncertain = true; return 0; }
+            if (ggml_backend_is_cpu(backend.get())) continue;
+            const auto dev = ggml_backend_get_device(backend.get());
+            const auto reg = dev ? ggml_backend_dev_backend_reg(dev) : nullptr;
+            const auto status = reg ? reinterpret_cast<checked_fn>(ggml_backend_reg_get_proc_address(
+                reg, "ggml_backend_fios_synchronize_checked_v1")) : nullptr;
+            if (!status) { fios_sync_uncertain = true; return 0; }
+            checked.emplace_back(backend.get(), status);
+        }
+        synchronize();
+        for (const auto & item : checked) {
+            if (item.second(item.first) != 1) {
+                fios_sync_uncertain = true; return 0;
+            }
+        }
+        return 1;
+    } catch (...) { fios_sync_uncertain = true; return 0; }
 }
 
