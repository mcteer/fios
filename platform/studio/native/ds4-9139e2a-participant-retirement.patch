+static metal_graph_stream_pagein_job *metal_graph_stream_pagein_authorize(
+        const metal_graph_stream_pagein_job *owner) {
+    if (!owner || !owner->custody || !owner->custody_id || !g_fios_pagein_local_owner) return NULL;
+    pthread_mutex_lock(&g_fios_pagein_mutex);
+    metal_graph_stream_pagein_job *job = g_fios_pagein_jobs;
