+bool fios_enable_stream_custody_fixture() {
+  std::lock_guard lock(fios_registry.mutex);
+  if (fios_registry.enabled || fios_registry.ever_created || fios_registry.pending)
+    return false;
+  fios_registry.enabled = true;
+  return fios_bump();
+}
+uint64_t fios_current_stream_owner() {
+  std::lock_guard lock(fios_registry.mutex);
+  if (!fios_registry.enabled || fios_registry.uncertain ||
+      (fios_registry.held && !fios_owner)) return 0;
+  return fios_owner_locked();
+}
+FiosStreamCustodyState fios_stream_custody_state() {
+  std::lock_guard lock(fios_registry.mutex);
+  return {fios_registry.epoch, static_cast<uint32_t>(fios_registry.count),
+          fios_registry.pending, fios_registry.enabled, fios_registry.uncertain,
+          fios_registry.held != 0, fios_registry.shared};
+}
+std::vector<Stream> fios_owned_streams() {
+  std::lock_guard lock(fios_registry.mutex);
+  if (!fios_registry.enabled || fios_registry.uncertain || fios_registry.pending ||
+      fios_registry.shared || !fios_owner)
+    throw std::runtime_error("Stream custody unavailable");
+  std::vector<Stream> result;
+  result.reserve(fios_registry.count);
+  for (size_t i = 0; i < fios_registry.count; ++i) {
+    const auto& entry = *fios_registry.entries[i];
+    if (entry.owner == fios_owner) result.push_back(entry.stream);
+  }
+  return result;
+}
+uint64_t fios_hold_stream_creation(uint64_t expected_epoch) {
+  std::lock_guard lock(fios_registry.mutex);
+  if (!fios_registry.enabled || fios_registry.uncertain || fios_registry.pending ||
+      fios_registry.held || !fios_owner || fios_registry.epoch != expected_epoch)
+    return 0;
+  if (fios_registry.next_hold == std::numeric_limits<uint64_t>::max()) {
+    fios_registry.uncertain = true;
+    return 0;
+  }
+  if (!fios_bump()) return 0;
+  fios_registry.held_owner = fios_owner;
+  fios_registry.held = ++fios_registry.next_hold;
+  return fios_registry.held;
+}
+bool fios_release_stream_creation(uint64_t ticket) {
+  std::lock_guard lock(fios_registry.mutex);
+  if (!ticket || fios_registry.held != ticket || !fios_owner ||
+      fios_registry.held_owner != fios_owner) return false;
+  if (!fios_bump()) return false;
+  fios_registry.held = 0;
+  fios_registry.held_owner = 0;
+  return true;
+}
