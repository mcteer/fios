+constexpr size_t fios_limit = 256;
+struct FiosEntry {
+  Stream stream;
+  uint64_t owner;
+};
+struct FiosRegistry {
+  std::mutex mutex;
+  std::array<std::optional<FiosEntry>, fios_limit> entries;
+  size_t count = 0;
+  uint32_t pending = 0;
+  uint64_t epoch = 1, next_owner = 0, next_hold = 0;
+  uint64_t held = 0, held_owner = 0;
+  bool enabled = false, ever_created = false, uncertain = false, shared = false;
+};
+constinit FiosRegistry fios_registry;
+thread_local uint64_t fios_owner = 0;
+
+bool fios_bump() {
+  if (fios_registry.uncertain) return false;
+  if (fios_registry.epoch == std::numeric_limits<uint64_t>::max()) {
+    fios_registry.uncertain = true;
+    return false;
+  }
+  ++fios_registry.epoch;
+  return true;
+}
+uint64_t fios_owner_locked() {
+  if (fios_owner) return fios_owner;
+  if (fios_registry.next_owner == std::numeric_limits<uint64_t>::max()) {
+    fios_registry.uncertain = true;
+    return 0;
+  }
+  fios_owner = ++fios_registry.next_owner;
+  return fios_bump() ? fios_owner : 0;
+}
+
+struct FiosCreation {
+  uint64_t owner = 0;
+  bool tracked = false, done = false;
+  FiosCreation(const FiosCreation&) = delete;
+  FiosCreation& operator=(const FiosCreation&) = delete;
+  FiosCreation() {
+    std::lock_guard lock(fios_registry.mutex);
+    fios_registry.ever_created = true;
+    if (!fios_registry.enabled) return;
+    if (fios_registry.held) throw std::runtime_error("Stream creation held");
+    if (fios_registry.uncertain) return;
+    if (fios_registry.count + fios_registry.pending >= fios_limit) {
+      fios_registry.uncertain = true;
+      return;
+    }
+    owner = fios_owner_locked();
+    if (!owner || !fios_bump()) return;
+    ++fios_registry.pending;
+    tracked = true;
+  }
+  ~FiosCreation() {
+    if (!tracked || done) return;
+    std::lock_guard lock(fios_registry.mutex);
+    --fios_registry.pending;
+    fios_registry.uncertain = true;
+  }
+  void finish(Stream stream, bool shared) {
+    if (!tracked || done) return;
+    std::lock_guard lock(fios_registry.mutex);
+    fios_registry.entries[fios_registry.count++].emplace(FiosEntry{stream, owner});
+    fios_registry.shared |= shared;
+    --fios_registry.pending;
+    fios_bump();
+    done = true;
+  }
+};
