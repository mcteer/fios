+// Current backend ABI sources are a separate explicit version. Every optional
+// bit is independent negative evidence; false never grants terminal/admission.
+pub const CurrentBackendFenceReadings = struct {
+    sdk_uncertain: ?bool = null,
+    llama_uncertain: ?bool = null,
+    streamed_pool_uncertain: ?bool = null,
+    ds4_host_uncertain: ?bool = null,
+    ds4_gpu_uncertain: ?bool = null,
+    ane_reported_uncertain: ?bool = null,
+    ane_native_uncertain: ?bool = null,
+    sdk_residency_refresh_untracked: ?bool = null,
+};
+pub const CurrentBackendFenceSource = *const fn () CurrentBackendFenceReadings;
+pub fn dispatchCurrentBackendFences(tracker: *ownership.Tracker, io: std.Io, request: *const [backend_request_size]u8, source: ?CurrentBackendFenceSource) [backend_response_size]u8 {
+    var response: [backend_response_size]u8 = @splat(0);
+    @memcpy(response[0..4], "FIF9");response[4] = if (request[4] == 3) 3 else 2;
+    if (!std.mem.eql(u8, request[0..4], "FIB9") or (request[4] != 2 and request[4] != 3) or
+        !std.mem.allEqual(u8, request[5..8], 0) or !std.mem.allEqual(u8, request[24..32], 0)) {
+        response[5] = @intFromEnum(Status.invalid);return response;
+    }
+    const captured_at = std.Io.Clock.real.now(io).toMilliseconds();
+    const snapshot = tracker.snapshot(io);
+    @memcpy(response[8..24], &snapshot.instance);
+    std.mem.writeInt(u64, response[24..32], snapshot.sample_sequence, .big);
+    const stamp: u64 = if (captured_at > 0 and captured_at <= ownership.maximum_sample_sequence)
+        @intCast(captured_at) else std.math.maxInt(u64);
+    std.mem.writeInt(u64, response[32..40], stamp, .big);
+    if (!snapshot.initialized or !std.mem.eql(u8, request[8..24], &snapshot.instance)) {
+        response[5] = @intFromEnum(Status.wrong_instance);return response;
+    }
+    const readings: CurrentBackendFenceReadings = if (source) |read| read() else .{};
+    inline for (.{ "sdk_uncertain", "llama_uncertain", "streamed_pool_uncertain", "ds4_host_uncertain", "ds4_gpu_uncertain", "ane_reported_uncertain", "ane_native_uncertain" }, 0..) |field, index| {
+        if (@field(readings, field)) |value| {
+            const bit: u8 = @as(u8, 1) << @as(u3, @intCast(index));
+            response[6] |= bit;
+            if (value) response[7] |= bit;
+        }
+    }
+    // Version2 preserves every reserved byte. This separate tri-state is a
+    // coverage observation, never another cleanup-failure bit.
+    if (request[4] == 3) {
+        if (readings.sdk_residency_refresh_untracked) |value| response[40] = if (value) 2 else 1;
+    }
     return response;
 }
 
