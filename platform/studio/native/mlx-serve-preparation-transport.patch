@@ -0,0 +1,28 @@
+// Fixed original-root metadata for the explicit native preparation path. Neither
+// a model selector nor authentication, native admission or completion proof.
+const std = @import("std");
+pub fn parse(headers: []const u8) !?u64 {
+    var result: ?u64 = null;
+    var lines = std.mem.splitSequence(u8, headers, "\r\n");
+    while (lines.next()) |line| {
+        const colon = std.mem.indexOfScalar(u8, line, ':') orelse continue;
+        if (!std.ascii.eqlIgnoreCase(line[0..colon], "x-fios-preparation-root")) continue;
+        if (result != null) return error.DuplicatePreparationHeader;
+        const value = std.mem.trim(u8, line[colon + 1 ..], " \t");
+        if (value.len == 0 or value.len > 20 or value[0] == '0') return error.InvalidPreparationHeader;
+        for (value) |byte| if (byte < '0' or byte > '9') return error.InvalidPreparationHeader;
+        const root = std.fmt.parseInt(u64, value, 10) catch return error.InvalidPreparationHeader;
+        result = root;
+    }
+    return result;
+}
+test "preparation header preserves full-width original root and refuses ambiguous values" {
+    try std.testing.expectEqual(@as(?u64, null), try parse("Host: localhost\r\n"));
+    try std.testing.expectEqual(@as(?u64,std.math.maxInt(u64)),try parse("X-Fios-Preparation-Root:18446744073709551615\r\n"));
+    try std.testing.expectEqual(@as(?u64, 7), try parse("x-fios-preparation-root: \t7 \t\r\n"));
+    for ([_][]const u8{ "", "0", "01", "+1", "-1", "1 2", "18446744073709551616", "1a" }) |bad| {
+        var bytes: [128]u8 = undefined;
+        try std.testing.expectError(error.InvalidPreparationHeader, parse(try std.fmt.bufPrint(&bytes, "X-Fios-Preparation-Root:{s}\r\n", .{bad})));
+    }
+    try std.testing.expectError(error.DuplicatePreparationHeader, parse("X-Fios-Preparation-Root:1\r\nx-fios-preparation-root:2\r\n"));
+}
