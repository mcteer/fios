diff --git a/src/fios/current_ds4_checked_cleanup.zig b/src/fios/current_ds4_checked_cleanup.zig
new file mode 100644
index 0000000..613c06b
--- /dev/null
+++ b/src/fios/current_ds4_checked_cleanup.zig
@@ -0,0 +1,26 @@
+//! Sticky negative-only checked destruction. Never a native terminal proof.
+const std = @import("std");
+const options = @import("build_options");
+const ffi = @import("../engines/ds4/ffi.zig");
+const enabled = @hasDecl(options, "fios_source_ds4") and options.fios_source_ds4;
+const uncertain = @import("../sdk/util/shared.zig").Shared(std.atomic.Value(bool), "fios_ds4_checked_cleanup_uncertain", .init(false));
+pub fn known() bool {
+    return uncertain.get().load(.acquire);
+}
+fn retainIfRefused(result: c_int) bool {
+    if (result == 1) return true;
+    uncertain.get().store(true, .release);
+    return false;
+}
+pub fn engine(handle: ?*ffi.Engine) bool {
+    if (known()) return false;
+    if (comptime enabled) return retainIfRefused(ffi.ds4_engine_close_checked(handle));
+    ffi.ds4_engine_close(handle);
+    return true;
+}
+pub fn session(handle: ?*ffi.Session) bool {
+    if (known()) return false;
+    if (comptime enabled) return retainIfRefused(ffi.ds4_session_free_checked(handle));
+    ffi.ds4_session_free(handle);
+    return true;
+}
