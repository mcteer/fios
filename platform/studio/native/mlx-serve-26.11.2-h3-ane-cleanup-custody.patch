+const FiosLocalCustody = struct {
+    allocator: std.mem.Allocator,
+    model: ?Model = null,
+    stack: lora_mod.Stack,
+    fn create(allocator: std.mem.Allocator) !*FiosLocalCustody {
+        try ane.cleanup_guard.requireCertain();
+        const self = try allocator.create(FiosLocalCustody);
+        self.* = .{ .allocator = allocator, .stack = .{ .allocator = allocator } };
+        return self;
+    }
+    fn tryDeinit(self: *FiosLocalCustody) bool {
+        return self.tryDeinitWith(ane.cleanup_guard.known, Model.tryDeinit, lora_mod.Stack.deinit);
+    }
+    fn tryDeinitWith(self: *FiosLocalCustody, comptime negative: anytype,
+        comptime close_model: anytype, comptime close_stack: anytype) bool {
+        if (negative()) {
+            ane.cleanup_guard.retainUncertain();
+            return false;
+        }
+        if (self.model) |*m| {
+            if (!close_model(m)) {
+                ane.cleanup_guard.retainUncertain();
+                return false;
+            }
+            self.model = null;
+        }
+        if (negative()) {
+            ane.cleanup_guard.retainUncertain();
+            return false;
+        }
+        close_stack(&self.stack);
+        if (negative()) {
+            ane.cleanup_guard.retainUncertain();
+            return false;
+        }
+        self.allocator.destroy(self);
+        return true;
+    }
+};
