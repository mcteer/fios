+#ifdef FIOS_ANE_SOURCE
+/* Exclusive preparation only: a refused/partial restore is never a cold-cache
+ * fallback. Existing trees remain untouched and no native ownership is inferred.
+ * Trusted callers keep this process-owned path stable throughout construction. */
+static bool fios_ane_prepare_staging(NSString *identifier, NSString *directory,
+                                      bool *cached) {
+    *cached = false;
+    if (msv_ane_source_uncertainty()) return false;
+    NSFileManager *files = [NSFileManager defaultManager];
+    NSString *entry = bridge_cache_entry(identifier);
+    if ([files fileExistsAtPath:[entry stringByAppendingPathComponent:@"compiled.ok"]]) {
+        if (!bridge_cache_restore(identifier, directory)) return false;
+        *cached = true;
+        return true;
+    }
+    return mkdir(directory.fileSystemRepresentation, 0700) == 0;
+}
+#endif
