+test "fios current per-model uncertainty retains parents before source epoch initialization" {
+    const io = std.testing.io;
+    const page = std.heap.page_allocator;
+    const owners = @import("../../../fios/request_ownership.zig");
+    owners.shared().primary_guard = false;
+    const Trace = struct {
+        model: usize = 0,
+        registry: usize = 0,
+        model_freed: bool = false,
+        registry_freed: bool = false,
+        fn alloc(_: *anyopaque, n: usize, alignment: std.mem.Alignment, ret: usize) ?[*]u8 {
+            return std.heap.page_allocator.rawAlloc(n, alignment, ret);
+        }
+        fn free(raw: *anyopaque, bytes: []u8, alignment: std.mem.Alignment, ret: usize) void {
+            const self: *@This() = @ptrCast(@alignCast(raw));
+            if (@intFromPtr(bytes.ptr) == self.model) self.model_freed = true;
+            if (@intFromPtr(bytes.ptr) == self.registry) self.registry_freed = true;
+            std.heap.page_allocator.rawFree(bytes, alignment, ret);
+        }
+        const vtable: std.mem.Allocator.VTable = .{ .alloc = alloc, .resize = std.mem.Allocator.noResize, .remap = std.mem.Allocator.noRemap, .free = free };
+        fn allocator(self: *@This()) std.mem.Allocator { return .{ .ptr = self, .vtable = &vtable }; }
+    };
+    const trace = try page.create(Trace);
+    trace.* = .{};
+    const reg = try model_registry_mod.ModelRegistry.init(trace.allocator(), io, null, 2, 0, null);
+    const entry = try reg.registerStub("fixture/preinit-reservation", "/fixture/no-model", 123);
+    trace.model = @intFromPtr(entry);
+    trace.registry = @intFromPtr(reg);
+    reg.mutex.lockUncancelable(io);
+    try std.testing.expect(reg.tryBeginLoadLocked(entry));
+    reg.reserveLoadLocked(entry, 123);
+    reg.markLoadUncertainLocked(entry);
+    reg.mutex.unlock(io);
+    // No source epoch exists yet; the individual negative record must still
+    // prevent cleanup. Neither absence nor local retirement is completion.
+    try std.testing.expect(!entry.tryCloseEngine() and !entry.tryCloseMedia());
+    try std.testing.expect(!entry.tryUnloadResident() and !entry.tryReleaseNativeFields());
+    try std.testing.expectError(error.NativeCleanupUncertain, reg.ensureLoaded(entry.id));
+    reg.deinit();
+    try std.testing.expect(!trace.model_freed and !trace.registry_freed);
+    try std.testing.expectEqual(@as(u64, 123), entry.load_estimate);
+    try std.testing.expectEqual(@as(u64, 123), reg.reserved_bytes);
+    try std.testing.expectEqual(@as(usize, 1), reg.entries.count());
+    try owners.shared().initialize(io, @splat(229));
+    try std.testing.expect(owners.shared().knownUncertain(io));
+    try std.testing.expectError(error.NativeCleanupUncertain, reg.ensureLoaded(entry.id));
+}
