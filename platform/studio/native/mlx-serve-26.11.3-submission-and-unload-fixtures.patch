+test "fios current blocking and immediate submission refuse before reading the model" {
+    // Replay one case per process: the synthetic fence is intentionally sticky.
+    const owners = @import("../../fios/request_ownership.zig");
+    try owners.shared().initialize(testing.io, @splat(219));
+    owners.shared().fence(testing.io);
+    var sch: Scheduler = undefined;
+    sch.io = testing.io;
+    sch.queue_mu = .init;
+    sch.queue_cap = 1;
+    sch.in_flight = 0;
+    var model: LoadedModel = undefined;
+    model.config = null;
+    var params: SubmitParams = undefined;
+    params.model = &model;
+    try testing.expectError(error.NativeCleanupUncertain, submit(&sch, params));
+    try testing.expectError(error.NativeCleanupUncertain, submitNow(&sch, params));
+    try testing.expect(sch.in_flight == 0);
+}
+
 /// Give back the slot's session claim. Caller holds `queue_mu`.
