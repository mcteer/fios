+static bool fios_ane_model_capture_surfaces(msv_ane_model *h, IOSurfaceRef *inputs,
+        uint32_t count, IOSurfaceRef output) {
+    if (!output || (count && !inputs)) return false;
+    size_t size=(size_t)count+1;
+    if (size<count || size>SIZE_MAX/sizeof(IOSurfaceRef)) return false;
+    IOSurfaceRef *owned=calloc(size,sizeof(*owned));
+    if (!owned) return false;
+    for (size_t i=0;i<size;i++) {
+        IOSurfaceRef surface=i<count ? inputs[i] : output;
+        if (!surface) {
+            for (size_t j=0;j<i;j++) CFRelease(owned[j]);
+            free(owned);return false;
+        }
+        owned[i]=(IOSurfaceRef)CFRetain(surface);
+    }
+    h->fios_surfaces=owned;h->fios_surface_count=size;return true;
+}
