test "qwen warm published negative before spawn" {var table=NgramTable{};table.startWarm();if(table.warm_thread)|t|t.join();if(!table.started.load(.acquire) or !table.observed.load(.acquire) or !marker.known() or !fixed.known(false,false)){std.debug.print("QWEN_WARM_UNATTRIBUTED_WORK_PUBLISHED\n",.{});return error.TestUnexpectedResult;}}
test "qwen warm absent region has no effects" {var table=NgramTable{.has_region=false};table.startWarm();try std.testing.expect(table.warm_thread==null and !marker.known() and !fixed.known(false,false));}
test "qwen warm disabled has no effects" {enabled=false;var table=NgramTable{};table.startWarm();try std.testing.expect(table.warm_thread==null and !marker.known() and !fixed.known(false,false));}
test "qwen warm negative survives later disabled attempt" {var first=NgramTable{};first.startWarm();if(first.warm_thread)|t|t.join();enabled=false;var second=NgramTable{};second.startWarm();if(!marker.known() or !fixed.known(false,false)){std.debug.print("QWEN_WARM_NEGATIVE_RESET\n",.{});return error.TestUnexpectedResult;}}
