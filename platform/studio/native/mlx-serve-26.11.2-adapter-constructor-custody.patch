+    if (engine != null) std.debug.print("FIO_CURRENT_ds4_CONSTRUCTOR_PUBLISHED_UNCERTAINTY\n", .{});
+    try testing.expect(engine == null);
+    try testing.expectEqual(abi.Verdict.Code.failed, verdict.code);
+    try testing.expectEqualStrings("NativeCleanupUncertain", abi.items(u8, verdict.why));
+    try testing.expectEqual(@as(usize, if (preexisting) 0 else 1), FiosConstructorProbe.opens);
+    try testing.expectEqual(@as(usize, 0), FiosConstructorProbe.closes);
+    try testing.expectEqual(@as(usize, 0), FiosConstructorProbe.child_frees);
+    try testing.expect(owners.shared().knownUncertain(testing.io));
+    try testing.expect(probe_table.open(&open, &info, &verdict) == null);
+    try testing.expectEqual(@as(usize, if (preexisting) 0 else 1), FiosConstructorProbe.opens);
