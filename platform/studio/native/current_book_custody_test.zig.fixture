
test "fios current book retains original request through queue and callback" {
    const owners = @import("../../fios/request_ownership.zig");
    // The real book uses its own native Io; initialize the source with the
    // test runtime's Io to exercise the actual shared-mutex handoff too.
    try owners.shared().initialize(testing.io, @splat(47));
    const root = try owners.shared().enter(testing.io);
    var root_live = true;
    defer if (root_live) owners.shared().leave(testing.io, root) catch {};
    const correlation: owners.CorrelationID = @splat(53);
    try owners.shared().associate(testing.io, root, correlation);
    try owners.shared().bind(testing.io, root, "fixture/own-thread-request");
    owners.current().* = root;
    defer owners.current().* = null;
    var b: Book = .{ .gpa = testing.allocator, .max_waiting = 2 };
    defer b.deinit();
    var seen: Seen = .{};
    var verdict: abi.Verdict = .{};
    const request = b.add(.{}, 1, &.{ .prompt = abi.span(u32, &.{1}), .max_tokens = 1 }, seen.sink(), &verdict).?;
    try testing.expectEqual(abi.Verdict.Code.ok, verdict.code);
    try owners.shared().leave(testing.io, root);
    root_live = false;
    owners.current().* = null;
    const queued = owners.shared().correlationSnapshot(testing.io, correlation);
    try testing.expectEqual(request, b.next(false).?);
    b.done(request, .stop, "");
    try testing.expectEqual(@as(usize, 1), seen.n_events);
    try testing.expectEqual(Reason.stop, seen.reason);
    if (!queued.found) std.debug.print("FIO_CURRENT_BOOK_LOST_REQUEST_CUSTODY\n", .{});
    try testing.expect(queued.found);
    try testing.expectEqual(root.sequence, queued.root_sequence);
    try testing.expectEqual(@as(usize, 0), owners.shared().snapshot(testing.io).owned);
}
