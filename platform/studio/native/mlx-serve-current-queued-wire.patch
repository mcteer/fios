+// Version 2 is a separate five-phase partial ownership observation. Version 1
+// stays byte-for-byte compatible; neither frame grants resident/idle authority.
+pub const queued_primary_request_size = 32;
+pub const queued_primary_record_size = 20 + ownership.model_limit;
+pub const queued_primary_response_size = 72 + ownership.model_capacity * queued_primary_record_size;
+pub fn dispatchQueuedActivity(tracker: *ownership.Tracker, io: std.Io, request: *const [queued_primary_request_size]u8) [queued_primary_response_size]u8 {
+    var response: [queued_primary_response_size]u8 = @splat(0);
+    @memcpy(response[0..4], "FIT9");response[4] = 2;
+    if (!std.mem.eql(u8, request[0..4], "FIA9") or request[4] != 2 or
+        !std.mem.allEqual(u8, request[5..8], 0) or !std.mem.allEqual(u8, request[24..32], 0)) {
+        response[5] = @intFromEnum(Status.invalid);return response;
+    }
+    _ = tracker.backendKnownUncertain(io); // Explicit fixed negative source; ordinary snapshots stay callback-free.
+    const captured_at = std.Io.Clock.real.now(io).toMilliseconds();
+    const snapshot = tracker.queuedSnapshot(io);
+    @memcpy(response[8..24], &snapshot.instance);
+    std.mem.writeInt(u64, response[24..32], snapshot.sample_sequence, .big);
+    const stamp: u64 = if (captured_at > 0 and captured_at <= ownership.maximum_sample_sequence)
+        @intCast(captured_at) else std.math.maxInt(u64);
+    std.mem.writeInt(u64, response[32..40], stamp, .big);
+    if (!snapshot.initialized or !std.mem.eql(u8, request[8..24], &snapshot.instance)) {
+        response[5] = @intFromEnum(Status.wrong_instance);return response;
+    }
+    response[7] = @intFromBool(snapshot.uncertain);
+    inline for (.{snapshot.owned,snapshot.ingress,snapshot.preparing,snapshot.queued,snapshot.active,snapshot.responding,snapshot.model_count}, 0..) |value,index|
+        std.mem.writeInt(u32, response[40 + index * 4 ..][0..4], @intCast(value), .big);
+    for (snapshot.models[0..snapshot.model_count], 0..) |model,index| {
+        const offset = 72 + index * queued_primary_record_size;
+        std.mem.writeInt(u16, response[offset..][0..2], @intCast(model.len), .big);
+        inline for (.{model.preparing,model.queued,model.active,model.responding}, 0..) |value,phase|
+            std.mem.writeInt(u32, response[offset + 4 + phase * 4 ..][0..4], @intCast(value), .big);
+        @memcpy(response[offset + 20 ..][0..model.len], model.id[0..model.len]);
+    }
+    return response;
+}
