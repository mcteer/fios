+static void fios_ane_program_capture_inputs(msv_ane_program *p, NSData *program,
+        NSData *weights, NSMutableArray *models, NSMutableArray *options) {
+    p->models=(__bridge_retained void *)models;
+    p->options=(__bridge_retained void *)options;
+    p->fios_constructor_inputs=(__bridge_retained void *)@[program,weights];
