+//! Negative evidence for the existing private-queue streamed GPU warmer.
+//! Its current ownership port is incomplete; construction cannot grant idle,
+//! terminality or admission. Local destroy/join and later epochs never reset it.
+const std = @import("std");
+const shared_util = @import("shared.zig");
+const storage = shared_util.Shared(std.atomic.Value(bool), "fios_current_streamed_warm_source_uncertainty", .init(false));
+pub fn known() bool {
+    return storage.get().load(.acquire);
+}
+pub fn markConstruction() void {
+    storage.get().store(true, .release);
+}
