+#ifdef FIOS_ANE_SOURCE
+        const bool local_result=fios_ane_model_finish_operation(handle,accepted,false);
+#else
+        const bool local_result=accepted;
+#endif
+        if (!local_result) {
             bridge_fail(error, error_size, "ANE reload failed: %s",
                         failure ?
                         failure.localizedDescription.UTF8String : "?");
@@ -900,7 +961,7 @@ bool msv_ane_model_try_free(msv_ane_model *handle) {
