+test "fios local SSE tail publishes responding and preserves ownership" {
+    const ownership = @import("../../fios/request_ownership.zig");
+    const tracker = ownership.shared();
+    const io = std.testing.io;
+    try tracker.initialize(io, @splat(27));
+    const token = try tracker.enter(io);
+    defer tracker.leave(io, token) catch {};
+    const correlation: ownership.CorrelationID = @splat(14);
+    try tracker.associate(io, token, correlation);
+    try tracker.bind(io, token, "fixture/stream-tail");
+    try tracker.active(io, token);
+    const raw = try capture(std.testing.allocator, struct {
+        fn run(conn: *Conn, owner: ownership.Token, id: ownership.CorrelationID) !void {
+            conn.fios_response_owner = owner;
+            try sendStreamTail(std.testing.allocator, conn, 1, "fixture/stream-tail", .{ .reason = "stop", .details = null }, null, null, null);
+            const current = ownership.shared().correlationSnapshot(conn.io, id);
+            try std.testing.expect(current.found and !current.uncertain);
+            try std.testing.expectEqual(owner.sequence, current.root_sequence);
+            try std.testing.expectEqual(@as(usize, 1), current.responding);
+            try std.testing.expectEqual(@as(usize, 0), current.active);
+            // The router fallback must preserve the already responding owner.
+            conn.beginFiosResponse();
+            const after_fallback = ownership.shared().correlationSnapshot(conn.io, id);
+            try std.testing.expect(after_fallback.found and !after_fallback.uncertain);
+            try std.testing.expectEqual(@as(usize, 1), after_fallback.responding);
+        }
+    }.run, .{ token, correlation });
+    defer std.testing.allocator.free(raw);
+    try std.testing.expect(std.mem.endsWith(u8, raw, "data: [DONE]\n\n"));
+}
