+
+// A refused handoff is an error, never native completion or permission to
+// refund independently uncertain roots. Wake only these original senders.
+fn failFioOrigins(sch: *Scheduler, reqs: []*GenRequest) void {
+    for (reqs) |req| {
+        req.done_mu.lockUncancelable(sch.io);
+        req.fios_failed = true;
+        req.done = true;
+        req.done_cond.broadcast(sch.io);
+        req.done_mu.unlock(sch.io);
+    }
