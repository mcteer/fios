// Ordinary absent-input and already-held-parent controls, never a backend error.
extern "C" void mlx_llama_log(bool, const char *) {}
int main() {
    alarm(5);
    char message[128] = {};
    if (mlx_llama_source_uncertainty()) return 10;
    if (mlx_llama_ctx_create(nullptr, nullptr, message, sizeof(message)) != nullptr || mlx_llama_source_uncertainty()) return 11;
    auto *parent = new mlx_llama_engine();
    auto *child = new mlx_llama_ctx();
    if (!fios_llama_retain_parent(child, parent)) return 12;
    if (mlx_llama_try_close(parent) != 0 || mlx_llama_source_uncertainty() != 1) return 13;
    if (mlx_llama_step(child, nullptr, nullptr, 1, message, sizeof(message)) != -1 || !child->rows.empty()) return 14;
    if (mlx_llama_seq_prefill(child, 0, nullptr, 0, message, sizeof(message)) != -1) return 15;
    if (mlx_llama_seq_trim(child, 0, 0) != -1 || mlx_llama_seq_logits(child, 0) != nullptr) return 16;
    mlx_llama_seq_reset(child, 0);
    if (mlx_llama_seq_pos(child, 0) != 0) return 18;
    if (mlx_llama_ctx_try_free(child) != 0 || !child->fios_parent_owned || parent->fios_children != 1 || mlx_llama_source_uncertainty() != 1) return 17;
    puts("PASS: ordinary empty llama preflight preserves the existing parent fence without compute");
}
