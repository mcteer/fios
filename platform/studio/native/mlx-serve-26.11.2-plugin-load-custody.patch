+// Local resource retirement only, never native terminal/admission proof.
+fn fiosFinishLoad(io: std.Io, a: std.mem.Allocator, metadata: ?*Bound, native_model: ?*anyopaque, shell: ?*Transformer, res: *Resident, fs: ?*FsPackDir, transferred: bool) void {
+    var retain = fiosLoadUncertain(io);
+    if (!transferred and !retain) {
+        if (metadata) |held| {
+            if (native_model != null) {
+                if (!tryUnbind(held, a)) retain = true;
+            } else a.destroy(held);
+        }
+        if (!retain and !fiosLoadUncertain(io)) {
+            if (shell) |xfm| { if (!xfm.tryDeinit()) retain = true; }
+        }
+    }
+    if (retain) @import("../../../fios/request_ownership.zig").shared().fence(io);
+    if (!retain and !fiosLoadUncertain(io)) res.deinit();
+    if (!retain and !fiosLoadUncertain(io)) { if (fs) |opened_dir| opened_dir.close(); }
+}
