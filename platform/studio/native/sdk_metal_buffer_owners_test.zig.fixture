// Actual SDK encoding under separate native origins, before any completion
// callback is registered. No model, shader dispatch or fabricated SDK state.
const std = @import("std");
const owners = @import("request_ownership.zig");
const sdk = @import("sdk_request_ownership.zig");
extern fn fios_metal_owner_fixture_begin() c_int;
extern fn fios_metal_owner_fixture_submit() c_int;
extern fn fios_metal_owner_fixture_release_gpu() void;
extern fn fios_metal_owner_fixture_wait_child() c_int;
extern fn fios_metal_owner_fixture_child_owner() c_int;
extern fn fios_metal_owner_fixture_cleanup() c_int;
test "fios genuine SDK buffer records every native encoding origin" {
    const io=std.testing.io;
    try owners.shared.initialize(io,@splat(7));try sdk.initialize(io);
    const first=try owners.shared.enter(io);
    try owners.shared.bind(io,first,"fixture/buffer-origin");try owners.shared.active(io,first);
    owners.current=first;
    var cleaned=false;
    defer {if(!cleaned){_ = fios_metal_owner_fixture_cleanup();}}
    defer {owners.current=null;owners.current_group=null;}
    try std.testing.expectEqual(@as(c_int,1),fios_metal_owner_fixture_begin());
    owners.current=null;try owners.shared.leave(io,first);
    std.debug.print("genuine_unsubmitted_buffer native_contexts={d} retained_roots={d}\n",.{sdk.diagnostic().active_contexts,owners.shared.snapshot(io).owned});
    try std.testing.expect(owners.shared.hasRetainedWork(io));
    const second=try owners.shared.enter(io);
    try owners.shared.bind(io,second,"fixture/buffer-origin");try owners.shared.active(io,second);
    owners.current=second;
    try std.testing.expectEqual(@as(c_int,1),fios_metal_owner_fixture_submit());
    owners.current=null;try owners.shared.leave(io,second);
    try std.testing.expectEqual(@as(usize,2),owners.shared.snapshot(io).owned);
    fios_metal_owner_fixture_release_gpu();
    try std.testing.expectEqual(@as(c_int,1),fios_metal_owner_fixture_wait_child());
    try std.testing.expectEqual(@as(c_int,1),fios_metal_owner_fixture_child_owner());
    try std.testing.expectEqual(@as(usize,2),owners.shared.snapshot(io).owned);
    owners.shared.fence(io);
    try std.testing.expectEqual(@as(c_int,1),fios_metal_owner_fixture_cleanup());cleaned=true;
    try std.testing.expectEqual(@as(u32,0),sdk.diagnostic().active_contexts);
    try std.testing.expect(!owners.shared.hasRetainedWork(io));
    try std.testing.expect(owners.shared.snapshot(io).uncertain);
    std.debug.print("PASS: genuine SDK unsubmitted buffer retains all distinct native encoding origins through shared Metal completion and cleanup; no terminal authority\n",.{});
}
