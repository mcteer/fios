// Genuine SDK callbacks after an actual native-thread queue handoff. No model,
// counter manipulation, fabricated SDK/completion or fault injection.
const std = @import("std");
const owners = @import("request_ownership.zig");
const sdk = @import("sdk_request_ownership.zig");
const queued = @import("queued_request_ownership.zig");
extern "c" fn usleep(microseconds: c_uint) c_int;
extern fn fios_host_owner_fixture_start() c_int;
extern fn fios_host_owner_fixture_wait(second: c_int) c_int;
extern fn fios_host_owner_fixture_owner(second: c_int) c_int;
extern fn fios_host_owner_fixture_release_first() void;
extern fn fios_host_owner_fixture_cleanup() c_int;
const Flag = std.atomic.Value(bool);
fn wait(flag: *Flag) !void {
    for (0..3000) |_| {
        if (flag.load(.acquire)) return;
        _ = usleep(1000);
    }
    return error.QueuedFixtureDeadline;
}
const Work = struct {
    io: std.Io,
    origin: *const owners.Retained,
    entered: Flag = .init(false),
    go: Flag = .init(false),
    started: Flag = .init(false),
    done: Flag = .init(false),
    exit: Flag = .init(false),
    failed: Flag = .init(false),
    restored: Flag = .init(false),
    fn run(self: *Work) void {
        var scope = queued.Scope.retain(self.io, self.origin) catch {
            self.failed.store(true, .release);self.entered.store(true, .release);return;
        };
        scope.enter(self.io) catch {
            self.failed.store(true, .release);self.entered.store(true, .release);return;
        };
        defer {
            if (!scope.finish(self.io)) self.failed.store(true, .release);
            self.restored.store(owners.current == null and owners.current_group == null, .release);
        }
        self.entered.store(true, .release);
        wait(&self.go) catch {self.failed.store(true, .release);return;};
        if (fios_host_owner_fixture_start() != 1) {self.failed.store(true, .release);self.done.store(true, .release);return;}
        self.started.store(true, .release);
        self.done.store(true, .release); // Work acknowledgement is not retirement.
        wait(&self.exit) catch {self.failed.store(true, .release);};
    }
};
test "fios genuine queued SDK CPU callbacks retain original native origins" {
    const io = std.testing.io;
    try owners.shared.initialize(io, @splat(9));try sdk.initialize(io);
    const root = try owners.shared.enter(io);
    try owners.shared.bind(io, root, "fixture/queued-origin");try owners.shared.active(io, root);
    const sender = try owners.shared.retainTokens(io, &.{root});
    var sender_live = true;
    defer if (sender_live) sender.release(io);
    try owners.shared.leave(io, root);
    var work: Work = .{ .io = io, .origin = &sender };
    const thread = try std.Thread.spawn(.{}, Work.run, .{&work});
    var joined = false;
    var cleaned = false;
    defer {
        work.go.store(true, .release);work.exit.store(true, .release);
        if (work.started.load(.acquire) and !cleaned) {_ = fios_host_owner_fixture_cleanup();}
        if (!joined) thread.join();
    }
    try wait(&work.entered);try std.testing.expect(!work.failed.load(.acquire));
    // Sender storage can now finish: the queued worker owns an independent copy.
    try std.testing.expect(sender.releaseIfCertain(io));sender_live = false;
    try std.testing.expect(owners.shared.hasRetainedWork(io));
    work.go.store(true, .release);try wait(&work.done);
    try std.testing.expect(!work.failed.load(.acquire));
    try std.testing.expectEqual(@as(c_int, 1), fios_host_owner_fixture_wait(0));
    try std.testing.expectEqual(@as(c_int, 1), fios_host_owner_fixture_owner(0));
    work.exit.store(true, .release);thread.join();joined = true;
    try std.testing.expect(work.restored.load(.acquire));try std.testing.expect(!work.failed.load(.acquire));
    try std.testing.expect(owners.shared.hasRetainedWork(io));
    fios_host_owner_fixture_release_first();
    try std.testing.expectEqual(@as(c_int, 1), fios_host_owner_fixture_wait(1));
    try std.testing.expectEqual(@as(c_int, 1), fios_host_owner_fixture_owner(1));
    try std.testing.expect(owners.shared.hasRetainedWork(io));
    try std.testing.expectEqual(@as(c_int, 1), fios_host_owner_fixture_cleanup());cleaned = true;
    try std.testing.expectEqual(@as(u32, 0), sdk.diagnostic().active_contexts);
    try std.testing.expectEqual(@as(usize, 0), owners.shared.snapshot(io).owned);
    std.debug.print("PASS: genuine queued worker and nested SDK callbacks retain original native origins after sender acknowledgement; no terminal authority\n", .{});
}
