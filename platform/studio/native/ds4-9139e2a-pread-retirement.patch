+// Unwired checked participant primitive. No legacy cleanup caller may treat
+// this as an engine/device receipt. Existing lifecycle-owner serialization is
+// a precondition; this does not enroll unknown/raw concurrent init/shutdown.
+static int ds4_gpu_fios_pread_pool_try_retire(void) {
+    pthread_mutex_lock(&g_stream_expert_pread_pool_mutex);
+    if (atomic_load_explicit(&g_fios_pread_pool_sealed, memory_order_acquire) ||
+        g_fios_pread_pool_uncertain || !g_stream_expert_pread_pool_initialized ||
+        g_stream_expert_pread_pool_stopping ||
