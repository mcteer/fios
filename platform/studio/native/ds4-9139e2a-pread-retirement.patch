+        g_stream_expert_pread_pool_active_workers ||
+        g_stream_expert_pread_pool_n_tasks || g_stream_expert_pread_pool_tasks) {
+        pthread_mutex_unlock(&g_stream_expert_pread_pool_mutex);
+        return 0;
+    }
+    const uint32_t count = g_stream_expert_pread_pool_thread_count;
+    if (count == 0 || count > 18) {
+        g_fios_pread_pool_uncertain = 1;
+        atomic_store_explicit(&g_fios_pread_pool_sealed, 1, memory_order_release);
+        pthread_mutex_unlock(&g_stream_expert_pread_pool_mutex);
+        return 0;
+    }
+    atomic_store_explicit(&g_fios_pread_pool_sealed, 1, memory_order_release);
+    g_stream_expert_pread_pool_stopping = 1;
+    pthread_cond_broadcast(&g_stream_expert_pread_pool_start_cond);
+    pthread_mutex_unlock(&g_stream_expert_pread_pool_mutex);
+
+    int ok = 1;
+    for (uint32_t i = 0; i < count; ++i) {
+        const int rc = pthread_join(g_stream_expert_pread_pool_threads[i], NULL);
+        pthread_mutex_lock(&g_stream_expert_pread_pool_mutex);
+        if (rc == 0) g_fios_pread_pool_joined |= (1u << i);
+        else { g_fios_pread_pool_uncertain = 1; ok = 0; }
+        pthread_mutex_unlock(&g_stream_expert_pread_pool_mutex);
+    }
+    pthread_mutex_lock(&g_stream_expert_pread_pool_mutex);
+    // Preserve the original vector/count and sticky uncertainty on refusal.
+    if (ok) {
+        g_stream_expert_pread_pool_thread_count = 0;
+        g_stream_expert_pread_pool_initialized = 0;
+    }
+    pthread_mutex_unlock(&g_stream_expert_pread_pool_mutex);
+    return ok;
+}
