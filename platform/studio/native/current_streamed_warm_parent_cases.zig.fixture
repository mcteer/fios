test "warm parent refuses to free expert resources after stop refusal" {var trace=Trace{.fail_stop=true};live=&trace;var warm=Warm{};var source=Source{.warm=&warm};source.deinit();if(trace.frees!=0 or source.warm==null or !trace.warm_unknown){std.debug.print("WARM_PARENT_FREED_ON_REFUSAL\n",.{});return error.TestUnexpectedResult;}}
test "warm parent healthy stop precedes every resource release" {var trace=Trace{};live=&trace;var warm=Warm{};var source=Source{.warm=&warm};source.deinit();try std.testing.expect(trace.frees>0 and !trace.freed_while_warm and !trace.warm_live);}
test "warm parent cached pool uncertainty preserves unrelated warm reference" {var trace=Trace{.pool_unknown=true};live=&trace;var warm=Warm{};var source=Source{.warm=&warm};source.deinit();try std.testing.expect(trace.frees==0 and trace.warm_live and source.warm!=null);}
