+  fios_bump();
+}
+void fios_finish_host_task(const std::shared_ptr<FiosHostTask>& task, bool failed) {
+  std::lock_guard lock(fios_registry.mutex);
+  if (!task || !task->tracked || !task->started || task->done ||
