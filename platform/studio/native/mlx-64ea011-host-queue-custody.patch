+std::shared_ptr<FiosHostTask> fios_reserve_host_task(Stream stream) {
+  std::lock_guard lock(fios_registry.mutex);
+  fios_registry.ever_host = true;
+  if (!fios_registry.enabled) return {};
+  if (fios_registry.host_held) throw std::runtime_error("Host queues held");
+  if (fios_registry.uncertain) return {};
+  bool owned = false;
+  for (size_t i = 0; i < fios_registry.count; ++i) {
