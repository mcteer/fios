+  ++fios_registry.host_pending;
+  task->tracked = true;
+  return task;
+}
+void fios_start_host_task(const std::shared_ptr<FiosHostTask>& task) {
+  std::lock_guard lock(fios_registry.mutex);
+  if (!task || !task->tracked || task->started || task->done) {
+    fios_registry.uncertain = true;
