+test "fios mimo retirement: failure and exhausted sequence never produce a pause retirement receipt" {
+    var event = std.atomic.Value(u64).init(0);
+    var trace: Trace.Log = .{};
+    var backend = Trace.word(&event, &trace);
+    backend.fail_at = 1;
+    const engine = try TraceEngine.create(std.testing.allocator, backend, .{ .fios_fixture_control = true });
+    defer engine.destroy();
+    engine.arm(1);
+    try waitFor(struct {
+        fn failed(e: *const TraceEngine) bool { return e.stats().failed; }
+    }.failed, .{engine}, 500);
+    const ticket = try engine.fixturePause();
+    try waitFor(struct {
+        fn acknowledged(e: *const TraceEngine, t: FiosPauseTicket) bool { return e.fixturePauseState(t) == .unknown; }
+    }.acknowledged, .{ engine, ticket }, 500);
+    try testing.expect(engine.fios_closed.load(.seq_cst));
+    try testing.expect(engine.fixtureResume(ticket));
+    try testing.expect(engine.stats().failed);
+    engine.hold(false);
+    try testing.expectEqual(@as(u32, 0), engine.holds.load(.seq_cst));
+    _ = std.c.pthread_mutex_lock(&engine.mu);
+    engine.fios_sequence = std.math.maxInt(u64);
+    _ = std.c.pthread_mutex_unlock(&engine.mu);
+    try testing.expectError(error.FiosWarmControlExhausted, engine.fixturePause());
+}
+
+test "fios mimo retirement: parked chunks require actual retire outcome before pause acknowledgement" {
+    const Backend = struct {
+        pub const Chunk = u64;
+        commits: *std.atomic.Value(u64),
+        retires: *std.atomic.Value(u64),
+        entered: *std.atomic.Value(bool),
+        release: *std.atomic.Value(bool),
+        fail: bool,
+        pub fn commit(self: *@This(), _: u32) !Chunk { return self.commits.fetchAdd(1, .seq_cst) + 1; }
+        pub fn eventValue(self: *const @This()) u64 { return if (self.commits.load(.seq_cst) >= 2) 1 else 0; }
+        pub fn retire(self: *@This(), _: Chunk) !u64 {
+            _ = self.retires.fetchAdd(1, .seq_cst);
+            self.entered.store(true, .seq_cst);
+            while (!self.release.load(.seq_cst)) sleepUs(200);
+            if (self.fail) return error.FiosBlockedRetire;
+            return 0;
+        }
+    };
+    const E = Engine(Backend);
+    for ([_]bool{ false, true }) |failure| {
+        var commits = std.atomic.Value(u64).init(0);
+        var retires = std.atomic.Value(u64).init(0);
+        var entered = std.atomic.Value(bool).init(false);
+        var release = std.atomic.Value(bool).init(false);
+        const engine = try E.create(std.testing.allocator, .{ .commits = &commits, .retires = &retires, .entered = &entered, .release = &release, .fail = failure }, .{ .fios_fixture_control = true });
+        defer { release.store(true, .seq_cst); engine.destroy(); }
+        engine.arm(1);
+        try waitFor(struct {
+            fn parked(e: *const E, count: *const std.atomic.Value(u64)) bool { return e.isParked() and count.load(.seq_cst) == 2; }
+        }.parked, .{ engine, &commits }, 500);
+        try testing.expectEqual(@as(u64, 0), retires.load(.seq_cst));
+        const ticket = try engine.fixturePause();
+        try waitFor(struct {
+            fn blocked(flag: *const std.atomic.Value(bool)) bool { return flag.load(.seq_cst); }
+        }.blocked, .{&entered}, 500);
+        try testing.expectEqual(FiosPauseState.pending, engine.fixturePauseState(ticket));
+        try testing.expect(!engine.fixtureResume(ticket));
+        release.store(true, .seq_cst);
+        const expected: FiosPauseState = if (failure) .unknown else .retired;
+        try waitFor(struct {
+            fn acknowledged(e: *const E, t: FiosPauseTicket, wanted: FiosPauseState) bool { return e.fixturePauseState(t) == wanted; }
+        }.acknowledged, .{ engine, ticket, expected }, 500);
+        try testing.expectEqual(@as(u64, 2), retires.load(.seq_cst));
+        try testing.expect(engine.fixtureResume(ticket));
+    }
+}
+
+test "fios mimo retirement: drain preserves failure and still retires every queued chunk" {
+    const Backend = struct {
+        pub const Chunk = u64;
+        calls: u32 = 0,
+        fail_mask: u8 = 0,
+        pub fn retire(self: *@This(), chunk: Chunk) !u64 {
+            self.calls += 1;
+            if ((chunk == 1 and self.fail_mask & 1 != 0) or
+                (chunk == 2 and self.fail_mask & 2 != 0)) return error.FiosRetirementFailure;
+            return 0;
+        }
+    };
+    for ([_]u8{ 0, 1, 2, 3 }) |mask| {
+        for ([_]usize{ 0, 1 }) |head| {
+            var engine: Engine(Backend) = .{ .a = std.testing.allocator, .backend = .{ .fail_mask = mask }, .params = .{}, .iters = initial_iters };
+            engine.ring = .{ 1, 2 };
+            engine.ring_iters = .{ initial_iters, initial_iters };
+            engine.ring_head = head;
+            engine.ring_n = 2;
+            engine.n_chunks.store(2, .monotonic);
+            engine.drain();
+            try std.testing.expectEqual(@as(u32, 2), engine.backend.calls);
+            try std.testing.expectEqual(@as(usize, 0), engine.ring_n);
+            try std.testing.expectEqual(mask != 0, engine.stats().failed);
+            try std.testing.expectEqual(@as(u64, 2) - @as(u64, @popCount(mask)), engine.stats().retired);
+            engine.drain();
+            try std.testing.expectEqual(mask != 0, engine.stats().failed);
+            try std.testing.expectEqual(@as(u32, 2), engine.backend.calls);
+        }
+    }
+}
 
