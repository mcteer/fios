+    try testing.expectError(error.FiosWarmControlUnsupported, ordinary.fixturePause());
+    try testing.expectError(error.FiosWarmControlUnsupported, ordinary.fixtureRetainLifetime());
+    const old = try TraceEngine.create(std.testing.allocator, Trace.word(&event, &trace), .{ .fios_fixture_control = true });
+    var old_live = true;
+    defer if (old_live) old.destroy();
+    const old_ticket = try old.fixturePause();
+    try waitFor(fiosRetired, .{ old, old_ticket }, 500);
+    old.destroy();
+    old_live = false;
+    const replacement = try TraceEngine.create(std.testing.allocator, Trace.word(&event, &trace), .{ .fios_fixture_control = true });
+    defer replacement.destroy();
+    const current = try replacement.fixturePause();
+    try testing.expect(current.instance != old_ticket.instance);
+    try testing.expect(!replacement.fixtureResume(old_ticket));
+    try waitFor(fiosRetired, .{ replacement, current }, 500);
+    try testing.expect(replacement.fixtureResume(current));
+}
