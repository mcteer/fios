diff --git a/src/fios/current_ds4_backend_uncertainty.zig b/src/fios/current_ds4_backend_uncertainty.zig
new file mode 100644
index 0000000..727b4e9
--- /dev/null
+++ b/src/fios/current_ds4_backend_uncertainty.zig
@@ -0,0 +1,14 @@
+//! Fixed negative-only composition. Zero never proves native completion,
+//! resource idle, all-client coverage or admission. No dynamic callback.
+const base = @import("current_backend_uncertainty.zig");
+pub fn known(comptime sdk_enabled: bool, comptime llama_enabled: bool) bool {
+    const options = @import("build_options");
+    const Source = struct {
+        extern "c" fn ds4_host_source_uncertainty() u32;
+        extern "c" fn ds4_gpu_source_uncertainty() u32;
+    };
+    const ds4 = if (@hasDecl(options, "fios_source_ds4") and options.fios_source_ds4)
+        Source.ds4_host_source_uncertainty() != 0 or Source.ds4_gpu_source_uncertainty() != 0
+    else false;
+    return ds4 or base.known(sdk_enabled, llama_enabled);
+}
diff --git a/src/fios/current_ds4_cleanup_uncertainty.zig b/src/fios/current_ds4_cleanup_uncertainty.zig
new file mode 100644
index 0000000..58b3dbf
--- /dev/null
+++ b/src/fios/current_ds4_cleanup_uncertainty.zig
@@ -0,0 +1,19 @@
+//! Negative cleanup evidence only; no native completion or admission authority.
+const std = @import("std");
+const owners = @import("request_ownership.zig");
+const backend = @import("current_ds4_backend_uncertainty.zig");
+
+pub fn known(io: std.Io, comptime sdk_enabled: bool, comptime llama_enabled: bool) bool {
+    const native_unknown = backend.known(sdk_enabled, llama_enabled);
+    const source = owners.shared();
+    source.mutex.lockUncancelable(io);
+    const started = source.initialized;
+    source.mutex.unlock(io);
+    if (native_unknown) {
+        if (started) source.fence(io);
+        return true;
+    }
+    // Legacy metadata-only callers can precede source startup. Missing startup
+    // is never positive native authority, and cannot hide an actual fence.
+    return started and source.backendKnownUncertain(io);
+}
