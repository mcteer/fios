// Actual source SDK CPU callbacks + actual native tracker contexts. No model,
// counterfeit SDK objects, injected backend error or counter manipulation.
const std = @import("std");
const owners = @import("request_ownership.zig");
const sdk = @import("sdk_request_ownership.zig");
extern fn fios_host_owner_fixture_start() c_int;
extern fn fios_host_owner_fixture_wait(second: c_int) c_int;
extern fn fios_host_owner_fixture_owner(second: c_int) c_int;
extern fn fios_host_owner_fixture_release_first() void;
extern fn fios_host_owner_fixture_cleanup() c_int;
test "fios genuine SDK host callbacks retain originating native owners" {
    const io = std.testing.io;
    try owners.shared.initialize(io, @splat(7));
    try sdk.initialize(io);
    const original = try owners.shared.enter(io);
    try owners.shared.bind(io, original, "fixture/cpu-origin");
    try owners.shared.active(io, original);
    owners.current = original;
    var original_held = true;
    defer if (original_held) owners.shared.leave(io, original) catch {};
    defer owners.current = null;
    try std.testing.expectEqual(@as(c_int, 1), fios_host_owner_fixture_start());
    var cleaned = false;
    defer { if (!cleaned) { _ = fios_host_owner_fixture_cleanup(); } }
    try std.testing.expectEqual(@as(c_int, 1), fios_host_owner_fixture_wait(0));
    owners.current = null;
    try owners.shared.leave(io, original);
    original_held = false;
    std.debug.print("genuine_host_callback owner_present={d} native_contexts={d} retained_roots={d}\n", .{ fios_host_owner_fixture_owner(0), sdk.diagnostic().active_contexts, owners.shared.snapshot(io).owned });
    // Prior genuine SDK lacks the hook: this actual callback remains held,
    // but the originating root disappears as soon as its connection leaves.
    try std.testing.expect(owners.shared.hasRetainedWork(io));
    try std.testing.expectEqual(@as(c_int, 1), fios_host_owner_fixture_owner(0));
    try std.testing.expect(sdk.diagnostic().active_contexts > 0);
    fios_host_owner_fixture_release_first();
    try std.testing.expectEqual(@as(c_int, 1), fios_host_owner_fixture_wait(1));
    std.debug.print("genuine_cleanup_callback owner_present={d} native_contexts={d} retained_roots={d}\n", .{ fios_host_owner_fixture_owner(1), sdk.diagnostic().active_contexts, owners.shared.snapshot(io).owned });
    try std.testing.expectEqual(@as(c_int, 1), fios_host_owner_fixture_owner(1));
    try std.testing.expect(owners.shared.hasRetainedWork(io));
    try std.testing.expect(sdk.diagnostic().active_contexts > 0);
    owners.shared.fence(io);
    try std.testing.expectEqual(@as(c_int, 1), fios_host_owner_fixture_cleanup());
    cleaned = true;
    try std.testing.expectEqual(@as(u32, 0), sdk.diagnostic().active_contexts);
    try std.testing.expect(!sdk.diagnostic().uncertain);
    try std.testing.expect(!owners.shared.hasRetainedWork(io));
    try std.testing.expect(owners.shared.snapshot(io).uncertain);
    std.debug.print("PASS: genuine SDK parent and nested CPU callbacks retain native request roots after connection release, restore TLS and release only after actual callback cleanup; no terminal authority\n", .{});
}
