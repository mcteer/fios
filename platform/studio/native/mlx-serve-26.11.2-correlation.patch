diff --git a/src/fios/correlation_header.zig b/src/fios/correlation_header.zig
new file mode 100644
index 0000000..95c8b4a
--- /dev/null
+++ b/src/fios/correlation_header.zig
@@ -0,0 +1,24 @@
+// Opaque correlation metadata only; not authentication or terminal proof.
+const std = @import("std");
+const fios_ownership = @import("request_ownership.zig");
+pub fn parse(headers: []const u8) !?fios_ownership.CorrelationID {
+    var found: ?fios_ownership.CorrelationID = null;
+    var lines = std.mem.splitSequence(u8, headers, "\r\n");
+    while (lines.next()) |line| {
+        const colon = std.mem.indexOfScalar(u8, line, ':') orelse continue;
+        if (!std.ascii.eqlIgnoreCase(line[0..colon], "x-fios-request-id")) continue;
+        if (found != null) return error.DuplicateCorrelationHeader;
+        found = try fios_ownership.parseCorrelationHex(std.mem.trim(u8, line[colon + 1 ..], " \t"));
+    }
+    return found;
+}
+
+test "optional correlation header is exact and rejects ambiguous identity" {
+    const testing = std.testing;
+    try testing.expectEqual(@as(?fios_ownership.CorrelationID, null), try parse("POST /v1/chat/completions HTTP/1.1\r\nHost: localhost\r\n"));
+    const valid = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
+    const identity = (try parse("X-Fios-Request-ID: " ++ valid ++ "\r\n")).?;
+    try testing.expectEqual(@as([32]u8, @splat(0xaa)), identity);
+    try testing.expectError(error.InvalidCorrelation, parse("X-Fios-Request-ID: bad-id\r\n"));
+    try testing.expectError(error.DuplicateCorrelationHeader, parse("X-Fios-Request-ID: " ++ valid ++ "\r\nx-fios-request-id: " ++ valid ++ "\r\n"));
+}
