# Generated privately by scripts/setup.sh. Never commit .env.
FIOS_PASSWORD=
SESSION_SECRET=
# Optional immutable app override; normally leave unset to use the verified fios:current alias.
# FIOS_IMAGE=fios:EXACT_REVIEWED_SHA
# Optional reviewed observer image override; normally fios:current.
# FIOS_READINESS_IMAGE=fios:EXACT_REVIEWED_SHA
# Readiness and deployment state use Compose named volumes, not host directories.
MLX_BASE_URL=http://host.docker.internal:11234/v1
MLX_API_KEY=
# Explicit trusted peer-name to /v1-base map. Unconfigured peers remain unverified.
# Example: MLX_PEER_URLS={"studio-a":"http://192.168.1.10:11234/v1"}
# Catalog-provided URLs are never automatically probed; gateway keys are not forwarded.
MLX_PEER_URLS={}
# Local development only: installed Python 3.11 interpreter override.
# FIOS_AGENT_PYTHON=/absolute/path/to/.venv/bin/python
# The production image fixes its internal /opt/venv/bin/python; no host path.
