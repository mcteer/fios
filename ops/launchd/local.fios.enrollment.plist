<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.fios.enrollment</string>
    <key>UserName</key>
    <string>REPLACE_UNPRIVILEGED_SERVICE_USER</string>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>5</integer>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>/Library/Application Support/fios/src</string>
    </dict>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/python3</string>
        <string>-B</string>
        <string>-m</string>
        <string>backend.enroll</string>
        <string>serve</string>
        <string>--state-dir</string>
        <string>/Library/Application Support/fios/enrollment/state</string>
        <string>--bind</string>
        <string>REPLACE_CORE_MANAGEMENT_IPV4</string>
        <string>--ca</string>
        <string>/Library/Application Support/fios/enrollment/roots.pem</string>
        <string>--cert</string>
        <string>/Library/Application Support/fios/enrollment/leaf.pem</string>
        <string>--key</string>
        <string>/Library/Application Support/fios/enrollment/leaf.key</string>
        <string>--openssl</string>
        <string>/opt/homebrew/opt/openssl@4/bin/openssl</string>
    </array>
</dict>
</plist>
